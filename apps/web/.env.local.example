# =============================================================================
# Swimly Web – Environment Configuration
# Copy this file to .env.local and fill in the values for your environment.
# =============================================================================

# ---------------------------------------------------------------------------
# Authentication (NextAuth.js)
# These values are required for NextAuth.js to function correctly.
#
# Generate a secret:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=your-generated-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# API Configuration
# The public URL of the membership API consumed by the browser.
# This variable is inlined at build time (NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Demo credential hint on the login page
# Set NEXT_PUBLIC_DEMO_MODE to "false" to hide the hint entirely (do this for
# any real deployment). The email and password default to the demo club seed
# (docs/demos/gym-demo-club.md); override them if you seed a different club.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_DEMO_EMAIL=admin@kestrelvalegym.org.uk
# NEXT_PUBLIC_DEMO_PASSWORD=Demo2024!

# ---------------------------------------------------------------------------
# Analytics (PostHog)
# Public project key from PostHog. Leave empty for local dev to disable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
