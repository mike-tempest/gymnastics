# =============================================================================
# Swimly Web – Environment Configuration
# Copy this file to .env.local and fill in the values for your environment.
# =============================================================================

# ---------------------------------------------------------------------------
# Authentication (NextAuth.js)
# These values are required for NextAuth.js to function correctly.
#
# Generate a secret:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=your-generated-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# API Configuration
# The public URL of the membership API consumed by the browser.
# This variable is inlined at build time (NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Feature flags
# Swimming times/strokes competitions UI (TEM-15): off by default, only the
# exact string 'true' enables it. Inlined at build time (NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_COMPETITIONS=false

# ---------------------------------------------------------------------------
# Analytics (PostHog)
# Public project key from PostHog. If left empty, all analytics calls in
# src/lib/analytics.ts silently no-op, so local dev does not need this set.
# Production sets these via the Railway dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
