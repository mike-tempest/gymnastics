{
  "name": "tumblebase",
  "version": "1.0.0",
  "private": true,
  "description": "Club management, Direct Debit billing and compliance for gymnastics clubs",
  "repository": {
    "type": "git",
    "url": "https://github.com/mike-tempest/gymnastics.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:services": "turbo run dev --filter='./services/*'",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:playwright": "cd tests/playwright && npx playwright test",
    "test:coverage": "turbo run test --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate --filter='./services/*'",
    "db:migrate:create": "turbo run db:migrate:create --filter='./services/*'",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.dev.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker/docker-compose.dev.yml logs -f",
    "docker:restart": "pnpm docker:down && pnpm docker:up",
    "setup": "./scripts/setup-dev-env.sh",
    "seed": "ts-node scripts/seed.ts",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@faker-js/faker": "^10.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "dotenv": "^17.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "sharp": "^0.34.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.5"
    }
  }
}
