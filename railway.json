{
  "$schema": "https://railway.com/railway.schema.json",
  "version": 2,
  "services": {
    "web": {
      "source": {
        "dockerfilePath": "apps/web/Dockerfile"
      },
      "networking": {
        "servicePort": 3000
      },
      "deploy": {
        "healthcheckPath": "/",
        "healthcheckTimeout": 300,
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    },
    "membership": {
      "source": {
        "dockerfilePath": "services/membership/Dockerfile.prod"
      },
      "networking": {
        "servicePort": 3001
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 300,
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    }
  }
}
