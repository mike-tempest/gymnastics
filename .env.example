# =============================================================================
# Swimly Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================
#
# Railway Deployment
# ------------------
# When deploying to Railway, environment variables should be set in the Railway
# dashboard rather than via .env files. Railway provides a PostgreSQL plugin
# (no need to run Postgres as a custom service) and supports private networking
# between services (e.g. http://membership.railway.internal:3001).
#
# The railway.json in the project root defines service topology only; all
# variable configuration lives in the Railway dashboard.
# =============================================================================

# ---------------------------------------------------------------------------
# Database Configuration
# PostgreSQL connection details used by all backend services.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=swim_nexus_dev

# ---------------------------------------------------------------------------
# Application Environment
# Controls behaviour across all services (development | production | test).
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication and Security
# These secrets MUST be unique and kept confidential in production.
#
# Generate a JWT secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Generate a NextAuth secret:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=your-generated-secret-here-minimum-64-characters
JWT_EXPIRES_IN=24h
NEXTAUTH_SECRET=your-generated-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CORS Configuration
# Allowed origins for cross-origin requests from the frontend.
# In production, use comma-separated HTTPS domains.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# API Configuration
# The public URL of the primary API, used by the Next.js frontend.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
# Note: NEXT_PUBLIC_ variables are baked in at build time in Next.js.
# For Docker Compose, NEXT_PUBLIC_API_URL stays as http://localhost:3001
# (the browser accesses the API via the host machine's localhost).

# Server-side API URL for NextAuth (private, not exposed to the browser).
# On Railway, set this to the private networking URL of the membership service,
# e.g. http://membership.railway.internal:3001
# For local development, this falls back to NEXT_PUBLIC_API_URL.
MEMBERSHIP_API_URL=http://localhost:3001
# When running via Docker Compose, the membership service URL for server-side
# calls must use the Docker network service name rather than localhost.
# Set this in your .env when using docker compose:
# MEMBERSHIP_API_URL=http://membership:3001

# ---------------------------------------------------------------------------
# Service Ports
# Currently implemented services and their ports.
# ---------------------------------------------------------------------------
MEMBERSHIP_PORT=3001
NOTIFICATIONS_PORT=3005

# Future services (not yet implemented):
# FINANCE_PORT=3002
# COMPETITION_PORT=3003
# PERFORMANCE_PORT=3004

# ---------------------------------------------------------------------------
# Feature flags
# Swimming times/strokes competitions module (TEM-15): off by default, only
# the exact string 'true' enables it. ENABLE_COMPETITIONS gates the API;
# NEXT_PUBLIC_ENABLE_COMPETITIONS gates the web UI (inlined at build time).
# ---------------------------------------------------------------------------
ENABLE_COMPETITIONS=false
NEXT_PUBLIC_ENABLE_COMPETITIONS=false

# ---------------------------------------------------------------------------
# Email / SMTP Configuration
# Used by the communications service to send transactional emails.
# For local development, use MailHog (localhost:1025) or similar.
# ---------------------------------------------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@localhost

# ---------------------------------------------------------------------------
# GoCardless (Direct Debit Integration)
# Used by the finance service for recurring payments.
# Set GOCARDLESS_ENVIRONMENT to "live" for production.
# ---------------------------------------------------------------------------
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Object Storage (S3-compatible)
# Used for document uploads, profile photos, and attachments.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=club-platform

# ---------------------------------------------------------------------------
# Logging
# Set to "debug" for verbose output during development.
# Production recommended: "warn" or "error".
# ---------------------------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Audit trail
# Every create, update and delete is always recorded in audit_logs, along with
# logins and club signups. Set AUDIT_LOG_VIEWS=true to also record page views
# (GET requests), which is what shows where people give up rather than only
# what they completed. Views are far higher volume, so turn this off again if
# the table grows faster than you want to keep.
# ---------------------------------------------------------------------------
AUDIT_LOG_VIEWS=false
