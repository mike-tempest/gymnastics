<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New club signed up</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #1F2937; background: #F4F4F4; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 20px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #10B981 0%, #059669 100%); color: #fff; padding: 28px 24px; text-align: center; }
    .header h1 { margin: 0; font-size: 20px; font-weight: 600; }
    .header p { margin: 6px 0 0; opacity: 0.95; font-size: 14px; }
    .content { padding: 28px 24px; font-size: 15px; }
    .content h2 { margin: 0 0 16px; font-size: 18px; color: #111827; }
    table.details { width: 100%; border-collapse: collapse; margin: 0 0 8px; }
    table.details th { text-align: left; padding: 8px 12px; font-size: 13px; color: #6B7280; font-weight: 600; width: 38%; vertical-align: top; border-bottom: 1px solid #F0F0F0; }
    table.details td { text-align: left; padding: 8px 12px; font-size: 14px; color: #111827; border-bottom: 1px solid #F0F0F0; }
    .muted { color: #9CA3AF; }
    .footer { background: #F9FAFB; color: #6B7280; padding: 18px 24px; font-size: 12px; text-align: center; border-top: 1px solid #E5E7EB; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>New club signed up</h1>
      <p>A club just created an account on {{brandName}}</p>
    </div>
    <div class="content">
      <h2>{{newClubName}}</h2>
      <table class="details">
        <tr><th>Club</th><td>{{newClubName}}</td></tr>
        {{#if region}}<tr><th>Swim England region</th><td>{{region}}</td></tr>{{/if}}
        {{#if county}}<tr><th>County</th><td>{{county}}</td></tr>{{/if}}
        {{#if affiliateNumber}}<tr><th>Affiliate number</th><td>{{affiliateNumber}}</td></tr>{{/if}}
        {{#if clubContactEmail}}<tr><th>Club contact email</th><td>{{clubContactEmail}}</td></tr>{{/if}}
        <tr><th>Admin</th><td>{{adminName}}</td></tr>
        <tr><th>Admin email</th><td><a href="mailto:{{adminEmail}}">{{adminEmail}}</a></td></tr>
        <tr><th>Signed up</th><td>{{signedUpAt}}</td></tr>
        <tr><th>Club ID</th><td class="muted">{{clubId}}</td></tr>
        <tr><th>Slug</th><td class="muted">{{slug}}</td></tr>
      </table>
      <p class="muted" style="font-size:13px;">Reply to this email to reach {{adminName}} directly.</p>
    </div>
    <div class="footer">
      {{brandName}} platform alert &middot; &copy; {{year}}
    </div>
  </div>
</body>
</html>
