# =============================================================================
# Gymnastics platform membership service production Dockerfile
# Multi-stage build optimised for NestJS on Railway.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Dependencies
# Install all workspace dependencies needed for the build.
# ---------------------------------------------------------------------------
FROM node:20-alpine AS deps

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.12.1 --activate

WORKDIR /app

# Copy workspace configuration (layer-cached separately from source)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.json ./

# Copy shared packages
COPY packages/ ./packages/

# Copy membership service package.json
COPY services/membership/package.json ./services/membership/

# Install all dependencies (dev included — needed for the build)
RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# Stage 2: Builder
# Build shared packages then the NestJS service via Turborepo.
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.12.1 --activate

WORKDIR /app

# Copy installed dependencies from the deps stage
COPY --from=deps /app ./

# Copy source code
COPY packages/ ./packages/
COPY services/membership/ ./services/membership/

# Build everything the membership service depends on, then the service itself
RUN pnpm turbo build --filter=@club-manager/membership-service

# Prune devDependencies for a leaner production image
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# ---------------------------------------------------------------------------
# Stage 3: Production
# Minimal runtime image with only production artefacts.
# ---------------------------------------------------------------------------
FROM node:20-alpine AS production

RUN apk add --no-cache libc6-compat

WORKDIR /app

ENV NODE_ENV=production

# Create a non-root user for security
RUN addgroup --system --gid 1001 swimly && \
    adduser --system --uid 1001 swimly

# Copy workspace config (pnpm needs these to resolve workspace: protocol)
COPY --from=builder /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/package.json ./

# Copy built shared packages
COPY --from=builder /app/packages/ ./packages/

# Copy built service and production node_modules
COPY --from=builder /app/services/membership/dist ./services/membership/dist
COPY --from=builder /app/services/membership/package.json ./services/membership/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/services/membership/node_modules ./services/membership/node_modules

USER swimly

EXPOSE 3001

ENV PORT=3001
ENV TYPEORM_MIGRATIONS_RUN=true
ENV TYPEORM_SYNCHRONIZE=false

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3001}/health/live || exit 1

CMD ["node", "services/membership/dist/main.js"]
