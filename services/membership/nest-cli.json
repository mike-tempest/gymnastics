{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      { "include": "modules/email/templates/**/*.hbs", "outDir": "dist" }
    ],
    "watchAssets": true
  }
}
