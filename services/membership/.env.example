# Server
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=swim_nexus_membership

# JWT - REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS - Comma-separated origins allowed in production
CORS_ORIGINS=http://localhost:3000

# Rate limit on /api/auth (login, register, profile). The defaults below are
# the production values; leave them alone for any deployment. Raise the cap
# locally when running the tests/e2e suite, which makes more than 15 auth
# requests in one run.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=15

# Application URLs
APP_URL=http://localhost:3000

# Transactional email through Resend HTTPS. Leave the key empty for local tests.
# Use a dedicated Tumblebase key and a verified sender in deployed environments.
RESEND_API_KEY=
# Signing secret for the Tumblebase delivery-event webhook
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Tumblebase <noreply@localhost>"
# After verifying mail.tumblebase.com in the correct Resend account:
# EMAIL_FROM="Tumblebase <noreply@mail.tumblebase.com>"

# Swimming times/strokes competitions module (TEM-15): off by default, only the exact string 'true' enables it.
ENABLE_COMPETITIONS=false

# GoCardless
# Create a separate GoCardless Partner app and register APP_URL/admin/settings.
GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=
# JSON object of key IDs to 32-byte hex keys. Generate securely, never commit values.
PAYMENT_TOKEN_KEY_ID=
PAYMENT_TOKEN_KEYS=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe Connect (optional; Stripe stays dormant until the platform secret key
# is set). See docs/payments/stripe-connect.md for setup.
# STRIPE_SECRET_KEY=sk_test_your_platform_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
