# Server
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=swim_nexus_membership

# JWT - REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS - Comma-separated origins allowed in production
CORS_ORIGINS=http://localhost:3000

# Application URLs
APP_URL=http://localhost:3000

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASSWORD=
EMAIL_FROM="Swim Club" <noreply@swimclub.co.uk>

# Swimming times/strokes competitions module (TEM-15): off by default, only the exact string 'true' enables it.
ENABLE_COMPETITIONS=false

# GoCardless
GOCARDLESS_ACCESS_TOKEN=your_access_token_here
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=your_webhook_secret_here

# Legacy GoCardless environment-credentials shim. Exists ONLY for local demo
# environments that seed GoCardless mandates directly and must never be set in
# production: with it on, a club with no payment connection is silently routed
# through Swimly's shared GoCardless credentials instead of being told to
# connect Stripe. Anything other than the exact string 'true' leaves it off.
# LEGACY_GOCARDLESS_ENV_FALLBACK=true

# Stripe Connect (optional; Stripe stays dormant until the platform secret key
# is set). See docs/payments/stripe-connect.md for setup.
# STRIPE_SECRET_KEY=sk_test_your_platform_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
