---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { Check } from "@lucide/astro";

const canonical = "https://swimly.club/au/pricing/";
const title = "Swimming Club Software Pricing Australia | Free to A$95/mo";
const description =
  "Swimming club software pricing in Australian dollars, from free (up to 50 members). Provisional pricing of A$55 and A$95 per month. No per-member fees, no hidden charges.";

const tiers = [
  {
    name: "Starter",
    price: "Free",
    period: "",
    description: "For small clubs finding their feet",
    members: "Up to 50 members",
    highlight: false,
    provisional: false,
    cta: "Start free",
    ctaHref: "https://app.swimly.uk/create-club",
    features: [
      "Basic membership management",
      "Attendance tracking",
      "Email notifications",
      "Session scheduling",
      "Financial summary",
    ],
  },
  {
    name: "Club",
    price: "A$55",
    period: "/mo",
    description: "The full toolkit for growing clubs",
    members: "50 to 200 members",
    highlight: true,
    provisional: true,
    cta: "Start free",
    ctaHref: "https://app.swimly.uk/create-club",
    features: [
      "Everything in Starter",
      "Billing and invoicing",
      "Parent portal",
      "Squad management",
      "Automatic fee collection",
      "Custom reports and exports",
      "Priority email support",
    ],
  },
  {
    name: "Performance",
    price: "A$95",
    period: "/mo",
    description: "For ambitious, competitive clubs",
    members: "200 to 500 members",
    highlight: false,
    provisional: true,
    cta: "Start free",
    ctaHref: "https://app.swimly.uk/create-club",
    features: [
      "Everything in Club",
      "Performance analytics",
      "API access",
      "Competition fee tracking",
      "Safeguarding dashboard",
      "Priority phone support",
    ],
  },
  {
    name: "Enterprise",
    price: "Custom",
    period: "",
    description: "Bespoke pricing for large organisations",
    members: "500+ members",
    highlight: false,
    provisional: false,
    cta: "Get in touch",
    ctaHref: "mailto:hello@swimly.club",
    features: [
      "Everything in Performance",
      "Dedicated support",
      "Custom integrations",
      "Onboarding support",
      "Multi-site management",
      "Dedicated account manager",
    ],
  },
];

const faqItems = [
  {
    question: "Is the Starter plan really free?",
    answer:
      "Yes. The Starter plan is completely free for clubs with up to 50 members. There are no hidden fees, no card required and no time limit. You can use it for as long as you like.",
  },
  {
    question: "Why are Australian prices marked as provisional?",
    answer:
      "Swimly is expanding to Australia and we are finalising our local launch. The Club plan at A$55 per month and the Performance plan at A$95 per month are provisional and may change before general availability. We will confirm final pricing with any club before it is charged.",
  },
  {
    question: "Why is Swimly priced this way?",
    answer:
      "We use a flat-rate pricing model rather than charging per member, which keeps costs predictable as your club grows. No hidden setup fees, no surprise costs at renewal. What you see is what you pay.",
  },
  {
    question: "Can I switch between plans at any time?",
    answer:
      "Yes. You can upgrade or downgrade your plan at any time from your club dashboard. When upgrading, you get immediate access to the new features. When downgrading, the change takes effect at the end of your current billing period.",
  },
  {
    question: "Are there any per-member fees?",
    answer:
      "No. Every plan has a flat monthly rate regardless of how many members you have within your tier. We believe swimming clubs should not be penalised for growing.",
  },
  {
    question: "How does billing work?",
    answer:
      "Plans are billed monthly. You can cancel at any time and your access continues until the end of the billing period. We do not lock you into annual contracts.",
  },
  {
    question: "What payment methods do you accept?",
    answer:
      "Subscription plans are paid by card. For collecting member fees, Swimly supports card and bank payment so your families can pay the way that suits them. Final Australian payment options will be confirmed at launch.",
  },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Swimly Swimming Club Management Software",
  description: description,
  brand: { "@type": "Brand", name: "Swimly" },
  offers: [
    { "@type": "Offer", name: "Starter", price: "0", priceCurrency: "AUD", description: "Free plan for small clubs with up to 50 members" },
    { "@type": "Offer", name: "Club", price: "55", priceCurrency: "AUD", description: "Provisional pricing. Full toolkit for growing clubs with 50 to 200 members" },
    { "@type": "Offer", name: "Performance", price: "95", priceCurrency: "AUD", description: "Provisional pricing. Advanced features for competitive clubs with 200 to 500 members" },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://swimly.club/au/" },
    { "@type": "ListItem", "position": 2, "name": "Pricing", "item": "https://swimly.club/au/pricing/" }
  ]
};
---

<Layout title={title} description={description} canonical={canonical} faqItems={faqItems}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main class="pt-28 pb-16">
    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="eyebrow reveal">Pricing</p>
      <h1 class="reveal font-display text-5xl sm:text-6xl text-[#0F2D2D] mt-5 mb-6">
        Simple, transparent pricing
      </h1>
      <p class="reveal text-xl text-ink-soft max-w-2xl mx-auto mb-4">
        No per-member fees. No hidden charges. No annual lock-in. Just a flat monthly rate that scales with your club.
      </p>
      <p class="reveal text-base text-mint-ink max-w-2xl mx-auto">
        Preparing an AGM proposal? Transparent pricing makes committee decisions easier.
      </p>
    </section>

    <!-- Provisional pricing notice -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-6">
      <div class="reveal bg-amber-500/10 border border-amber-600/30 rounded-2xl p-5 text-center">
        <p class="text-sm text-amber-800">
          <strong class="font-semibold">Australian pricing is provisional.</strong>
          Prices shown in Australian dollars are indicative while we finalise our local launch
          and may change before general availability. We will confirm final pricing with your club before any charge.
        </p>
      </div>
    </section>

    <!-- Founding Club Banner -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="reveal bg-[#85FFC7]/15 border border-[#1F7A52]/20 rounded-2xl p-6 text-center">
        <p class="text-[#0F2D2D] font-semibold text-lg mb-2">
          Founding Clubs Programme
        </p>
        <p class="text-ink-soft text-sm max-w-2xl mx-auto mb-4">
          Early Australian clubs get their first months free on any plan and help shape what we build next.
        </p>
        <a
          href="https://app.swimly.uk/create-club"
          class="inline-flex items-center justify-center text-sm font-bold px-6 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors min-h-12"
        >
          Get started
        </a>
      </div>
    </section>

    <!-- Pricing Grid -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 items-start">
        {
          tiers.map((tier) => (
            <div
              class:list={[
                "reveal relative flex flex-col p-6 lg:p-7 rounded-[20px] transition-all",
                tier.highlight
                  ? "bg-surface-raised border-2 border-[#297373]/35 shadow-[0_16px_40px_-16px_rgba(15,45,45,0.3)] lg:-translate-y-3"
                  : "bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]",
              ]}
            >
              {tier.highlight && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-[#0F2D2D] text-[#85FFC7] text-xs font-semibold whitespace-nowrap">
                  Most popular
                </div>
              )}

              <div class="mb-5">
                <h2 class="text-[13px] font-semibold tracking-[0.12em] uppercase text-ink-mute">{tier.name}</h2>
                <p class="text-sm text-ink-mute mt-2">{tier.description}</p>
              </div>

              <div class="flex items-baseline gap-1">
                <span class="font-display text-[44px] leading-none text-[#0F2D2D]">{tier.price}</span>
                {tier.period && <span class="text-ink-mute text-lg">{tier.period}</span>}
              </div>
              <p class="text-sm text-mint-ink mt-2 font-medium">{tier.members}</p>
              {tier.provisional && (
                <p class="text-xs text-amber-700 mt-1 font-medium">Provisional price</p>
              )}

              <div class="mt-4 mb-5 pb-5 border-b border-[#39393A]/8"></div>

              <ul class="space-y-3 mb-8 flex-1">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                    <Check class="w-4 h-4 text-mint-ink mt-0.5 shrink-0" />
                    {feature}
                  </li>
                ))}
              </ul>

              <a
                href={tier.ctaHref}
                class:list={[
                  "block text-center rounded-xl text-base font-bold transition-all min-h-12 leading-[3rem]",
                  tier.highlight || tier.price === "Free"
                    ? "bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover shadow-[0_8px_20px_-8px_rgba(255,133,82,0.6)]"
                    : "border border-[#297373]/40 text-ink hover:border-[#297373]/70 hover:bg-surface",
                ]}
              >
                {tier.cta}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- What is included -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center mb-10">
        <p class="eyebrow reveal">Every plan includes</p>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
          The essentials, at no extra cost
        </h2>
        <p class="reveal mt-4 text-ink-soft text-lg max-w-2xl mx-auto">
          We do not nickel-and-dime your committee. The core tools every swimming club needs are in every plan.
        </p>
      </div>
      <div class="reveal grid sm:grid-cols-2 gap-4">
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <h3 class="text-base font-semibold text-[#0F2D2D] mb-2">Unlimited coaches and sessions</h3>
          <p class="text-sm text-ink-mute">Add as many coaches, squads and training sessions as your club needs. No seat charges.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <h3 class="text-base font-semibold text-[#0F2D2D] mb-2">Card and bank payment</h3>
          <p class="text-sm text-ink-mute">Collect member fees automatically. Families choose card or bank payment, whichever suits them.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <h3 class="text-base font-semibold text-[#0F2D2D] mb-2">Parent portal</h3>
          <p class="text-sm text-ink-mute">Every family can view balances, payment history and upcoming sessions, and update their own details.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <h3 class="text-base font-semibold text-[#0F2D2D] mb-2">No annual lock-in</h3>
          <p class="text-sm text-ink-mute">Pay monthly and cancel any time. We earn your business every month, not with a contract.</p>
        </div>
      </div>
      <p class="reveal text-xs text-ink-faint mt-8 text-center">
        Prices shown in Australian dollars (AUD) and are provisional while we finalise our local launch.
        Any applicable GST will be shown at checkout.
      </p>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <p class="eyebrow reveal">FAQ</p>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
          Frequently asked questions
        </h2>
        <p class="reveal mt-4 text-ink-soft text-lg">
          Everything you need to know about Swimly pricing and billing in Australia.
        </p>
      </div>

      <div class="space-y-4">
        {
          faqItems.map((item) => (
            <details class="group bg-surface-raised border border-[#39393A]/10 rounded-xl transition-colors">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-[#0F2D2D] font-medium text-sm list-none">
                {item.question}
                <svg class="w-5 h-5 text-mint-ink shrink-0 ml-4 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-5 text-sm text-ink-mute leading-relaxed">
                {item.answer}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="reveal font-display text-4xl text-[#0F2D2D] mb-6">
        Ready to simplify club management?
      </h2>
      <p class="reveal text-xl text-ink-soft mb-8">
        Start free with up to 50 members. No card required.
      </p>
      <a
        href="https://app.swimly.uk/create-club"
        class="reveal inline-flex items-center justify-center text-lg font-bold px-8 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.6)]"
      >
        Start free
      </a>
    </section>
  </main>
  <Footer />

  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema, null, 2)} />
</Layout>
