              <td class="p-4 sm:p-6 text-center text-mint-ink">✓</td>
              <td class="p-4 sm:p-6 text-center text-mint-ink">✓</td>
              <td class="p-4 sm:p-6 text-center text-mint-ink">✓</td>
              <td class="p-4 sm:p-6 text-center text-ink-faint">Basic</td>
              <td class="p-4 sm:p-6 text-center text-ink-faint">✗</td>
            </tr>
