              <span class="flex items-center gap-1.5"><CheckCircle class="w-4 h-4 text-mint-ink" /> Free plan available</span>
              <span class="flex items-center gap-1.5"><CheckCircle class="w-4 h-4 text-mint-ink" /> No contract</span>
            </div>
          </div>
        </div>
        <!-- Device Mockups -->
        <div class="mt-16 flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">
          <div class="w-full max-w-2xl">
            <picture>
              <source srcset="/mockups/dashboard-macbook.webp" type="image/webp" />
              <img src="/mockups/dashboard-macbook.png" alt="Swimly dashboard on a MacBook showing club overview" class="w-full h-auto" loading="eager" />
