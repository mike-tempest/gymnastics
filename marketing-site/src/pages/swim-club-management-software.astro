---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { CreditCard, Users, ClipboardCheck, Shield, MessageSquare, ArrowRight, CheckCircle, Smartphone, Clock, XCircle } from "@lucide/astro";

const title = 'Swim Club Management Software UK | From Free';
const description = 'All-in-one swim club management system for UK clubs. Automate billing, track attendance, and stay Wavepower compliant. Free plan or become a founding club.';

const faqItems = [
  {
    question: "What is swim club management software?",
    answer: "Swim club management software is a platform that centralises membership records, billing, attendance tracking, and compliance management for swimming clubs. Swimly is purpose-built for UK clubs, handling Direct Debit payments, session registers, squad management, and Wavepower safeguarding requirements in one place."
  },
  {
    question: "How is Swimly different from spreadsheets?",
    answer: "Spreadsheets require manual data entry, have no automated billing, create version-control problems when shared between committee members, and offer no compliance tracking. Swimly automates fee collection via Direct Debit, provides real-time attendance registers, tracks DBS expiry dates, and gives every committee member role-based access to up-to-date information."
  },
  {
    question: "How much does swim club management software cost?",
    answer: "Swimly offers a free Starter plan for clubs with fewer than 50 members. The Club plan is £29/month for 50–200 members with automated billing. The Performance plan costs £49/month for larger clubs with 200–500 members and includes advanced reporting and priority support."
  },
  {
    question: "Can Swimly handle competitive clubs and learn-to-swim programmes?",
    answer: "Yes. Swimly supports multiple squad types with different fee structures, training schedules, and coaching teams. Whether you run a competitive swimming club, a learn-to-swim programme, or both, Swimly adapts to your structure."
  },
  {
    question: "How does Swimly compare to SwimClub Manager?",
    answer: "SwimClub Manager is an established platform but charges per-member fees and requires annual contracts. Swimly offers flat monthly pricing, no per-member charges, and is built with modern technology for a faster, more intuitive experience. Swimly also includes automated Direct Debit billing via GoCardless at no extra cost."
  },
  {
    question: "Is there a free trial or founding clubs programme?",
    answer: "Yes. Swimly offers a founding clubs programme, including 6 months free on any plan and white-glove migration support. There is no commitment required. If it doesn't work for your club, you can leave at any time."
  },
  {
    question: "Does Swimly work with Swim England?",
    answer: "Swimly is designed to complement Swim England systems. You can export member data in compatible formats, track Wavepower compliance requirements, and maintain records aligned with Swim England's framework for SwimMark accreditation."
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://swimly.uk"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Swim Club Management Software",
      "item": "https://swimly.uk/swim-club-management-software/"
    }
  ]
};

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Swimly",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": description,
  "url": "https://swimly.uk/swim-club-management-software/",
  "featureList": [
    "Membership management",
    "Automated Direct Debit billing",
    "Attendance tracking",
    "Wavepower compliance",
    "Squad management",
    "Parent portal",
    "Financial reporting"
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "GBP"
  }
};
---

<Layout title={title} description={description} faqItems={faqItems}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema, null, 2)} />
  <Nav />
  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="relative pt-12 pb-20 sm:pt-16 sm:pb-28 overflow-hidden">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#85FFC7]/20 border border-[#1F7A52]/15 text-mint-ink text-sm font-medium mb-6">
            <Shield class="w-4 h-4" />
            Built for UK swimming clubs
          </div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-[#0F2D2D] leading-tight tracking-tight mb-6">
            Swim Club Management
            <span class="text-mint-ink">Software</span>
          </h1>
          <p class="text-xl text-ink-soft mb-8 leading-relaxed max-w-2xl">
            Membership, automated billing, poolside attendance, and Wavepower compliance in one platform. Designed for volunteer-run committees, not IT departments.
          </p>
          <div class="flex flex-col sm:flex-row items-start gap-4">
            <a
              href="/founding-clubs/"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-lime-cta text-[#0F2D2D] font-bold hover:bg-lime-cta-hover transition-all text-lg shadow-[0_8px_20px_-8px_rgba(255,133,82,0.6)] hover:scale-[1.02]"
