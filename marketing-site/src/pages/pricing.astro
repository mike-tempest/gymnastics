---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PricingValue from "../components/PricingValue.astro";
import ROICalculator from "../components/ROICalculator.astro";
import { Check } from "@lucide/astro";
import {
  regionFromPath,
  formatPrice,
  canonicalFor,
  REGIONS,
  type RegionKey,
} from "../config/regions";

// Region is derived from the page path. The live page is /pricing/ on
// swimly.uk, which resolves to 'uk' and renders byte-for-byte as before.
// Other units add /us/pricing/, /ca/pricing/ and /au/pricing/ that reuse this
// page and pick up their own currency, prices and copy. Non-UK prices are
// PROVISIONAL and come from src/config/regions.ts.
const region: RegionKey = regionFromPath(Astro.url.pathname);
const cfg = REGIONS[region];
const isUK = region === "uk";

const clubPrice = formatPrice(region, cfg.pricePrimary);
const performancePrice = formatPrice(region, cfg.pricePerformance);

// Governing-body integration (Swim England for the UK, USA Swimming for the US).
const governingBodyFeature = `${cfg.governingBody} integration`;
// Direct Debit is UK-only; other regions use generic card and bank wording.
const automatedPaymentFeature = isUK
  ? "Automated Direct Debit"
  : "Automated card and bank payments";

const title = isUK
  ? "Swim Club Software Pricing | Free to £49/mo"
  : `Swim Club Software Pricing | Free to ${performancePrice}/mo`;
const description = isUK
  ? "Swim club software from free (up to 50 members) to £49/mo. No per-member fees, no hidden charges. See what every Swimly plan includes."
  : `Swim club software from free (up to 50 members) to ${performancePrice}/mo. No per-member fees, no hidden charges. See what every Swimly plan includes.`;

const tiers = [
  {
    name: "Starter",
    price: "Free",
    period: "",
    description: "For small clubs finding their feet",
    members: "Up to 50 members",
    highlight: false,
    cta: "Start free",
    ctaHref: cfg.appUrl + "/create-club",
    features: [
      "Basic membership management",
      "Attendance tracking",
      "Email notifications",
      "Session scheduling",
      "Financial summary",
    ],
  },
  {
    name: "Club",
    price: clubPrice,
    period: "/mo",
    description: "The full toolkit for growing clubs",
    members: "50–200 members",
    highlight: true,
    cta: "Start free",
    ctaHref: cfg.appUrl + "/create-club",
    features: [
      "Everything in Starter",
      "Billing and invoicing",
      "Parent portal",
      "Squad management",
      automatedPaymentFeature,
      "Custom reports and exports",
      "Priority email support",
    ],
  },
  {
    name: "Performance",
    price: performancePrice,
    period: "/mo",
    description: "For ambitious, competitive clubs",
    members: "200–500 members",
    highlight: false,
    cta: "Start free",
    ctaHref: cfg.appUrl + "/create-club",
    features: [
      "Everything in Club",
      "Performance analytics",
      governingBodyFeature,
      "API access",
      "Competition fee tracking",
      "Safeguarding dashboard",
      "Priority phone support",
    ],
  },
  {
    name: "Enterprise",
    price: "Custom",
    period: "",
    description: "Bespoke pricing for large organisations",
    members: "500+ members",
    highlight: false,
    cta: "Get in touch",
    ctaHref: "/contact/",
    features: [
      "Everything in Performance",
      "Dedicated support",
      "Custom integrations",
      "SLA and onboarding support",
      "Multi-site management",
      "Dedicated account manager",
    ],
  },
];

const faqItems = [
  {
    question: "Is the Starter plan really free?",
    answer:
      "Yes. The Starter plan is completely free for clubs with up to 50 members. There are no hidden fees, no credit card required, and no time limit. You can use it for as long as you like.",
  },
  {
    question: "Why is Swimly cheaper than competitors?",
    answer:
      "We use a flat-rate pricing model rather than charging per member, which keeps costs predictable as your club grows. We built Swimly with modern technology from the ground up, so we do not carry the legacy overhead of older platforms. Most importantly, transparent pricing builds trust with volunteer treasurers. No hidden setup fees, no per-transaction charges, no surprise costs at renewal. What you see is what you pay.",
  },
  {
    question: "Can I switch between plans at any time?",
    answer:
      "Absolutely. You can upgrade or downgrade your plan at any time from your club dashboard. When upgrading, you get immediate access to the new features. When downgrading, the change takes effect at the end of your current billing period.",
  },
  {
    question: "Are there any per-member fees?",
    answer:
      "No. Every plan has a flat monthly rate regardless of how many members you have within your tier. We believe swim clubs should not be penalised for growing.",
  },
  {
    question: "How does billing work?",
    answer: isUK
      ? "Plans are billed monthly by Direct Debit or card payment. You can cancel at any time and your access continues until the end of the billing period. We do not lock you into annual contracts."
      : "Plans are billed monthly by card or bank payment. You can cancel at any time and your access continues until the end of the billing period. We do not lock you into annual contracts.",
  },
  {
    question: "What happens if my club grows beyond the member limit?",
    answer:
      "We will notify you when you are approaching your plan's member limit. You can upgrade to the next tier at any time. We will never cut off access or disable features without giving you plenty of notice.",
  },
  {
    question: "Do you offer discounts for annual billing?",
    answer:
      "We are planning to introduce annual billing with a discount in the future. For now, all plans are billed monthly to keep things simple and flexible.",
  },
  {
    question: "What payment methods do you accept?",
    answer: isUK
      ? "We accept Direct Debit (via GoCardless) and all major credit and debit cards. Direct Debit is the simplest option for UK clubs as payments are collected automatically each month."
      : "We accept all major credit and debit cards and bank payments through trusted, regulated providers. Payments are collected automatically each month.",
  },
];

// Schema prices and currency follow the region. Annual figures are the monthly
// price; the currency code comes from REGIONS[region].currency.
const clubPriceNum = String(cfg.pricePrimary);
const performancePriceNum = String(cfg.pricePerformance);
const priceCurrency = cfg.currency;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Swimly Swim Club Management Software",
  description: description,
  brand: { "@type": "Brand", name: "Swimly" },
  offers: [
    { "@type": "Offer", name: "Starter", price: "0", priceCurrency, description: "Free plan for small clubs with up to 50 members", eligibleQuantity: { "@type": "QuantitativeValue", maxValue: 50, unitText: "members" } },
    { "@type": "Offer", name: "Club", price: clubPriceNum, priceCurrency, priceSpecification: { "@type": "UnitPriceSpecification", price: clubPriceNum, priceCurrency, billingDuration: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" } }, description: "Full toolkit for growing clubs with 50 to 200 members" },
    { "@type": "Offer", name: "Performance", price: performancePriceNum, priceCurrency, priceSpecification: { "@type": "UnitPriceSpecification", price: performancePriceNum, priceCurrency, billingDuration: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" } }, description: "Advanced features for competitive clubs with 200 to 500 members" },
    { "@type": "Offer", name: "Enterprise", price: "0", priceCurrency, description: "Custom pricing for large organisations with 500 or more members" },
  ],
};

// UK keeps its original breadcrumb URLs (no trailing slash) so the live page is
// byte-for-byte unchanged. Non-UK regions use canonical trailing-slash URLs.
const homeHref = isUK ? cfg.host : `${cfg.host}${cfg.pathPrefix}/`;
const pricingHref = isUK
  ? canonicalFor(Astro.url.pathname).replace(/\/$/, "")
  : canonicalFor(Astro.url.pathname);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": homeHref },
    { "@type": "ListItem", "position": 2, "name": "Pricing", "item": pricingHref }
  ]
};

const cell = "py-2 px-2 sm:py-3 sm:px-4";
const swimCol = "py-2 px-2 sm:py-3 sm:px-4 text-center bg-[#85FFC7]/10 border-l border-r border-[#297373]/25";
---

<Layout title={title} description={description} faqItems={faqItems}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main class="pt-28 pb-16">
    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="eyebrow reveal">Pricing</p>
      <h1 class="reveal font-display text-5xl sm:text-6xl text-[#0F2D2D] mt-5 mb-6">
        Simple, transparent pricing
      </h1>
      <p class="reveal text-xl text-ink-soft max-w-2xl mx-auto mb-4">
        No per-member fees. No hidden charges. No annual lock-in. Just a flat monthly rate that scales with your club.
      </p>
      <p class="reveal text-base text-mint-ink max-w-2xl mx-auto">
        Preparing an AGM proposal? Transparent pricing makes committee decisions easier.
      </p>
    </section>

    <!-- Founding Club Banner -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="reveal bg-[#85FFC7]/15 border border-[#1F7A52]/20 rounded-2xl p-6 text-center">
        <p class="text-[#0F2D2D] font-semibold text-lg mb-2">
          Founding Clubs Programme
        </p>
        <p class="text-ink-soft text-sm max-w-2xl mx-auto mb-4">
          Founding clubs get 6 months free on any plan. Apply for the founding clubs programme.
        </p>
        <a
          href="/founding-clubs/"
          class="inline-flex items-center justify-center text-sm font-bold px-6 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors min-h-12"
        >
          Apply now
        </a>
      </div>
    </section>

    <!-- Pricing Grid -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 items-start">
        {
          tiers.map((tier) => (
            <div
              class:list={[
                "reveal relative flex flex-col p-6 lg:p-7 rounded-[20px] transition-all",
                tier.highlight
                  ? "bg-surface-raised border-2 border-[#297373]/35 shadow-[0_16px_40px_-16px_rgba(15,45,45,0.3)] lg:-translate-y-3"
                  : "bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]",
              ]}
            >
              {tier.highlight && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-[#0F2D2D] text-[#85FFC7] text-xs font-semibold whitespace-nowrap">
                  Most popular
                </div>
              )}

              <div class="mb-5">
                <h2 class="text-[13px] font-semibold tracking-[0.12em] uppercase text-ink-mute">{tier.name}</h2>
                <p class="text-sm text-ink-mute mt-2">{tier.description}</p>
              </div>

              <div class="flex items-baseline gap-1">
                <span class="font-display text-[44px] leading-none text-[#0F2D2D]">{tier.price}</span>
                {tier.period && <span class="text-ink-mute text-lg">{tier.period}</span>}
              </div>
              <p class="text-sm text-mint-ink mt-2 font-medium">{tier.members}</p>
              {tier.name === "Club" && isUK && (
                <p class="text-xs text-ink-faint mt-1">Less than £1 per member per month</p>
              )}

              <div class="mt-4 mb-5 pb-5 border-b border-[#39393A]/8"></div>

              <ul class="space-y-3 mb-8 flex-1">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                    <Check class="w-4 h-4 text-mint-ink mt-0.5 shrink-0" />
                    {feature}
                  </li>
                ))}
              </ul>

              <a
                href={tier.ctaHref}
                class:list={[
                  "block text-center rounded-xl text-base font-bold transition-all min-h-12 leading-[3rem]",
                  tier.highlight || tier.price === "Free"
                    ? "bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover shadow-[0_8px_20px_-8px_rgba(255,133,82,0.6)]"
                    : "border border-[#297373]/40 text-ink hover:border-[#297373]/70 hover:bg-surface",
                ]}
              >
                {tier.cta}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ROI Calculator -->
    <ROICalculator />

    <!-- Competitive Comparison -->
    {isUK && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <p class="eyebrow reveal">Compare the cost</p>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
          Compare transparent pricing
        </h2>
        <p class="reveal mt-4 text-ink-soft text-lg max-w-2xl mx-auto">
          Preparing a proposal for your AGM? Here is how Swimly Club stacks up
          against the alternatives, so your committee can make an informed decision.
        </p>
      </div>

      <!-- Annual savings callout -->
      <div class="reveal mb-8 p-5 rounded-2xl bg-[#85FFC7]/15 border border-[#1F7A52]/20 text-center">
        <p class="text-sm text-ink-mute mb-1">Switch from SwimClub Manager and save</p>
        <p class="font-display text-5xl text-mint-ink">&pound;301<span class="text-lg font-normal text-ink-mute">/year</span></p>
        <p class="text-xs text-ink-mute mt-2">That is enough to cover pool hire for two extra training sessions.</p>
      </div>

      <!-- Annual cost highlight -->
      <div class="reveal grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="bg-surface-raised border-2 border-[#297373]/35 rounded-2xl p-5 sm:p-6 text-center shadow-[0_16px_40px_-16px_rgba(15,45,45,0.3)]">
          <p class="text-sm text-mint-ink font-medium mb-1">Swimly Club</p>
          <p class="font-display text-3xl text-[#0F2D2D]">&pound;348<span class="text-lg text-ink-mute font-normal">/yr</span></p>
          <p class="text-xs text-ink-mute mt-1">&pound;29/mo &middot; flat rate &middot; cancel anytime</p>
          <p class="text-xs text-mint-ink mt-2 sm:hidden font-medium">46% cheaper than SwimClub Manager</p>
        </div>
        <div class="bg-surface-raised border border-[#39393A]/10 rounded-2xl p-5 sm:p-6 text-center">
          <p class="text-sm text-ink-mute font-medium mb-1">SwimClub Manager</p>
          <p class="font-display text-3xl text-[#0F2D2D]">&pound;649<span class="text-lg text-ink-mute font-normal">/yr</span></p>
          <p class="text-xs text-ink-mute mt-1">Annual licence &middot; locked in</p>
        </div>
        <div class="bg-surface-raised border border-[#39393A]/10 rounded-2xl p-5 sm:p-6 text-center">
          <p class="text-sm text-ink-mute font-medium mb-1">Club Organiser</p>
          <p class="font-display text-3xl text-[#0F2D2D]">&pound;299<span class="text-lg text-ink-mute font-normal">/yr</span></p>
          <p class="text-xs text-ink-mute mt-1">Annual licence &middot; locked in</p>
        </div>
      </div>

      <!-- Feature comparison table (desktop) -->
      <div class="reveal overflow-x-auto -mx-4 sm:mx-0 hidden sm:block rounded-2xl border border-[#39393A]/10">
        <table class="w-full text-xs sm:text-sm text-left bg-surface-raised">
          <thead>
            <tr class="border-b border-[#39393A]/10 bg-surface">
              <th class={`${cell} text-ink-mute font-medium`}>Feature</th>
              <th class="py-2 px-2 sm:py-3 sm:px-4 text-mint-ink font-semibold text-center bg-[#85FFC7]/10 border-l border-r border-[#297373]/25">Swimly Club</th>
              <th class={`${cell} text-ink-mute font-medium text-center`}>SwimClub Manager</th>
              <th class={`${cell} text-ink-mute font-medium text-center`}>Club Organiser</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#39393A]/8">
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Flat-rate pricing (no per-member fees)</td>
              <td class={swimCol}>
                <div class="flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span class="text-mint-ink text-xs font-medium">Included</span>
                </div>
              </td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Tiered per-member</span></td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Tiered per-member</span></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Contract flexibility</td>
              <td class={swimCol}>
                <div class="flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  <span class="text-mint-ink text-xs font-medium">Monthly, cancel anytime</span>
                </div>
              </td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Annual lock-in</span></td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Annual lock-in</span></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Hidden fees or setup costs</td>
              <td class={swimCol}>
                <div class="flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span class="text-mint-ink text-xs font-medium">None</span>
                </div>
              </td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Various add-ons</span></td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Per-transaction fees</span></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Mobile-first design</td>
              <td class={swimCol}>
                <div class="flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                  <span class="text-mint-ink text-xs font-medium">Built mobile-first</span>
                </div>
              </td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Separate app required</span></td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Limited responsive</span></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Automated Direct Debit built in</td>
              <td class={swimCol}>
                <div class="flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
                  <span class="text-mint-ink text-xs font-medium">Included</span>
                </div>
              </td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Add-on</span></td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">Third-party</span></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Parent portal</td>
              <td class={swimCol}>
                <div class="flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                  <span class="text-mint-ink text-xs font-medium">Included</span>
                </div>
              </td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">No</span></td>
              <td class={`${cell} text-center`}><span class="text-ink-faint text-xs">No</span></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Membership management</td>
              <td class={swimCol}><Check class="w-4 h-4 text-mint-ink mx-auto" /></td>
              <td class={`${cell} text-center`}><Check class="w-4 h-4 text-ink-faint mx-auto" /></td>
              <td class={`${cell} text-center`}><Check class="w-4 h-4 text-ink-faint mx-auto" /></td>
            </tr>
            <tr class="hover:bg-surface transition-colors">
              <td class={`${cell} text-ink-soft`}>Attendance tracking</td>
              <td class={swimCol}><Check class="w-4 h-4 text-mint-ink mx-auto" /></td>
              <td class={`${cell} text-center`}><Check class="w-4 h-4 text-ink-faint mx-auto" /></td>
              <td class={`${cell} text-center`}><Check class="w-4 h-4 text-ink-faint mx-auto" /></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Feature comparison (mobile stacked cards) -->
      <div class="sm:hidden space-y-4">
        <div class="p-4 rounded-xl bg-surface-raised border border-[#39393A]/10">
          <h3 class="text-sm font-semibold text-[#0F2D2D] mb-3">Flat-rate pricing</h3>
          <div class="space-y-2">
            <div class="flex justify-between items-center"><span class="text-xs text-mint-ink font-medium">Swimly</span><span class="text-xs text-mint-ink">Included</span></div>
            <div class="flex justify-between items-center"><span class="text-xs text-ink-mute">SwimClub Manager</span><span class="text-xs text-ink-faint">Tiered per-member</span></div>
            <div class="flex justify-between items-center"><span class="text-xs text-ink-mute">Club Organiser</span><span class="text-xs text-ink-faint">Tiered per-member</span></div>
          </div>
        </div>
        <div class="p-4 rounded-xl bg-surface-raised border border-[#39393A]/10">
          <h3 class="text-sm font-semibold text-[#0F2D2D] mb-3">Contract flexibility</h3>
          <div class="space-y-2">
            <div class="flex justify-between items-center"><span class="text-xs text-mint-ink font-medium">Swimly</span><span class="text-xs text-mint-ink">Monthly, cancel anytime</span></div>
