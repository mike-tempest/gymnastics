---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Pricing from "../components/Pricing.astro";
import Waitlist from "../components/Waitlist.astro";
import Footer from "../components/Footer.astro";
import { CreditCard, Trophy, Settings, Users, GraduationCap, BarChart3, ArrowRight, X, CircleCheck } from "@lucide/astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://swimly.uk/" }
  ]
};

const pains = [
  { n: "01", title: "Five spreadsheets, and none of them agree", desc: "Members in one, payments in another, attendance on paper. Nobody knows which version is current." },
  { n: "02", title: "Evenings lost to chasing subs", desc: "Standing orders fail quietly. The Treasurer ends up sending awkward reminders at ten o'clock at night." },
  { n: "03", title: "Safeguarding records nobody can reach", desc: "Wavepower compliance you cannot evidence quickly is compliance you cannot evidence at all." },
  { n: "04", title: "Handover means starting again", desc: "When the Membership Secretary steps down, the club's knowledge walks out of the door with them." },
];

const before = [
  "Membership records scattered across spreadsheets",
  "Chasing parents for subs every month on WhatsApp",
  "Registers printed, filled in by hand, then lost",
  "Safeguarding files in a folder nobody can access",
];
const after = [
  "Every member, payment and session in one place",
  "Direct Debit collects itself, failures retry automatically",
  "Live registers on the phone the coach already carries",
  "Wavepower-aligned records with DBS expiry alerts",
];

const roles = [
  { from: "10h", to: "2h", unit: "per week", role: "Membership Secretary", desc: "Parents keep their own details current in the portal. Welcome emails and renewal reminders send themselves." },
  { from: "6h", to: "30m", unit: "per week", role: "Treasurer", desc: "Subs arrive on schedule, failed payments retry on their own, and the AGM report generates in one click." },
  { from: "Paper", to: "Phone", unit: "registers", role: "Head Coach", desc: "Attendance taken poolside in seconds, even at six in the morning with wet hands and bad lighting." },
];

const reasons = [
  { title: "Built for Swim England affiliation", desc: "Handle membership categories, registration requirements, and renewal cycles that match Swim England's framework. Import your SE member data, track coach qualifications, and maintain SwimMark compliance, all in one system." },
  { title: "Wavepower compliance as standard", desc: "Track DBS checks, safeguarding training certificates, and coach qualifications with automated expiry alerts. Generate compliance reports for Swim England audits. No more spreadsheets tracking renewal dates." },
  { title: "Direct Debit by default", desc: "Native GoCardless integration means automated monthly Direct Debit collection for UK swim clubs. No more chasing standing orders, reconciling bank transfers, or dealing with failed payments manually." },
  { title: "Transparent flat-rate pricing", desc: "No per-member fees that increase as your club grows. £29/month for 50-200 members, £49/month for 200-500. Free for clubs under 50. Pricing you can predict, not bills that escalate." },
  { title: "UK data hosting and GDPR compliance", desc: "Your club's data stays in UK data centres. Full GDPR compliance with subject access request handling, data portability, and right to erasure built in." },
  { title: "Built by people who run clubs", desc: "Swimly was created by swim parents and committee members who have sat through the same frustrating meetings. We understand volunteer capacity, committee handovers, and evening-and-weekend reality." },
];

const steps = [
  { tag: "Day 0", title: "Get in touch", desc: "Tell us about your club, how many members you have, and what you currently use. No hard sell, just a conversation about whether Swimly fits." },
  { tag: "Days 1-3", title: "We migrate your data", desc: "Send us your spreadsheets or exports. We import members, set up squads, configure billing schedules, and build your session timetable. You review it, we adjust." },
  { tag: "Day 5", title: "Your committee logs in", desc: "We walk your Treasurer, Membership Secretary, and coaches through the platform. Each person sees exactly the features their role needs." },
  { tag: "Week 2+", title: "You're live", desc: "Payments collect automatically. Coaches take digital attendance. Parents self-serve. We stay on hand through the first month to fine-tune anything." },
];

const compares = [
  { label: "Swimly vs SwimClub Manager", href: "/compare/swimclubmanager/", desc: "Compare features, pricing, and UK-specific capabilities" },
  { label: "Swimly vs TeamUnify", href: "/compare/teamunify/", desc: "Why UK clubs choose Swimly over US platforms" },
  { label: "Swimly vs Club Organiser", href: "/compare/cluborganiser/", desc: "Budget vs full-featured swim club software" },
  { label: "Swimly vs ClubSpark", href: "/compare/clubspark/", desc: "Swim-specific vs generic sports club platform" },
  { label: "Swimly vs GoMotion", href: "/compare/gomotion/", desc: "UK Direct Debit vs US payment processing" },
  { label: "Full platform comparison 2026", href: "/best-swim-club-software-uk/", desc: "Compare all six platforms side by side", featured: true },
];

const solutions = [
  { icon: CreditCard, title: "Billing & Payments", desc: "Automate fee collection with Direct Debit. No more chasing parents or manual bank reconciliation.", href: "/swimming-club-billing-software/" },
  { icon: Trophy, title: "Swim Club Software", desc: "All-in-one management platform for UK competitive swimming clubs. Membership, billing, and compliance.", href: "/swim-club-software/" },
  { icon: Settings, title: "Management Software", desc: "Membership, billing, attendance, and Wavepower compliance in one platform for volunteer-run clubs.", href: "/swim-club-management-software/" },
  { icon: Users, title: "Swim Team Software", desc: "Purpose-built for competitive and recreational swim teams. Squad management, billing, and poolside attendance.", href: "/swim-team-management-software/" },
  { icon: GraduationCap, title: "Swim School Management", desc: "Lesson scheduling, progression tracking, and parent communication for learn-to-swim programmes.", href: "/swim-school-management/" },
  { icon: BarChart3, title: "Software Comparison 2026", desc: "Compare Swimly with SwimClub Manager, TeamUnify, GoMotion, and more side by side.", href: "/best-swim-club-software-uk/" },
];
---

<Layout
  title="Swim Club Management Software UK | Free Plan | Swimly"
  description="Swim club management software built for UK swimming clubs. Automate Direct Debit billing, membership, attendance, and Wavepower compliance. Free starter plan for clubs under 50 members."
  faqItems={[
    { question: "What is swim club management software?", answer: "Swim club management software is a platform that helps swimming clubs manage membership, billing, attendance, and compliance in one place. Swimly is built specifically for UK swimming clubs to handle Direct Debit payments, session registers, and Wavepower safeguarding requirements." },
    { question: "How much does swim club software cost?", answer: "Swimly has a free Starter plan for clubs under 50 members. The Club plan costs £29/month for 50-200 members and includes automated billing. The Performance plan is £49/month for larger clubs with 200-500 members. All plans include unlimited coaches and sessions." },
    { question: "What features do I need in swim team management software?", answer: "Essential features include automated billing and Direct Debit collection, digital attendance tracking, membership management, Wavepower compliance tools (DBS tracking, safeguarding records), parent communication, and session scheduling. Swimly includes all of these in every plan." },
    { question: "Does Swimly work for swim schools as well as competitive clubs?", answer: "Yes. Swimly supports both competitive swimming clubs and learn-to-swim programmes. You can manage different squads, lesson schedules, and fee structures all in one platform." },
    { question: "How hard is it to migrate from spreadsheets or another system?", answer: "Swimly provides white-glove migration for founding clubs. We handle importing your membership data, setting up billing schedules, and training your committee. We migrate your data within the first few days, and most clubs are up and running within two weeks. No technical knowledge required." },
    { question: "Does Swimly integrate with GoCardless for Direct Debit?", answer: "Yes. Swimly integrates directly with GoCardless to handle Direct Debit collection for UK swimming clubs. Payments are collected automatically each month and failures are retried automatically." },
    { question: "Can parents access their own information and payment history?", answer: "Yes. Every family gets access to a parent portal where they can view payment history, upcoming sessions, attendance records, and outstanding balances. Parents can also update contact details and emergency information themselves." },
    { question: "Is Swimly compliant with Wavepower and Swim England requirements?", answer: "Yes. Swimly includes built-in compliance tools for Wavepower safeguarding requirements including DBS tracking, coach qualifications, emergency contact management, and session registers. We stay updated with Swim England policy changes." },
    { question: "Is Swimly available now?", answer: "Yes. You can create your club and start using Swimly today at app.swimly.uk. Clubs under 50 members are free with no card required. Founding clubs receive 6 months free on any plan, white-glove migration, and priority support." }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main>
    <Hero />

    <div class="lane-divider max-w-6xl mx-auto" aria-hidden="true"></div>

    <!-- The problem -->
    <section class="py-20 sm:py-28">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p class="eyebrow reveal">The problem</p>
            <h2 class="reveal font-display text-4xl sm:text-5xl leading-[1.1] text-[#0F2D2D] mt-5">
              You did not sign up for a <em class="text-mint-ink">second job</em>
            </h2>
            <p class="reveal mt-6 text-lg text-ink-soft leading-relaxed max-w-md">
              But that is what running a club feels like when the tools fight you.
              Every volunteer committee knows the pattern.
            </p>
          </div>
          <div class="lg:col-span-7">
            <ol class="divide-y divide-[#39393A]/10">
              {pains.map(p => (
                <li class="reveal flex gap-6 py-6 first:pt-0 last:pb-0">
                  <span class="font-display text-2xl text-[#297373]/60 leading-none pt-1 tabular-nums">{p.n}</span>
                  <div>
                    <h3 class="text-[17px] font-semibold text-[#0F2D2D]">{p.title}</h3>
                    <p class="text-[15px] text-ink-soft leading-relaxed mt-1.5">{p.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Before / after -->
    <section class="pb-20 sm:pb-28">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal grid md:grid-cols-2 rounded-[28px] overflow-hidden border border-[#39393A]/10 shadow-[0_24px_56px_-24px_rgba(15,45,45,0.3)]">
          <div class="bg-surface p-8 sm:p-10">
            <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[#B91C1C]/80 mb-7">The spreadsheet era</p>
            <ul class="space-y-5">
              {before.map(item => (
                <li class="flex items-start gap-3.5 text-[15px] text-ink-soft leading-snug">
                  <X class="w-[18px] h-[18px] text-[#B91C1C]/70 mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="relative bg-[#0F2D2D] p-8 sm:p-10">
            <div class="ripple absolute -top-16 -right-16 w-56 h-56" aria-hidden="true"></div>
            <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[#85FFC7] mb-7">With Swimly</p>
            <ul class="relative space-y-5">
              {after.map(item => (
                <li class="flex items-start gap-3.5 text-[15px] text-[#E6E6E6] leading-snug">
                  <CircleCheck class="w-[18px] h-[18px] text-[#85FFC7] mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Why UK clubs choose Swimly -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <p class="eyebrow reveal">Why Swimly</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Why UK swimming clubs choose Swimly</h2>
          <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
            Not a generic sports app adapted for swimming. Not American software with a GBP option bolted on.
            Purpose-built for how UK swim clubs actually work, from Direct Debit billing to Wavepower compliance.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {reasons.map(r => (
            <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
              <h3 class="text-lg font-semibold mb-2.5 text-mint-ink">{r.title}</h3>
              <p class="text-ink-mute text-sm leading-relaxed">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hours back -->
    <section class="py-20 sm:py-28">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <p class="eyebrow reveal">Where the hours come back</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
            Less admin. More <em class="text-mint-ink">swimming</em>.
          </h2>
        </div>
        <div class="space-y-0">
          {roles.map((r, i) => (
            <div class:list={["reveal grid sm:grid-cols-12 gap-3 sm:gap-10 items-start py-9", i > 0 && "border-t border-[#39393A]/10"]}>
              <div class="sm:col-span-5 sm:text-right">
                <div class="font-display text-[40px] sm:text-5xl leading-none text-[#0F2D2D] tabular-nums">
                  {r.from}
                  <span class="text-[#297373]/50 mx-1.5">→</span>
                  <span class="result-mark">{r.to}</span>
                </div>
                <div class="text-sm text-ink-mute mt-2">{r.unit}</div>
              </div>
              <div class="sm:col-span-7">
                <h3 class="text-lg font-semibold text-[#0F2D2D]">{r.role}</h3>
                <p class="text-[15px] text-ink-soft leading-relaxed mt-1.5 max-w-lg">{r.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Features />

    <!-- Product band -->
    <section class="relative py-20 sm:py-28 bg-[#0F2D2D] overflow-hidden">
      <div class="ripple absolute -left-24 top-10 w-80 h-80 opacity-60" aria-hidden="true"></div>
      <div class="absolute right-[-120px] bottom-[-180px] w-[480px] h-[480px] rounded-full bg-[#85FFC7]/8 blur-[110px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <p class="eyebrow-light reveal">Built in the open</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl leading-[1.1] text-[#E6E6E6] mt-5">
            The same product your committee will use
          </h2>
          <p class="reveal mt-6 text-lg text-[#E6E6E6]/65 leading-relaxed max-w-xl">
            These are live screens from Swimly today. Swimmers, sessions, billing
            and compliance in one system, with each committee role seeing exactly
            what their job needs.
          </p>
        </div>
        <div class="mt-14 grid md:grid-cols-2 gap-8 md:gap-10 items-start">
          <figure class="reveal" style="transform: rotate(-1deg)">
            <div class="rounded-2xl overflow-hidden border border-[#E6E6E6]/12 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.55),0_0_40px_rgba(133,255,199,0.07)]">
              <img src="/images/app-screenshots/swimmers-desktop.png" alt="Swimly swimmers database with member profiles and squad assignments" class="w-full" loading="lazy" />
            </div>
            <figcaption class="mt-4 text-sm text-[#E6E6E6]/55">Swimmers, profiles, squads and medical notes in one record</figcaption>
          </figure>
          <figure class="reveal md:mt-12" style="transform: rotate(1.25deg)">
            <div class="rounded-2xl overflow-hidden border border-[#E6E6E6]/12 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.55),0_0_40px_rgba(133,255,199,0.07)]">
              <img src="/images/app-screenshots/billing-desktop.png" alt="Swimly billing showing Direct Debit collection and invoice status" class="w-full" loading="lazy" />
            </div>
            <figcaption class="mt-4 text-sm text-[#E6E6E6]/55">Billing, Direct Debit collection without the chasing</figcaption>
          </figure>
        </div>
        <p class="reveal mt-12">
          <a href="/features/" class="inline-flex items-center gap-2 text-[#85FFC7] hover:text-[#B2FFE0] font-medium transition-colors group">
            Explore the features
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
          </a>
        </p>
      </div>
    </section>

    <!-- Compare -->
    <section class="py-20 sm:py-28">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="eyebrow reveal">Honest comparisons</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">How does Swimly compare?</h2>
          <p class="reveal text-ink-soft text-lg mt-5 max-w-2xl mx-auto">
            We have written honest assessments of every major swim club platform, including where competitors do things well.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {compares.map(c => (
            <a href={c.href} class:list={["reveal block p-6 rounded-2xl bg-surface-raised border transition-all group hover:-translate-y-0.5", c.featured ? "border-[#297373]/40" : "border-[#39393A]/10"]}>
              <h3 class="text-lg font-semibold mb-2 text-[#0F2D2D] group-hover:text-mint-ink transition-colors">{c.label}</h3>
              <p class="text-ink-mute text-sm">{c.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-2xl">
          <p class="eyebrow reveal">Switching is easier than you think</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">From spreadsheet to software in about two weeks</h2>
          <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
            Our founding club programme includes white-glove migration. We do the heavy lifting so you do not have to.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {steps.map(s => (
            <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
              <span class="eyebrow">{s.tag}</span>
              <h3 class="text-lg font-semibold text-[#0F2D2D] mt-3 mb-2">{s.title}</h3>
              <p class="text-sm text-ink-mute leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
        <div class="reveal mt-8 p-6 rounded-2xl bg-[#85FFC7]/15 border border-[#1F7A52]/20">
          <p class="text-ink-soft leading-relaxed">
            <strong class="text-mint-ink">Founding clubs get 6 months free on any plan</strong> plus priority migration support.
            We are limiting the programme to the first 10 clubs so we can deliver exceptional onboarding.
            No contract, no payment details required to start.
          </p>
        </div>
      </div>
    </section>

    <!-- Founder story -->
    <section class="py-20 sm:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <p class="eyebrow reveal">Built from the poolside</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
            Built from the poolside, not a <em class="text-mint-ink">boardroom</em>
          </h2>
          <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
            Swimly's founder is a swim parent at a Kent club. He has sat through the AGMs,
            chased the subs, and done the spreadsheets. This is software built by someone
            who understands what volunteer committees deal with every week.
          </p>
        </div>
        <div class="grid sm:grid-cols-3 gap-5 max-w-3xl mx-auto">
          <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 text-center shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
            <p class="font-display text-4xl text-[#0F2D2D] mb-2">1,500+</p>
            <p class="text-sm text-ink-mute">Swim England affiliated clubs across the country</p>
          </div>
          <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 text-center shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
            <p class="font-display text-4xl text-[#0F2D2D] mb-2">46%</p>
            <p class="text-sm text-ink-mute">cheaper than legacy swim club software</p>
          </div>
          <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 text-center shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
            <p class="font-display text-4xl text-[#0F2D2D] mb-2">10</p>
            <p class="text-sm text-ink-mute">founding club places in the first cohort</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Solutions grid -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="eyebrow reveal">Built for your needs</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Whatever kind of club you run</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {solutions.map(s => (
            <a href={s.href} class="reveal group block p-7 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.25)] hover:-translate-y-0.5 transition-all">
              <div class="w-11 h-11 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
                <s.icon class="w-5 h-5 text-mint-ink" />
              </div>
              <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2 group-hover:text-mint-ink transition-colors">{s.title}</h3>
              <p class="text-ink-mute text-sm leading-relaxed mb-3">{s.desc}</p>
              <span class="text-mint-ink text-sm font-medium inline-flex items-center gap-1">Learn more <ArrowRight class="w-3.5 h-3.5" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Pricing />
    <Waitlist />
  </main>
  <Footer />
</Layout>
