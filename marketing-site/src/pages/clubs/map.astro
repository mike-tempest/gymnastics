---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import clubsData from "../../data/clubs.json";

const clubs = clubsData;
const regions = [...new Set(clubs.map(club => club.region))].sort();
const clubsWithCoords = clubs.filter(c => c.lat && c.lng && c.lat !== 0 && c.lng !== 0);
---

<Layout
  title="Find Swimming Clubs Near You | UK Club Map | Swimly"
  description="Interactive map of swimming clubs across the UK. Find your nearest club, explore by region, and discover training opportunities for swimmers of all ages and abilities."
>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

  <Nav />

  <main class="pt-16 flex flex-col" id="map-main">
    <!-- Controls bar -->
    <div class="bg-surface-raised border-b border-[#39393A]/10">
      <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="flex-1 flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <h1 class="font-display text-lg text-[#0F2D2D] whitespace-nowrap">Club Map</h1>

            <select
              id="regionFilter"
              class="w-full sm:w-64 px-4 py-2 bg-surface border border-[#39393A]/10 rounded-lg text-ink text-sm focus:outline-none focus:border-[#297373]/50 transition-colors appearance-none"
            >
              <option value="">All Regions</option>
              {regions.map(region => (
                <option value={region}>{region}</option>
              ))}
            </select>

            <span id="clubCount" class="text-sm text-ink-mute whitespace-nowrap">
              Showing {clubsWithCoords.length} of {clubs.length} clubs
            </span>
          </div>

          <a
            href="/clubs/"
            class="text-sm text-mint-ink hover:text-[#0F2D2D] transition-colors whitespace-nowrap"
          >
            View as list
          </a>
        </div>
      </div>
    </div>

    <!-- Map container -->
    <div id="map" class="flex-1 min-h-[calc(100vh-8rem)]"></div>
  </main>

  <Footer />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

  <script is:inline define:vars={{ clubsJSON: JSON.stringify(clubsWithCoords), totalClubs: clubs.length }}>
    const clubs = JSON.parse(clubsJSON);

    const map = L.map('map', {
      zoomControl: true,
    }).setView([54.5, -3.5], 6);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 18,
    }).addTo(map);

    const markers = L.markerClusterGroup({
      maxClusterRadius: 50,
      spiderfyOnMaxZoom: true,
      showCoverageOnHover: false,
      iconCreateFunction: function(cluster) {
        const count = cluster.getChildCount();
        let size = 'small';
        if (count >= 50) size = 'large';
        else if (count >= 10) size = 'medium';

        const sizes = { small: 30, medium: 40, large: 50 };
        const px = sizes[size];

        return L.divIcon({
          html: '<div style="background:rgba(0,255,144,0.85);color:#0f172a;border-radius:50%;width:' + px + 'px;height:' + px + 'px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:' + (size === 'large' ? '14' : '12') + 'px;border:2px solid rgba(0,255,144,0.4);box-shadow:0 2px 8px rgba(0,0,0,0.3);">' + count + '</div>',
          className: '',
          iconSize: L.point(px, px),
        });
      },
    });

    const allMarkerLayers = [];

    clubs.forEach(function(club) {
      const regionSlug = club.region.toLowerCase().replace(/ /g, '-');
      const marker = L.circleMarker([club.lat, club.lng], {
        radius: 7,
        fillColor: '#00ff90',
        color: '#00ff90',
        weight: 1,
        opacity: 0.8,
        fillOpacity: 0.6,
      });

      marker.bindPopup(
        '<div style="font-family:Inter,sans-serif;min-width:180px;">' +
          '<strong style="font-size:14px;color:#1e293b;">' + club.name + '</strong>' +
          '<p style="margin:4px 0 0;font-size:12px;color:#64748b;">' + club.location + ', ' + club.region + '</p>' +
          (club.venue ? '<p style="margin:2px 0 0;font-size:11px;color:#94a3b8;">' + club.venue + '</p>' : '') +
          '<a href="/clubs/' + regionSlug + '/' + club.slug + '/" style="display:inline-block;margin-top:8px;font-size:12px;color:#297373;font-weight:600;text-decoration:none;">View club details &rarr;</a>' +
        '</div>'
      );

      marker._clubRegion = club.region;
      allMarkerLayers.push(marker);
      markers.addLayer(marker);
    });

    map.addLayer(markers);

    // Region filter
    var regionFilter = document.getElementById('regionFilter');
    var clubCount = document.getElementById('clubCount');

    regionFilter.addEventListener('change', function() {
      var selectedRegion = regionFilter.value;
      markers.clearLayers();
      var count = 0;

      allMarkerLayers.forEach(function(marker) {
        if (!selectedRegion || marker._clubRegion === selectedRegion) {
          markers.addLayer(marker);
          count++;
        }
      });

      clubCount.textContent = 'Showing ' + count + ' of ' + totalClubs + ' clubs';

      if (selectedRegion && count > 0) {
        var group = new L.featureGroup(allMarkerLayers.filter(function(m) {
          return m._clubRegion === selectedRegion;
        }));
        map.fitBounds(group.getBounds().pad(0.2));
      } else {
        map.setView([54.5, -3.5], 6);
      }
    });
  </script>
</Layout>
