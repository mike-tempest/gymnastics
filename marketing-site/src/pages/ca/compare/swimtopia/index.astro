---
import Layout from "../../../../layouts/Layout.astro";
import Nav from "../../../../components/Nav.astro";
import Footer from "../../../../components/Footer.astro";
import { REGIONS } from "../../../../config/regions";
import { ArrowRight, DollarSign, Smartphone, ShieldCheck, Users } from "@lucide/astro";

const SITE = "https://swimly.club";
const appUrl = REGIONS.ca.appUrl;
const title = "Swimly vs SwimTopia | Swim Club Software in Canada";
const description =
  "Compare Swimly and SwimTopia for Canadian swim clubs. Focused year-round club administration with transparent CAD pricing versus a mature meet-running and team-website platform.";
const canonical = `${SITE}/ca/compare/swimtopia/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/ca/` },
    { "@type": "ListItem", position: 2, name: "Swimly vs SwimTopia", item: `${SITE}/ca/compare/swimtopia/` },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How does Swimly compare to SwimTopia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Swimly is a focused platform for everyday club administration, with membership, recurring payments in Canadian dollars, attendance and safeguarding records. SwimTopia is a mature, well-regarded platform known for running swim meets through its Meet Maestro tool, alongside team websites, online registration and fundraising. The two overlap on registration and communication, but emphasise different things: Swimly on year-round club operations, SwimTopia on meets and team-site features.",
      },
    },
    {
      "@type": "Question",
      name: "Which is better value for a Canadian club?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It depends on how your club is structured. SwimTopia commonly prices per athlete, which can suit seasonal teams. Swimly uses a flat monthly rate in Canadian dollars per tier with a free plan for small clubs, which can be easier to predict for a year-round club as it grows. Compare both against your own member count and season length.",
      },
    },
    {
      "@type": "Question",
      name: "Does Swimly run swim meets like SwimTopia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Not yet. SwimTopia's Meet Maestro is a mature tool for running meets on the pool deck. Swimly's competition features are still being built, so if running meets is central to your club today, SwimTopia is the stronger choice for that specific need.",
      },
    },
    {
      "@type": "Question",
      name: "Can I move from SwimTopia to Swimly?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Swimly's onboarding includes importing your member data from a spreadsheet or export. If your club depends on meet running or team-website features, check what you would keep and what is still in development with our team before switching.",
      },
    },
  ],
};


const rows = [
  ["Focus", "Year-round, everyday club administration", "Swim meets, team websites and registration"],
  ["Membership management", "Member database with family grouping and squads", "Online registration and member records"],
  ["Payment collection", "Recurring card and bank payments in CAD, automated", "Online payment collection for registration and store"],
  ["Attendance", "Quick poolside check-in on mobile", "Attendance and sign-ups"],
  ["Safeguarding records", "Screening and certification tracking with reminders", "Not a primary focus"],
  ["Meet management", "Competition features in development", "Mature meet running via Meet Maestro"],
  ["Team website and store", "Not a primary focus", "Custom team websites, online store and fundraising"],
  ["Pricing model", "Flat monthly rate in CAD, free plan for small clubs", "Commonly priced per athlete"],
];
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Nav />

  <main class="pt-24 pb-16">
    <!-- Hero -->
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <p class="eyebrow mb-6">Platform comparison</p>
        <h1 class="font-display text-4xl sm:text-5xl text-[#0F2D2D] mb-6">
          Swimly vs SwimTopia
        </h1>
        <p class="text-xl text-ink-soft max-w-3xl">
          SwimTopia is a mature, well-regarded platform best known for running
          swim meets through its Meet Maestro tool, alongside team websites,
          online registration and fundraising. Swimly takes a different focus:
          year-round, everyday club administration with recurring payments in
          Canadian dollars. Both are good at what they emphasise.
        </p>

        <div class="grid grid-cols-3 gap-4 mt-10">
          <div class="bg-[#85FFC7]/10 border border-[#1F7A52]/20 rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">CAD</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">flat-rate pricing</p>
          </div>
          <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">Year</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">round admin</p>
          </div>
          <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">Mobile</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">first, poolside</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Positioning -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="bg-[#85FFC7]/15 rounded-2xl border border-[#1F7A52]/20 p-8 sm:p-10">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-4">Different strengths</h2>
        <p class="text-ink-soft mb-4">
          SwimTopia has a strong reputation for the meet-day experience and for
          giving teams a polished website, online store and fundraising tools. If
          running meets and presenting your team online are central to your club,
          those are real strengths.
        </p>
        <p class="text-ink-soft">
          Swimly concentrates on the administration that happens every week of the
          year: membership, recurring CAD payments, attendance and safeguarding
          records, with predictable flat-rate pricing. The two can be considered
          for different priorities rather than as direct like-for-like.
        </p>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-8">At a glance</h2>
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[#39393A]/8 bg-surface">
              <th class="text-left p-3 sm:p-6 text-[#0F2D2D] font-semibold">Area</th>
              <th class="text-left p-3 sm:p-6 text-mint-ink font-semibold bg-[#85FFC7]/10">Swimly</th>
              <th class="text-left p-3 sm:p-6 text-[#0F2D2D] font-medium">SwimTopia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#39393A]/8">
            {rows.map((r) => (
              <tr>
                <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">{r[0]}</td>
                <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">{r[1]}</td>
                <td class="p-3 sm:p-6 text-ink-soft">{r[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-ink-faint mt-4">
        Based on publicly available information about each platform. Product
        details and pricing models can change over time, so check each provider's
        current site before deciding.
      </p>
    </section>

    <!-- Where Swimly fits -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-4 text-center">Where Swimly fits best</h2>
      <p class="text-ink-soft text-center mb-12 max-w-2xl mx-auto">Four reasons a year-round Canadian club might choose Swimly.</p>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
            <DollarSign class="w-5 h-5 text-mint-ink" />
          </div>
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Predictable CAD pricing</h3>
          <p class="text-sm text-ink-soft leading-relaxed">A flat monthly rate per tier in Canadian dollars, rather than a per-athlete charge, can be easier to budget for a year-round club as membership changes.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
            <ShieldCheck class="w-5 h-5 text-mint-ink" />
          </div>
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Safeguarding records built in</h3>
          <p class="text-sm text-ink-soft leading-relaxed">Track screening checks, certifications and consent forms with expiry reminders, so the records your safe-sport obligations depend on stay current.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
            <Smartphone class="w-5 h-5 text-mint-ink" />
          </div>
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Recurring payments, not chasing</h3>
          <p class="text-sm text-ink-soft leading-relaxed">Collect monthly, term or seasonal fees automatically by recurring card or bank payment, instead of reconciling e-transfers by hand.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
            <Users class="w-5 h-5 text-mint-ink" />
          </div>
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Focused and quick to learn</h3>
          <p class="text-sm text-ink-soft leading-relaxed">Swimly stays focused on everyday club administration, so a volunteer committee can get up and running without a steep learning curve.</p>
        </div>
      </div>
    </section>

    <!-- When SwimTopia is better -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-8">When SwimTopia may be the better choice</h2>
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8">
        <p class="text-ink-soft mb-4">We believe in being honest. SwimTopia may suit your club better if:</p>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex gap-3">
            <span class="text-ink-faint">&bull;</span>
            <span>Running swim meets is central to your club, where SwimTopia's Meet Maestro is a mature, proven tool.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-ink-faint">&bull;</span>
            <span>You want a polished team website, online store and fundraising tools as part of the same platform.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-ink-faint">&bull;</span>
            <span>You run a seasonal team where a per-athlete pricing model fits your numbers well.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-6">See whether Swimly fits your club</h2>
      <p class="text-xl text-ink-soft mb-8 max-w-xl mx-auto">Create your club today. Free for small clubs, no card required.</p>
      <a
        href={`${appUrl}/create-club`}
        class="inline-flex items-center justify-center gap-2 text-lg font-bold px-8 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.6)]"
      >
        Start your club, free
        <ArrowRight class="w-5 h-5" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>
