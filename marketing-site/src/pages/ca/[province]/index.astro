---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import provinces from '../../../data/ca-provinces.json';
import cities from '../../../data/ca-cities.json';

export async function getStaticPaths() {
  return Object.entries(provinces).map(([slug, data]) => ({
    params: { province: slug },
    props: { provinceData: data },
  }));
}

const { provinceData } = Astro.props;
const { province } = Astro.params;
const { name, abbr } = provinceData;

// Drive the city list from ca-cities.json so every link resolves to a real page.
const provinceCities = cities
  .filter((c) => c.provinceSlug === province)
  .sort((a, b) => a.name.localeCompare(b.name));

const cityCount = provinceCities.length;
const sizeTier: 'large' | 'medium' | 'small' = cityCount >= 8 ? 'large' : cityCount >= 4 ? 'medium' : 'small';

const SITE = 'https://swimly.club';
const canonical = `${SITE}/ca/${province}/`;
const appUrl = 'https://app.swimly.uk/create-club';

const pageTitle = `Swimming Club Management Software in ${name} | Swimly`;
const metaDescription = `Swimming club management software for clubs across ${name} (${abbr}). Swimly handles registration, fees, attendance, and parent communication in one organised place.`;

const introByTier = {
  large: `${name} is one of Canada's busiest provinces for community swimming, with clubs running learn-to-swim programmes, age-group squads, and masters training across its cities. Swimly gives every committee a single, calm place to manage members, collect fees, and track attendance.`,
  medium: `Swimming clubs across ${name} balance pool time, volunteer rotas, and growing membership lists, often on top of full-time jobs. Swimly takes the admin off their hands so coaches and committees can focus on the swimmers, not the spreadsheets.`,
  small: `Community swimming is a close-knit affair in ${name}, where a handful of dedicated clubs keep the lanes full. Swimly is built for clubs of every size, giving small and growing programmes the same organised tools the larger ones rely on.`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Canada', item: `${SITE}/ca/` },
    { '@type': 'ListItem', position: 2, name: name, item: canonical },
  ],
};

const features = [
  {
    title: 'Member registration',
    body: 'Online sign-up and renewals with every swimmer, parent, and coach kept in one organised record.',
  },
  {
    title: 'Fee collection',
    body: 'Automated membership and session billing in Canadian dollars, with clear records for your treasurer.',
  },
  {
    title: 'Attendance tracking',
    body: 'Poolside check-in so coaches always know who is in the water, who is late, and who is away.',
  },
  {
    title: 'Session planning',
    body: 'Schedule squad sessions and galas, set capacities, and let families see what is on at a glance.',
  },
  {
    title: 'Parent portal',
    body: 'Parents view schedules, invoices, and club updates from any device, cutting down on email back-and-forth.',
  },
  {
    title: 'Built for Canadian clubs',
    body: 'Canadian spelling, dollar pricing, and workflows that suit clubs affiliated with Swimming Canada and their provincial sections.',
  },
];
---

<Layout title={pageTitle} description={metaDescription} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />

  <main class="pt-24">
    <!-- Hero Section -->
    <section class="relative py-20 px-4 overflow-hidden">
      <div class="dot-grid absolute inset-x-0 top-0 h-[500px] pointer-events-none"></div>
      <div class="relative max-w-4xl mx-auto text-center">
        <nav class="mb-6" aria-label="Breadcrumb">
          <ol class="flex items-center justify-center gap-2 text-sm text-ink-mute">
            <li><a href="/ca/" class="hover:text-mint-ink transition-colors">Canada</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-[#0F2D2D]">{name}</li>
          </ol>
        </nav>
        <h1 class="font-display text-4xl md:text-5xl text-[#0F2D2D] mb-6">
          Swimming Club Management Software in <em class="text-mint-ink">{name}</em>
        </h1>
        <p class="text-xl text-ink-soft mb-8 max-w-2xl mx-auto">
          The complete management platform for swimming clubs across {name}.
          Organise membership, fees, sessions, and attendance in one calm place.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href={appUrl} class="px-6 py-3 min-h-12 inline-flex items-center bg-lime-cta text-[#0F2D2D] rounded-lg font-semibold hover:bg-lime-cta-hover transition-colors">
            Start your club, free
          </a>
          <a href="/#features" class="px-6 py-3 min-h-12 inline-flex items-center border border-[#297373]/40 text-ink rounded-lg font-semibold hover:bg-surface transition-colors">
            See features
          </a>
        </div>
      </div>
    </section>

    <!-- Intro / Context -->
    <section class="py-12 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-ink-soft leading-relaxed text-lg">
          {introByTier[sizeTier]}
        </p>
      </div>
    </section>

    <!-- Cities Section -->
    {provinceCities.length > 0 && (
      <section class="py-16 px-4 bg-surface border-y border-[#39393A]/8">
        <div class="max-w-6xl mx-auto">
          <h2 class="font-display text-3xl text-[#0F2D2D] text-center mb-4">Swimming Club Software by City in {name}</h2>
          <p class="text-ink-soft text-center mb-12 max-w-2xl mx-auto">
            Choose a city to see how Swimly supports clubs in your part of {name}.
          </p>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {provinceCities.map((city) => (
              <a href={`/ca/${province}/${city.slug}/`} class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-lg p-4 hover:border-[#297373]/30 transition-colors group">
                <h3 class="text-[#0F2D2D] font-medium group-hover:text-mint-ink transition-colors">{city.name}</h3>
                <p class="text-ink-mute text-sm">{name}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Features Section -->
    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-display text-3xl text-[#0F2D2D] text-center mb-12">Why {name} Clubs Choose Swimly</h2>

        <div class="grid md:grid-cols-3 gap-6">
          {features.map((feature) => (
            <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-6">
              <h3 class="text-[#0F2D2D] font-semibold mb-2">{feature.title}</h3>
              <p class="text-ink-soft text-sm">{feature.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-4">
      <div class="max-w-3xl mx-auto text-center bg-[#85FFC7]/15 border border-[#1F7A52]/20 rounded-2xl p-12">
        <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">Ready to Organise Your {name} Club?</h2>
        <p class="text-ink-soft mb-8">
          Set up your club in minutes and give your committee, coaches, and families a calmer way to run the season.
        </p>
        <a href={appUrl} class="inline-flex items-center px-8 py-4 min-h-12 bg-lime-cta text-[#0F2D2D] rounded-lg font-semibold hover:bg-lime-cta-hover transition-colors">
          Start your club, free
        </a>
        <p class="text-ink-mute text-sm mt-4">Free for clubs under 50 members</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
