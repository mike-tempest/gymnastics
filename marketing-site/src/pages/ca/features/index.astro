---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import ProductTour from "../../../components/ProductTour.astro";
import { REGIONS } from "../../../config/regions";
import {
  ArrowRight,
  Users,
  CreditCard,
  CalendarCheck,
  ShieldCheck,
  Bell,
  BarChart3,
  Check,
} from "@lucide/astro";

const SITE = "https://swimly.club";
const appUrl = REGIONS.ca.appUrl;
const title = "Swim Club Software Features | Swimly Canada";
const description =
  "Membership, billing in CAD, attendance registers, safeguarding records and reporting. See every feature Swimly offers Canadian swimming clubs.";
const canonical = `${SITE}/ca/features/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/ca/` },
    { "@type": "ListItem", position: 2, name: "Features", item: `${SITE}/ca/features/` },
  ],
};


const sections = [
  {
    id: "membership",
    icon: Users,
    title: "Membership management",
    intro:
      "A simple, modern member database that parents can update themselves. No more chasing paper forms or maintaining spreadsheets.",
    points: [
      ["Online registration", "Parents sign up through a web form. No printable PDFs or scanning."],
      ["Family grouping", "Link siblings together for billing and communication. One invoice per family."],
      ["Self-service portal", "Parents update contact details, emergency contacts and medical information themselves."],
      ["Squad assignments", "Organise members into training groups and move swimmers between squads as they progress."],
      ["Custom fields", "Track swimming levels, medical conditions or any club-specific data."],
    ],
  },
  {
    id: "billing",
    icon: CreditCard,
    title: "Billing and payments in CAD",
    intro:
      "Collect club fees automatically in Canadian dollars by recurring card or pre-authorised bank payment. No more chasing e-transfers or reconciling them by hand.",
    points: [
      ["Recurring payments", "Collect monthly, term or seasonal fees automatically from members."],
      ["Flexible schedules", "Set different fee amounts for different squads or membership types."],
      ["Automatic retries", "Failed payments are retried automatically and parents are notified if action is needed."],
      ["Invoice generation", "Automatic invoices are sent to parents and stored in their portal for download."],
      ["Payment tracking", "See which members are paid up and who has an outstanding balance at a glance."],
    ],
  },
  {
    id: "attendance",
    icon: CalendarCheck,
    title: "Session scheduling and attendance",
    intro:
      "Manage your pool time, assign swimmers to lanes, and track who is attending. Members see their upcoming sessions; coaches see their rotas.",
    points: [
      ["Visual lane planner", "Assign squads to lanes and see your pool layout at a glance."],
      ["Recurring templates", "Set up your weekly schedule once, then repeat it automatically."],
      ["Quick check-in", "Mark attendance with a tap and see who is present at each session."],
      ["Coaching rotas", "Assign coaches to sessions and track who is covering each group."],
      ["Session changes", "Cancel or reschedule a session and automatically notify affected members."],
    ],
  },
  {
    id: "safeguarding",
    icon: ShieldCheck,
    title: "Safeguarding and compliance",
    intro:
      "Track screening checks, coaching certifications and consent forms so the records your club's safe-sport obligations depend on are always to hand.",
    points: [
      ["Screening records", "Record screening check references and expiry dates for coaches and volunteers."],
      ["Certification tracking", "Track coaching certifications, first aid and lifeguard credentials in one place."],
      ["Expiry reminders", "Automatic reminders well before certificates and checks expire."],
      ["Consent forms", "Digital consent for photography, medical treatment and data processing."],
      ["Compliance overview", "See at a glance which coaches need renewals or which members lack consent."],
    ],
  },
  {
    id: "communication",
    icon: Bell,
    title: "Notifications and communication",
    intro:
      "Keep members informed without relying on group chats. Automated reminders and targeted announcements delivered by email.",
    points: [
      ["Session notifications", "Cancel or move a session and affected members are automatically emailed."],
      ["Payment reminders", "Automatic reminders for outstanding balances or upcoming renewals."],
      ["Club announcements", "Send targeted messages to specific squads or the whole club."],
      ["Expiry alerts", "Notify the committee when screening checks or certifications are about to expire."],
      ["Email templates", "Pre-written messages for common situations, ready to send."],
    ],
  },
  {
    id: "reporting",
    icon: BarChart3,
    title: "Financial overview and reporting",
    intro:
      "A real-time financial dashboard showing club income and outstanding payments. Export detailed reports for your AGM without digging through bank statements.",
    points: [
      ["Income dashboard", "See total membership revenue, outstanding payments and collection rates."],
      ["Reconciliation", "Collections are reconciled with member accounts automatically."],
      ["Exportable reports", "Generate CSV or PDF reports for your treasurer, auditor or AGM."],
      ["Competition fees", "Link meet entry fees to member accounts for transparent billing."],
      ["Historical data", "View income trends month by month or year by year for planning."],
    ],
  },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />

  <Nav />

  <main class="pt-24 pb-16">
    <!-- Hero -->
    <section class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[500px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative text-center">
        <p class="eyebrow mb-6">Purpose-built for Canadian swimming clubs</p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-[#0F2D2D] mb-6 leading-tight">
          Everything your<br class="hidden sm:block" />
          <em class="text-mint-ink">swim club needs</em>
        </h1>
        <p class="text-xl text-ink-soft max-w-2xl mx-auto leading-relaxed">
          Membership, billing, attendance, safeguarding and communication in one
          platform. Built by swim parents who got tired of the spreadsheet chaos.
        </p>
      </div>

      <!-- Quick nav pills -->
      <div class="relative flex flex-wrap justify-center gap-3 mt-10">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors min-h-12 inline-flex items-center">
            {s.title.split(" ")[0]}
          </a>
        ))}
      </div>
    </section>

    <!-- Stats bar -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">6</p>
          <p class="text-sm text-ink-mute mt-1">Core modules</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">Free</p>
          <p class="text-sm text-ink-mute mt-1">For small clubs</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">CAD</p>
          <p class="text-sm text-ink-mute mt-1">Billing and pricing</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">1</p>
          <p class="text-sm text-ink-mute mt-1">Platform, not five tools</p>
        </div>
      </div>
    </section>

    <!-- Feature sections -->
    {sections.map((s) => (
      <section id={s.id} class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center flex-shrink-0">
              <s.icon class="w-6 h-6 text-mint-ink" />
            </div>
            <div>
              <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">{s.title}</h2>
              <p class="text-ink-soft text-lg">{s.intro}</p>
            </div>
          </div>
          <div class="space-y-4 text-ink-soft">
            {s.points.map((p) => (
              <div class="flex gap-3">
                <Check class="w-5 h-5 text-mint-ink flex-shrink-0 mt-0.5" />
                <span><strong class="text-[#0F2D2D]">{p[0]}</strong>: {p[1]}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <ProductTour region="ca" />

    <!-- Built for every role -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-4">Built for every role</h2>
        <p class="text-ink-soft text-lg max-w-2xl mx-auto">
          Each person in your club sees exactly what they need. No clutter, no
          confusion.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-6 rounded-2xl bg-gradient-to-b from-[#85FFC7]/20 to-transparent border border-[#1F7A52]/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Treasurer</p>
          <p class="text-sm text-ink-soft">Revenue overview, outstanding payments, export reports for the AGM, reconciliation dashboard.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-b from-blue-500/10 to-transparent border border-blue-500/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Registrar</p>
          <p class="text-sm text-ink-soft">Member database, family grouping, squad assignments, registration approvals.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-b from-amber-500/10 to-transparent border border-amber-500/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Coach</p>
          <p class="text-sm text-ink-soft">Poolside attendance, session registers, swimmer profiles, squad rosters on mobile.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-b from-purple-500/10 to-transparent border border-purple-500/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Parent</p>
          <p class="text-sm text-ink-soft">Payment history, upcoming sessions, update contact details, view balances.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-6">Ready to simplify club management?</h2>
      <p class="text-xl text-ink-soft mb-8">Create your club today. Free for small clubs, no card required.</p>
      <a
        href={`${appUrl}/create-club`}
        class="inline-flex items-center justify-center gap-2 text-lg font-bold px-8 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.6)]"
      >
        Start your club, free
        <ArrowRight class="w-5 h-5" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>
