---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Shield, FileCheck, Bell, Lock, CheckCircle, ArrowRight, ClipboardX, ShieldCheck, Clock, Award, AlertTriangle, Database, Upload, Calendar, Search, X, Users, Eye, Zap, FileWarning } from '@lucide/astro';

const title = 'Wavepower Compliance Software | Swim Clubs';
const description = 'Track DBS checks, manage safeguarding records, and stay Wavepower compliant. Automated reminders for UK swimming clubs. Try Swimly free.';

const complianceSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Swimly Safeguarding Compliance",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": description,
  "url": "https://swimly.uk/features/compliance/",
  "featureList": [
    "DBS certificate tracking",
    "Safeguarding record management",
    "Wavepower compliance dashboard",
    "Automatic renewal reminders",
    "Coaching qualification tracking"
  ],
  "offers": {
    "@type": "Offer",
    "price": "29",
    "priceCurrency": "GBP",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/PreOrder"
  },
  "author": {
    "@type": "Organization",
    "name": "Swimly",
    "url": "https://swimly.uk"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Swimly",
    "url": "https://swimly.uk"
  }
};

const faqItems = [
  {
    question: "What is Wavepower and why does my swim club need to comply?",
    answer: "Wavepower is Swim England's safeguarding policy document. Every affiliated club must follow its requirements, including DBS checks for coaches and volunteers, welfare officer appointments, and incident reporting procedures. Non-compliance can result in loss of affiliation and insurance."
  },
  {
    question: "How does Swimly track DBS certificates?",
    answer: "Swimly stores DBS certificate numbers, issue dates, and expiry dates for every coach, volunteer, and committee member. It automatically sends renewal reminders 3 months before expiry, so your Welfare Officer never has to manually track spreadsheet dates again."
  },
  {
    question: "Can Swimly replace our paper safeguarding records?",
    answer: "Yes. Swimly provides a secure digital record of DBS checks, coaching qualifications, first aid certificates, and safeguarding training. Records are encrypted, access-controlled by role, and easily exported for Swim England audits or SwimMark assessments."
  },
  {
    question: "What qualifications can Swimly track besides DBS?",
    answer: "Swimly tracks coaching qualifications (Level 1, 2, 3), first aid certificates, safeguarding training completion, pool lifeguard qualifications, and any custom certificates your club requires. Each record includes expiry dates and automatic renewal alerts."
  }
];
---

<Layout title={title} description={description} faqItems={faqItems}>
  <script type="application/ld+json" set:html={JSON.stringify(complianceSchema, null, 2)} />
  <Nav />
  <main class="pt-24 pb-16">

    <!-- Hero Section -->
    <section class="relative pt-16 pb-12 overflow-hidden">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#85FFC7]/20 border border-[#1F7A52]/15 text-mint-ink text-sm font-medium mb-6">
          <Shield class="w-4 h-4" />
          Wavepower Compliance
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-[#0F2D2D] leading-tight mb-6">
          Never miss a DBS renewal again
        </h1>

        <p class="text-lg sm:text-xl text-ink-soft max-w-2xl mx-auto leading-relaxed mb-10">
          Automated tracking for DBS checks, safeguarding certificates, and coaching qualifications. Be audit-ready at all times, not just when you know an inspection is coming.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://app.swimly.uk/create-club"
            class="inline-flex items-center gap-2.5 px-8 py-4 min-h-12 rounded-xl bg-lime-cta text-[#0F2D2D] font-bold hover:bg-lime-cta-hover transition-all text-lg shadow-lg shadow-[#FF8552]/20 hover:shadow-[#FF8552]/30 hover:scale-[1.02]"
          >
          Start your club, free
            <ArrowRight class="w-5 h-5" />
          </a>
          <span class="text-sm text-ink-mute">Wavepower aligned, GDPR compliant</span>
        </div>
      </div>
    </section>

    <!-- App Screenshots -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16">
      <div class="rounded-2xl overflow-hidden bg-surface-raised border border-[#39393A]/10 shadow-[0_24px_56px_-24px_rgba(15,45,45,0.3)]">
        <picture>
          <source srcset="/images/app-screenshots/compliance-mobile.png" media="(max-width: 639px)" />
          <source srcset="/images/app-screenshots/compliance-tablet.png" media="(max-width: 1023px)" />
          <img src="/images/app-screenshots/compliance-desktop.png" alt="Swimly compliance dashboard showing DBS checks and safeguarding status" class="w-full h-auto" loading="eager" />
        </picture>
      </div>
      <p class="text-center text-sm text-ink-mute mt-6">Compliance dashboard on desktop, certificate alerts on mobile</p>
    </section>

    <!-- Quick Benefits Strip -->
    <section class="bg-surface border-y border-[#39393A]/8 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mx-auto mb-3">
              <Clock class="w-6 h-6 text-mint-ink" />
            </div>
            <div class="text-lg font-semibold text-[#0F2D2D]">15-Minute Audit Prep</div>
            <p class="text-sm text-ink-soft mt-1">vs days with spreadsheets</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mx-auto mb-3">
              <Bell class="w-6 h-6 text-mint-ink" />
            </div>
            <div class="text-lg font-semibold text-[#0F2D2D]">90-Day Alerts</div>
            <p class="text-sm text-ink-soft mt-1">Reminders before anything expires</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mx-auto mb-3">
              <ShieldCheck class="w-6 h-6 text-mint-ink" />
            </div>
            <div class="text-lg font-semibold text-[#0F2D2D]">Wavepower Aligned</div>
            <p class="text-sm text-ink-soft mt-1">Built to SE safeguarding standards</p>
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mx-auto mb-3">
              <Lock class="w-6 h-6 text-mint-ink" />
            </div>
            <div class="text-lg font-semibold text-[#0F2D2D]">GDPR Compliant</div>
            <p class="text-sm text-ink-soft mt-1">Encrypted, access-controlled</p>
          </div>
        </div>
      </div>
    </section>

    <!-- The Problem Section -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B91C1C]/10 border border-[#B91C1C]/20 text-[#B91C1C] text-xs font-medium mb-4">
          <AlertTriangle class="w-3.5 h-3.5" />
          The Risk
        </div>
        <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-4">One missed renewal puts your club at risk</h2>
        <p class="text-ink-soft max-w-2xl mx-auto">Non-compliance with Wavepower can mean loss of Swim England affiliation, invalidated insurance, and personal liability for committee members. Most clubs track this in spreadsheets. Some don't track it at all.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <div class="w-10 h-10 rounded-lg bg-[#B91C1C]/10 flex items-center justify-center mb-4">
            <FileWarning class="w-5 h-5 text-[#B91C1C]" />
          </div>
          <h3 class="font-semibold mb-2 text-[#B91C1C]">Expired DBS</h3>
          <p class="text-ink-soft text-sm">A coach with an expired DBS can invalidate your club's insurance overnight. One missed date, one major problem.</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <div class="w-10 h-10 rounded-lg bg-amber-500/15 flex items-center justify-center mb-4">
            <ClipboardX class="w-5 h-5 text-amber-600" />
          </div>
          <h3 class="font-semibold mb-2 text-amber-700">Lost records</h3>
          <p class="text-ink-soft text-sm">Paper certificates in filing cabinets. An outgoing Welfare Officer takes the folder home. Sound familiar?</p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
          <div class="w-10 h-10 rounded-lg bg-orange-500/15 flex items-center justify-center mb-4">
            <Search class="w-5 h-5 text-orange-600" />
          </div>
          <h3 class="font-semibold mb-2 text-orange-700">Audit panic</h3>
          <p class="text-ink-soft text-sm">Swim England calls. You have a week to produce every certificate. The spreadsheet hasn't been updated since September.</p>
        </div>
      </div>
    </section>

    <!-- Before/After Comparison Table -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] text-center mb-4">Spreadsheets vs Swimly</h2>
      <p class="text-ink-soft text-center mb-12 max-w-2xl mx-auto">What Swim England auditors look for, and how you can produce it.</p>

      <div class="overflow-x-auto bg-surface-raised border border-[#39393A]/10 rounded-2xl">
        <table class="w-full text-left">
          <thead>
            <tr class="bg-surface border-b border-[#39393A]/8">
              <th class="py-4 px-6 text-[#0F2D2D] font-medium text-sm uppercase tracking-wider">Requirement</th>
              <th class="py-4 px-6 text-[#0F2D2D] font-medium text-sm uppercase tracking-wider">Manual Process</th>
              <th class="py-4 px-6 text-mint-ink font-medium text-sm uppercase tracking-wider">With Swimly</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#39393A]/8">
            <tr>
              <td class="py-4 px-6 font-medium text-[#0F2D2D]">DBS certificates</td>
              <td class="py-4 px-6 text-ink-soft">Filing cabinet, often out of date</td>
              <td class="py-4 px-6 text-ink-soft bg-[#85FFC7]/10">Dashboard with colour-coded expiry status</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-medium text-[#0F2D2D]">Safeguarding training</td>
              <td class="py-4 px-6 text-ink-soft">Email history, paper certificates</td>
              <td class="py-4 px-6 text-ink-soft bg-[#85FFC7]/10">Digital records with completion dates</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-medium text-[#0F2D2D]">Coaching qualifications</td>
              <td class="py-4 px-6 text-ink-soft">Physical certificates, sometimes missing</td>
              <td class="py-4 px-6 text-ink-soft bg-[#85FFC7]/10">Upload once, never lose again</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-medium text-[#0F2D2D]">Consent forms</td>
              <td class="py-4 px-6 text-ink-soft">Paper forms, often incomplete</td>
              <td class="py-4 px-6 text-ink-soft bg-[#85FFC7]/10">Digital forms with e-signature tracking</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-medium text-[#0F2D2D]">Audit trail</td>
              <td class="py-4 px-6 text-ink-soft">None, or manual notes</td>
              <td class="py-4 px-6 text-ink-soft bg-[#85FFC7]/10">Automatic timestamped audit log</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-medium text-[#0F2D2D]">Renewal tracking</td>
              <td class="py-4 px-6 text-ink-soft">Calendar reminders (if you remember to set them)</td>
              <td class="py-4 px-6 text-ink-soft bg-[#85FFC7]/10">Automated alerts at 90, 60, and 30 days</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Feature Deep Dive: DBS Tracking with Screenshot -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B91C1C]/10 border border-[#B91C1C]/20 text-[#B91C1C] text-xs font-medium mb-4">
            Wavepower Required
          </div>
          <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-6">DBS check tracking</h2>
          <p class="text-ink-soft text-lg mb-6">
            Every coach, volunteer, and committee member who works with children needs a valid DBS. Swimly tracks them all in one place with automatic renewal alerts, so your Welfare Officer can sleep at night.
          </p>
          <ul class="space-y-4 text-ink-soft">
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Record certificate numbers, issue dates, and DBS Update Service status</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Automatic alerts 90 days before any DBS renewal is due</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Colour-coded dashboard: green (valid), amber (expiring soon), red (expired)</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Upload scanned certificates for secure digital storage</span>
            </li>
          </ul>
        </div>
        <div class="relative">
          <div class="rounded-2xl overflow-hidden bg-surface-raised border border-[#39393A]/10 shadow-[0_24px_56px_-24px_rgba(15,45,45,0.3)]">
            <picture>
              <source srcset="/images/app-screenshots/compliance-mobile.png" media="(max-width: 639px)" />
              <source srcset="/images/app-screenshots/compliance-tablet.png" media="(max-width: 1023px)" />
              <img
                src="/images/app-screenshots/compliance-desktop.png"
                alt="Swimly compliance dashboard showing DBS check status with colour-coded expiry indicators"
                class="w-full h-auto"
                loading="lazy"
              />
            </picture>
          </div>
          <div class="absolute -bottom-4 -right-4 px-4 py-2 rounded-lg bg-surface-raised border border-[#297373]/30 text-sm text-mint-ink font-medium shadow-[0_8px_24px_-8px_rgba(15,45,45,0.25)] hidden sm:block">
            All certificates, one dashboard
          </div>
        </div>
      </div>
    </section>

    <!-- Feature Deep Dive: Qualification Management with Screenshot -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1 relative">
          <div class="rounded-2xl overflow-hidden bg-surface-raised border border-[#39393A]/10 shadow-[0_24px_56px_-24px_rgba(15,45,45,0.3)]">
            <picture>
              <source srcset="/images/app-screenshots/compliance-mobile.png" media="(max-width: 639px)" />
              <source srcset="/images/app-screenshots/compliance-tablet.png" media="(max-width: 1023px)" />
              <img
                src="/images/app-screenshots/compliance-desktop.png"
                alt="Swimly qualification tracking showing coaching levels, first aid, and safeguarding certificates with expiry dates"
                class="w-full h-auto"
                loading="lazy"
              />
            </picture>
          </div>
          <div class="absolute -top-4 -left-4 px-4 py-2 rounded-lg bg-surface-raised border border-[#297373]/30 text-sm text-mint-ink font-medium shadow-[0_8px_24px_-8px_rgba(15,45,45,0.25)] hidden sm:block">
            Every qualification tracked
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#85FFC7]/20 border border-[#1F7A52]/15 text-mint-ink text-xs font-medium mb-4">
            Qualification Management
          </div>
          <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-6">Every certificate in one place</h2>
          <p class="text-ink-soft text-lg mb-6">
            Coaching levels, first aid, safeguarding training, lifeguard qualifications. Swimly tracks them all with expiry dates and sends reminders before anything lapses.
          </p>
          <ul class="space-y-4 text-ink-soft">
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Track Level 1, 2, and 3 coaching qualifications</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>First aid and pool lifeguard certificates with expiry dates</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>See which coaches are qualified for each session at a glance</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Custom certificate types for anything your club needs</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Two-Column Feature Cards: Consent + Audit -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-8 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.25)] transition-all">
          <div class="w-12 h-12 rounded-xl bg-blue-500/15 flex items-center justify-center mb-5">
            <Users class="w-6 h-6 text-blue-600" />
          </div>
          <h3 class="text-2xl font-semibold text-[#0F2D2D] mb-4">Digital Consent Forms</h3>
          <p class="text-ink-soft mb-4">Parents complete medical, emergency contact, and photography consent online. No more chasing paper forms at the start of term.</p>
          <ul class="space-y-3 text-ink-soft">
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Medical information and allergy records</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Photography and social media consent</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>E-signature tracking with timestamps</span>
            </li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.25)] transition-all">
          <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-5">
            <Eye class="w-6 h-6 text-mint-ink" />
          </div>
          <h3 class="text-2xl font-semibold text-[#0F2D2D] mb-4">Full Audit Trail</h3>
          <p class="text-ink-soft mb-4">Every change is logged. When a Swim England inspector asks "who updated this and when?", you have the answer instantly.</p>
          <ul class="space-y-3 text-ink-soft">
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Timestamped log of every record change</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Export audit reports for SwimMark assessments</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle class="w-5 h-5 text-mint-ink shrink-0 mt-0.5" />
              <span>Role-based access controls (who can see what)</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- How It Works - Visual Flow -->
    <section class="bg-surface border-y border-[#39393A]/8 py-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] text-center mb-4">How compliance management works</h2>
        <p class="text-ink-soft text-center mb-14 max-w-2xl mx-auto">From first upload to audit-ready reports in four simple steps.</p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="relative text-center">
            <div class="w-14 h-14 rounded-full bg-[#85FFC7]/20 border-2 border-[#1F7A52]/30 flex items-center justify-center text-mint-ink font-bold text-xl mx-auto mb-4">1</div>
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Add your team</h3>
            <p class="text-ink-soft text-sm">Create profiles for coaches, volunteers, and committee members. Upload their existing certificates.</p>
            <div class="hidden lg:block absolute top-7 left-[calc(50%+28px)] w-[calc(100%-56px)] h-[2px] bg-gradient-to-r from-[#297373]/30 to-[#297373]/10"></div>
          </div>
          <div class="relative text-center">
            <div class="w-14 h-14 rounded-full bg-[#85FFC7]/20 border-2 border-[#1F7A52]/30 flex items-center justify-center text-mint-ink font-bold text-xl mx-auto mb-4">2</div>
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Set expiry dates</h3>
            <p class="text-ink-soft text-sm">Swimly tracks DBS (3-year), safeguarding (3-year), and coaching qualifications. Alerts are automatic.</p>
            <div class="hidden lg:block absolute top-7 left-[calc(50%+28px)] w-[calc(100%-56px)] h-[2px] bg-gradient-to-r from-[#297373]/30 to-[#297373]/10"></div>
          </div>
          <div class="relative text-center">
            <div class="w-14 h-14 rounded-full bg-[#85FFC7]/20 border-2 border-[#1F7A52]/30 flex items-center justify-center text-mint-ink font-bold text-xl mx-auto mb-4">3</div>
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Collect consent</h3>
            <p class="text-ink-soft text-sm">Digital forms sent to parents automatically. Medical, emergency, and photography consent completed online.</p>
