        <p class="reveal text-center mt-10">
          <a href="/pricing/" class="inline-flex items-center gap-2 text-[#1F7A52] font-medium hover:underline underline-offset-4 group">
            Full pricing and plan details
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
          </a>
        </p>
      </div>
    </section>

    <!-- ───────────────────────── Final CTA + footer ───────────────────────── -->
    <footer class="relative bg-[#0F2D2D] overflow-hidden">
      <div class="lane-divider-mint" aria-hidden="true"></div>
      <div class="absolute left-1/2 top-[-220px] -translate-x-1/2 w-[700px] h-[400px] rounded-full bg-[#85FFC7]/7 blur-[100px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-4xl mx-auto px-5 sm:px-8 pt-20 sm:pt-24 pb-10 text-center">
        <h2 class="reveal font-display text-4xl sm:text-[52px] sm:leading-[1.08] text-[#E6E6E6]">
          Calm replaces chaos in
          <br class="hidden sm:block" />
          about <em class="text-[#85FFC7]">two weeks</em>
        </h2>

        <form id="quick-waitlist" class="reveal mt-10 flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <label for="quick-email" class="sr-only">Email address</label>
          <input
            id="quick-email"
            type="email"
            required
            placeholder="you@yourclub.org.uk"
            class="flex-1 px-5 rounded-xl bg-[#163F3F] border border-[#E6E6E6]/15 text-[#E6E6E6] placeholder-[#E6E6E6]/35 focus:outline-none focus:border-[#85FFC7]/60 focus:ring-2 focus:ring-[#85FFC7]/20 transition-all text-base min-h-14"
          />
          <button
            type="submit"
            id="quick-btn"
            class="px-7 rounded-xl bg-[#FF8552] text-[#0F2D2D] font-bold hover:bg-[#FF6B33] transition-colors text-base min-h-14 whitespace-nowrap"
          >
          Start your club, free
          </button>
        </form>
        <p id="quick-msg" class="mt-4 text-sm text-[#E6E6E6]/45">
          No spam, just launch updates. Unsubscribe any time. <a href="/privacy/" class="underline underline-offset-2 hover:text-[#85FFC7] transition-colors">Privacy</a>
        </p>

        <div class="mt-16 pt-8 border-t border-[#E6E6E6]/10 grid sm:grid-cols-3 gap-8 text-left">
          <div>
            <p class="font-display text-2xl text-[#E6E6E6]">Swimly</p>
            <p class="text-sm text-[#E6E6E6]/45 mt-2 leading-relaxed">Built for the poolside,<br />not the boardroom.</p>
          </div>
          <div class="text-sm">
            <p class="font-semibold text-[#E6E6E6]/80 mb-3">Product</p>
            <ul class="space-y-2 text-[#E6E6E6]/50">
              <li><a href="/features/" class="hover:text-[#85FFC7] transition-colors">Features</a></li>
              <li><a href="/pricing/" class="hover:text-[#85FFC7] transition-colors">Pricing</a></li>
              <li><a href="/founding-clubs/" class="hover:text-[#85FFC7] transition-colors">Founding clubs</a></li>
            </ul>
          </div>
          <div class="text-sm">
            <p class="font-semibold text-[#E6E6E6]/80 mb-3">Resources</p>
            <ul class="space-y-2 text-[#E6E6E6]/50">
              <li><a href="/blog/" class="hover:text-[#85FFC7] transition-colors">Guides</a></li>
              <li><a href="/faq/" class="hover:text-[#85FFC7] transition-colors">FAQ</a></li>
              <li><a href="/contact/" class="hover:text-[#85FFC7] transition-colors">Contact</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-[#E6E6E6]/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-[13px] text-[#E6E6E6]/40">
          <span>&copy; 2026 Swimly</span>
          <div class="flex items-center gap-5">
            <a href="/privacy/" class="hover:text-[#85FFC7] transition-colors">Privacy</a>
            <a href="/terms/" class="hover:text-[#85FFC7] transition-colors">Terms</a>
            <a href="mailto:hello@swimly.uk" class="hover:text-[#85FFC7] transition-colors">hello@swimly.uk</a>
          </div>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<style>
  .font-display,
  .page :global(h1),
  .page :global(h2),
  .page em {
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
  }

  .page h1,
  .page h2 {
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
  }

  .page em {
    font-style: italic;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #297373;
  }

  .eyebrow-light {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #85ffc7;
  }

  /* Pool-tile dot grid, fading downward */
  .dot-grid {
    background-image: radial-gradient(#297373 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.07;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 85%);
    mask-image: linear-gradient(to bottom, black 0%, transparent 85%);
  }

  /* Soft mint wash behind the headline */
  .hero-wash {
    background: radial-gradient(closest-side, rgba(133, 255, 199, 0.32), transparent 70%);
    filter: blur(60px);
  }

  /* Lane-rope divider: long dashes like a swimming lane line */
  .lane-divider {
    height: 2px;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(41, 115, 115, 0.28) 0 28px,
      transparent 28px 44px
    );
    border-radius: 1px;
  }

  .lane-divider-mint {
    height: 2px;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(133, 255, 199, 0.35) 0 28px,
      transparent 28px 44px
    );
  }

  /* Concentric ripple rings: three crisp 1px outlines */
  .ripple {
    border-radius: 9999px;
    border: 1px solid rgba(133, 255, 199, 0.22);
    pointer-events: none;
  }
  .ripple::before,
  .ripple::after {
    content: "";
    position: absolute;
    border-radius: 9999px;
  }
  .ripple::before {
    inset: 34px;
    border: 1px solid rgba(133, 255, 199, 0.15);
  }
  .ripple::after {
    inset: 68px;
    border: 1px solid rgba(133, 255, 199, 0.09);
  }

  /* Register tick marks in the hero vignette */
  .reg-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: rgba(133, 255, 199, 0.45);
    color: #1f7a52;
  }

  /* Mint highlight behind the "after" numeral */
  .result-mark {
    color: #1f7a52;
    background: linear-gradient(transparent 58%, rgba(133, 255, 199, 0.5) 58%);
    padding: 0 0.08em;
    border-radius: 2px;
  }

  /* Slight opposing tilts on the dark-band screenshots */
  .screen-tilt-l { transform: rotate(-1deg); }
  .screen-tilt-r { transform: rotate(1.25deg); }

  /* Floating vignettes */
  @keyframes float-y {
    from { transform: translateY(-6px); }
    to { transform: translateY(6px); }
  }
  .float-a { animation: float-y 5.5s ease-in-out infinite alternate; }
  .float-b { animation: float-y 7s ease-in-out infinite alternate-reverse; }
  .float-c { animation: float-y 6.2s ease-in-out infinite alternate; animation-delay: 0.8s; }

  /* Scroll reveal (only when JS is present) */
  :global(html.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(html.js-reveal) .reveal.in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .float-a, .float-b, .float-c { animation: none; }
    :global(html.js-reveal) .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Scroll reveal with stagger, gated behind a class so no-JS visitors see everything
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js-reveal");
    const els = Array.from(document.querySelectorAll(".reveal"));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const siblings = els.filter(
              (s) => s.parentElement === el.parentElement && !s.classList.contains("in")
            );
            const delay = Math.min(siblings.indexOf(el) * 70, 280);
            setTimeout(() => el.classList.add("in"), Math.max(delay, 0));
            io.unobserve(el);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
    );
    els.forEach((el) => io.observe(el));
  }

  // Quick waitlist capture
  const API_URL = "https://membership-api-production-3628.up.railway.app";
  const qForm = document.getElementById("quick-waitlist") as HTMLFormElement | null;
  const qBtn = document.getElementById("quick-btn") as HTMLButtonElement | null;
  const qMsg = document.getElementById("quick-msg") as HTMLParagraphElement | null;

  qForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = (document.getElementById("quick-email") as HTMLInputElement)?.value;
    if (!email || !qBtn || !qMsg) return;
    qBtn.disabled = true;
    qBtn.textContent = "Joining...";
    try {
      const res = await fetch(`${API_URL}/api/waitlist`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, source: "home-light" }),
      });
      if (!res.ok) throw new Error("failed");
      qBtn.textContent = "Joined";
      qMsg.textContent = "You're on the list. We'll be in touch soon.";
      qForm.reset();
    } catch {
      qBtn.disabled = false;
      qBtn.textContent = "Join the waitlist";
      qMsg.textContent = "Something went wrong. Please try again or email hello@swimly.uk.";
    }
  });
</script>
