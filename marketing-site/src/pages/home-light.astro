---
// Homepage redesign concept in the product's design language.
// DM Serif Display + Inter, canvas #E6E6E6, graphite text, deep teal,
// mint and coral accents. Noindexed and not linked from navigation.
import Layout from "../layouts/Layout.astro";
import { ArrowRight, Check, X, Shield, Lock, Server, ShieldCheck, CircleCheck } from "@lucide/astro";

const trust = [
  { icon: Shield, label: "Swim England compatible" },
  { icon: Lock, label: "GDPR compliant" },
  { icon: Server, label: "UK hosted" },
  { icon: ShieldCheck, label: "256-bit encryption" },
];

const pains = [
  {
    n: "01",
    title: "Five spreadsheets, and none of them agree",
    desc: "Members in one, payments in another, attendance on paper. Nobody knows which version is current.",
  },
  {
    n: "02",
    title: "Evenings lost to chasing subs",
    desc: "Standing orders fail quietly. The Treasurer ends up sending awkward reminders at ten o'clock at night.",
  },
  {
    n: "03",
    title: "Safeguarding records nobody can reach",
    desc: "Wavepower compliance you cannot evidence quickly is compliance you cannot evidence at all.",
  },
  {
    n: "04",
    title: "Handover means starting again",
    desc: "When the Membership Secretary steps down, the club's knowledge walks out of the door with them.",
  },
];

const before = [
  "Membership records scattered across spreadsheets",
  "Chasing parents for subs every month on WhatsApp",
  "Registers printed, filled in by hand, then lost",
  "Safeguarding files in a folder nobody can access",
];

const after = [
  "Every member, payment and session in one place",
  "Direct Debit collects itself, failures retry automatically",
  "Live registers on the phone the coach already carries",
  "Wavepower-aligned records with DBS expiry alerts",
];

const roles = [
  {
    from: "10h",
    to: "2h",
    unit: "per week",
    role: "Membership Secretary",
    desc: "Parents keep their own details current in the portal. Welcome emails and renewal reminders send themselves.",
  },
  {
    from: "6h",
    to: "30m",
    unit: "per week",
    role: "Treasurer",
    desc: "Subs arrive on schedule, failed payments retry on their own, and the AGM report generates in one click.",
  },
  {
    from: "Paper",
    to: "Phone",
    unit: "registers",
    role: "Head Coach",
    desc: "Attendance taken poolside in seconds, even at six in the morning with wet hands and bad lighting.",
  },
];

const tiers = [
  {
    name: "Starter",
    price: "Free",
    members: "Up to 50 members",
    features: ["Membership management", "Attendance registers", "Session scheduling"],
    highlight: false,
  },
  {
    name: "Club",
    price: "£29",
    period: "/mo",
    members: "50 to 200 members",
    features: ["Everything in Starter", "Automated Direct Debit", "Parent portal"],
    highlight: true,
  },
  {
    name: "Performance",
    price: "£49",
    period: "/mo",
    members: "200 to 500 members",
    features: ["Everything in Club", "Performance analytics", "Swim England integration"],
    highlight: false,
  },
];
---

<Layout title="Homepage concept (light) | Swimly" description="Design concept for the Swimly marketing site." noindex={true}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />

  <div class="page bg-[#E6E6E6] text-[#39393A] min-h-screen antialiased overflow-x-clip">

    <!-- ───────────────────────── Nav ───────────────────────── -->
    <nav class="sticky top-0 z-50 bg-[#E6E6E6]/85 backdrop-blur-xl border-b border-[#39393A]/10">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="flex items-center justify-between h-[68px]">
          <a href="/home-light/" class="font-display text-[26px] text-[#0F2D2D] tracking-tight">Swimly</a>
          <div class="hidden md:flex items-center gap-7 text-[15px] text-[#4D4D4D]">
            <a href="/features/" class="hover:text-[#0F2D2D] transition-colors">Product</a>
            <a href="/pricing/" class="hover:text-[#0F2D2D] transition-colors">Pricing</a>
            <a href="/blog/" class="hover:text-[#0F2D2D] transition-colors">Guides</a>
            <a href="/about/" class="hover:text-[#0F2D2D] transition-colors">About</a>
          </div>
          <a
            href="/founding-clubs/"
            class="inline-flex items-center text-[15px] font-bold px-5 rounded-xl bg-[#FF8552] text-[#0F2D2D] hover:bg-[#FF6B33] transition-colors min-h-12 shadow-[0_1px_3px_rgba(57,57,58,0.16)]"
          >
            Become a founding club
          </a>
        </div>
      </div>
    </nav>

    <!-- ───────────────────────── Hero ───────────────────────── -->
    <header class="relative pt-20 sm:pt-28 pb-10 overflow-hidden">
      <div class="dot-grid absolute inset-x-0 top-0 h-[640px] pointer-events-none" aria-hidden="true"></div>
      <div class="hero-wash absolute left-1/2 top-[-180px] -translate-x-1/2 w-[900px] h-[520px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-4xl mx-auto px-5 sm:px-8 text-center">
        <p class="eyebrow reveal">The operating system for British swimming clubs</p>

        <h1 class="reveal font-display text-[44px] leading-[1.06] sm:text-6xl lg:text-[72px] sm:leading-[1.04] text-[#0F2D2D] mt-6 tracking-[-0.01em]">
          Give your committee back
          <br class="hidden sm:block" />
          <em class="text-[#1F7A52]">hours</em> every week
        </h1>

        <p class="reveal mt-7 text-[17px] sm:text-xl text-[#4D4D4D] max-w-2xl mx-auto leading-relaxed">
          Membership, billing, attendance and Wavepower compliance in one calm,
          organised place. Built by a swim parent who has chased the subs and
          printed the registers.
        </p>

        <div class="reveal mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/founding-clubs/"
            class="group inline-flex items-center justify-center gap-2.5 px-8 rounded-xl bg-[#FF8552] text-[#0F2D2D] font-bold hover:bg-[#FF6B33] transition-all text-lg min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.7)] hover:shadow-[0_10px_28px_-8px_rgba(255,107,51,0.8)] hover:-translate-y-px w-full sm:w-auto"
          >
            Become a founding club
            <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a
            href="#product"
            class="inline-flex items-center justify-center gap-2 px-7 rounded-xl border border-[#39393A]/20 bg-[#F0F0F0]/60 text-[#39393A] hover:border-[#297373]/50 hover:bg-[#F0F0F0] transition-colors text-lg min-h-14 w-full sm:w-auto"
          >
            See the product
          </a>
        </div>

        <p class="reveal mt-6 text-sm text-[#666666]">
          6 months free on any plan and white-glove migration for the first 10 clubs.
        </p>
      </div>

      <!-- Product frame with floating vignettes -->
      <div id="product" class="relative max-w-5xl mx-auto px-5 sm:px-8 mt-16 sm:mt-20">
        <div class="reveal relative">
          <!-- Vignette: poolside register -->
          <div class="vignette float-a hidden lg:block absolute -left-10 -top-10 w-[230px] z-10">
            <div class="rounded-2xl bg-[#FAFAF8] border border-[#39393A]/10 shadow-[0_16px_40px_-12px_rgba(15,45,45,0.35)] p-4">
              <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-[#666666]">Saturday · 6:00am</p>
              <p class="text-[13px] font-semibold text-[#0F2D2D] mt-0.5 mb-2.5">Juniors A register</p>
              <ul class="space-y-1.5">
                <li class="flex items-center justify-between text-[13px] text-[#39393A]">
                  Ella P
                  <span class="reg-check"><Check class="w-3 h-3" /></span>
                </li>
                <li class="flex items-center justify-between text-[13px] text-[#39393A]">
                  Noah W
                  <span class="reg-check"><Check class="w-3 h-3" /></span>
                </li>
                <li class="flex items-center justify-between text-[13px] text-[#39393A]">
                  Amira K
                  <span class="reg-check"><Check class="w-3 h-3" /></span>
                </li>
              </ul>
              <p class="text-[11px] text-[#666666] mt-2.5 pt-2.5 border-t border-[#39393A]/8">14 of 16 marked present</p>
            </div>
          </div>

          <!-- Vignette: payment collected -->
          <div class="vignette float-b hidden lg:block absolute -right-12 top-16 w-[250px] z-10">
            <div class="rounded-2xl bg-[#FAFAF8] border border-[#39393A]/10 shadow-[0_16px_40px_-12px_rgba(15,45,45,0.35)] p-4 flex items-start gap-3">
              <span class="shrink-0 w-8 h-8 rounded-full bg-[#85FFC7]/40 border border-[#1F7A52]/20 flex items-center justify-center">
                <Check class="w-4 h-4 text-[#1F7A52]" />
              </span>
              <div class="min-w-0">
                <p class="text-[13px] font-semibold text-[#0F2D2D]">Direct Debit collected</p>
                <p class="text-[13px] text-[#4D4D4D] mt-0.5">Harper family · £58.00</p>
                <p class="text-[11px] text-[#666666] mt-1">Just now</p>
              </div>
            </div>
          </div>

          <!-- Vignette: DBS renewals -->
          <div class="vignette float-c hidden lg:block absolute -left-6 bottom-12 w-[240px] z-10">
            <div class="rounded-2xl bg-[#0F2D2D] shadow-[0_16px_40px_-12px_rgba(15,45,45,0.5)] p-4">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#FFB020]"></span>
                <p class="text-[13px] font-semibold text-[#E6E6E6]">DBS renewals due</p>
              </div>
              <p class="text-[13px] text-[#E6E6E6]/70 mt-1.5">2 coaches in the next 30 days</p>
              <p class="text-[12px] text-[#85FFC7] mt-2.5">Review now</p>
            </div>
          </div>

          <!-- Browser frame -->
          <div class="rounded-[20px] overflow-hidden border border-[#39393A]/10 bg-[#FAFAF8] shadow-[0_32px_64px_-20px_rgba(15,45,45,0.35),0_4px_12px_rgba(57,57,58,0.08)]">
            <div class="flex items-center gap-1.5 px-4 py-3 bg-[#0F2D2D]">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF8552]/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#85FFC7]/60"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#E6E6E6]/30"></span>
              <span class="ml-3 text-xs text-[#E6E6E6]/60 font-medium">app.swimly.uk</span>
            </div>
            <img
              src="/images/app-screenshots/dashboard-desktop.png"
              alt="Swimly dashboard showing club overview with member stats, upcoming sessions, and billing summary"
              class="w-full"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <p class="reveal text-center text-sm text-[#666666] mt-6">
          The same product your committee will use. No mockups, no concept art.
        </p>
      </div>

      <!-- Trust strip -->
      <div class="reveal max-w-4xl mx-auto px-5 sm:px-8 mt-12">
        <div class="flex flex-wrap items-center justify-center gap-x-9 gap-y-3">
          {trust.map(t => (
            <span class="inline-flex items-center gap-2 text-sm text-[#4D4D4D]">
              <t.icon class="w-4 h-4 text-[#297373]" />
              {t.label}
            </span>
          ))}
        </div>
      </div>
    </header>

    <div class="lane-divider max-w-6xl mx-auto" aria-hidden="true"></div>

    <!-- ───────────────────────── The problem ───────────────────────── -->
    <section class="py-20 sm:py-28">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p class="eyebrow reveal">The problem</p>
            <h2 class="reveal font-display text-4xl sm:text-5xl leading-[1.1] text-[#0F2D2D] mt-5">
              You did not sign up for a <em class="text-[#1F7A52]">second job</em>
            </h2>
            <p class="reveal mt-6 text-lg text-[#4D4D4D] leading-relaxed max-w-md">
              But that is what running a club feels like when the tools fight you.
              Every volunteer committee knows the pattern.
            </p>
          </div>
          <div class="lg:col-span-7">
            <ol class="divide-y divide-[#39393A]/10">
              {pains.map(p => (
                <li class="reveal flex gap-6 py-6 first:pt-0 last:pb-0">
                  <span class="font-display text-2xl text-[#297373]/60 leading-none pt-1 tabular-nums">{p.n}</span>
                  <div>
                    <h3 class="text-[17px] font-semibold text-[#0F2D2D]">{p.title}</h3>
                    <p class="text-[15px] text-[#4D4D4D] leading-relaxed mt-1.5">{p.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Before / after ───────────────────────── -->
    <section class="pb-20 sm:pb-28">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="reveal grid md:grid-cols-2 rounded-[28px] overflow-hidden border border-[#39393A]/10 shadow-[0_24px_56px_-24px_rgba(15,45,45,0.3)]">
          <div class="bg-[#F0F0F0] p-8 sm:p-10">
            <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[#B91C1C]/80 mb-7">The spreadsheet era</p>
            <ul class="space-y-5">
              {before.map(item => (
                <li class="flex items-start gap-3.5 text-[15px] text-[#4D4D4D] leading-snug">
                  <X class="w-[18px] h-[18px] text-[#B91C1C]/70 mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="relative bg-[#0F2D2D] p-8 sm:p-10">
            <div class="ripple absolute -top-16 -right-16 w-56 h-56" aria-hidden="true"></div>
            <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[#85FFC7] mb-7">With Swimly</p>
            <ul class="relative space-y-5">
              {after.map(item => (
                <li class="flex items-start gap-3.5 text-[15px] text-[#E6E6E6] leading-snug">
                  <CircleCheck class="w-[18px] h-[18px] text-[#85FFC7] mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Hours back ───────────────────────── -->
    <section class="relative py-20 sm:py-28 bg-[#F0F0F0] border-y border-[#39393A]/8">
      <div class="max-w-5xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-16">
          <p class="eyebrow reveal">Where the hours come back</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
            Less admin. More <em class="text-[#1F7A52]">swimming</em>.
          </h2>
        </div>

        <div class="space-y-0">
          {roles.map((r, i) => (
            <div class:list={["reveal grid sm:grid-cols-12 gap-3 sm:gap-10 items-start py-9", i > 0 && "border-t border-[#39393A]/10"]}>
              <div class="sm:col-span-5 sm:text-right">
                <div class="font-display text-[40px] sm:text-5xl leading-none text-[#0F2D2D] tabular-nums">
                  {r.from}
                  <span class="text-[#297373]/50 mx-1.5">→</span>
                  <span class="result-mark">{r.to}</span>
                </div>
                <div class="text-sm text-[#666666] mt-2">{r.unit}</div>
              </div>
              <div class="sm:col-span-7">
                <h3 class="text-lg font-semibold text-[#0F2D2D]">{r.role}</h3>
                <p class="text-[15px] text-[#4D4D4D] leading-relaxed mt-1.5 max-w-lg">{r.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Product peek (dark band) ───────────────────────── -->
    <section class="relative py-20 sm:py-28 bg-[#0F2D2D] overflow-hidden">
      <div class="ripple absolute -left-24 top-10 w-80 h-80 opacity-60" aria-hidden="true"></div>
      <div class="absolute right-[-120px] bottom-[-180px] w-[480px] h-[480px] rounded-full bg-[#85FFC7]/8 blur-[110px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
        <div class="max-w-2xl">
          <p class="eyebrow-light reveal">Built in the open</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl leading-[1.1] text-[#E6E6E6] mt-5">
            The same product your committee will use
          </h2>
          <p class="reveal mt-6 text-lg text-[#E6E6E6]/65 leading-relaxed max-w-xl">
            These are live screens from Swimly today. Swimmers, sessions, billing
            and compliance in one system, with each committee role seeing exactly
            what their job needs.
          </p>
        </div>

        <div class="mt-14 grid md:grid-cols-2 gap-8 md:gap-10 items-start">
          <figure class="reveal screen-tilt-l">
            <div class="rounded-2xl overflow-hidden border border-[#E6E6E6]/12 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.55),0_0_40px_rgba(133,255,199,0.07)]">
              <img src="/images/app-screenshots/swimmers-desktop.png" alt="Swimly swimmers database with member profiles and squad assignments" class="w-full" loading="lazy" />
            </div>
            <figcaption class="mt-4 text-sm text-[#E6E6E6]/55">Swimmers · profiles, squads and medical notes in one record</figcaption>
          </figure>
          <figure class="reveal screen-tilt-r md:mt-12">
            <div class="rounded-2xl overflow-hidden border border-[#E6E6E6]/12 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.55),0_0_40px_rgba(133,255,199,0.07)]">
              <img src="/images/app-screenshots/billing-desktop.png" alt="Swimly billing showing Direct Debit collection and invoice status" class="w-full" loading="lazy" />
            </div>
            <figcaption class="mt-4 text-sm text-[#E6E6E6]/55">Billing · Direct Debit collection without the chasing</figcaption>
          </figure>
        </div>

        <p class="reveal mt-12">
          <a href="/features/" class="inline-flex items-center gap-2 text-[#85FFC7] hover:text-[#B2FFE0] font-medium transition-colors group">
            Explore the features
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
          </a>
        </p>
      </div>
    </section>

    <!-- ───────────────────────── Founding clubs ───────────────────────── -->
    <section class="py-20 sm:py-28">
      <div class="max-w-5xl mx-auto px-5 sm:px-8">
        <div class="reveal relative rounded-[28px] bg-[#163F3F] overflow-hidden shadow-[0_32px_72px_-28px_rgba(15,45,45,0.55)]">
          <div class="ripple absolute -right-20 -top-20 w-72 h-72" aria-hidden="true"></div>
          <div class="ripple absolute -left-28 -bottom-28 w-80 h-80 opacity-70" aria-hidden="true"></div>

          <div class="relative px-7 py-12 sm:px-16 sm:py-16 text-center">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#85FFC7]/12 border border-[#85FFC7]/25 text-[#85FFC7] text-[13px] font-medium">
              Limited to 10 clubs
            </span>

            <h2 class="font-display text-4xl sm:text-5xl text-[#E6E6E6] mt-7">
              Become a <em class="text-[#85FFC7]">founding</em> club
            </h2>
            <p class="mt-5 text-lg text-[#E6E6E6]/65 max-w-xl mx-auto leading-relaxed">
              Six months free, white-glove migration from spreadsheets, and a
              lifetime pricing lock. In return, you tell us the truth about what works.
            </p>

            <div class="mt-10 grid grid-cols-3 max-w-md mx-auto">
              <div>
                <div class="font-display text-4xl sm:text-5xl text-[#85FFC7] tabular-nums">6</div>
                <div class="text-xs text-[#E6E6E6]/55 mt-1.5">months free</div>
              </div>
              <div class="border-x border-[#E6E6E6]/12">
                <div class="font-display text-4xl sm:text-5xl text-[#85FFC7] tabular-nums">10</div>
                <div class="text-xs text-[#E6E6E6]/55 mt-1.5">places</div>
              </div>
              <div>
                <div class="font-display text-4xl sm:text-5xl text-[#E6E6E6] tabular-nums">£0</div>
                <div class="text-xs text-[#E6E6E6]/55 mt-1.5">upfront</div>
              </div>
            </div>

            <a
              href="/founding-clubs/"
              class="group mt-10 inline-flex items-center justify-center gap-2.5 px-8 rounded-xl bg-[#FF8552] text-[#0F2D2D] font-bold hover:bg-[#FF6B33] transition-all text-lg min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.55)] hover:-translate-y-px"
            >
              Apply to join
              <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-0.5" />
            </a>
            <p class="mt-5 text-sm text-[#E6E6E6]/50">No payment details. No contract. A conversation first.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Pricing ───────────────────────── -->
    <section id="pricing" class="pb-24 sm:pb-32 pt-4">
      <div class="max-w-5xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-14">
          <p class="eyebrow reveal">Pricing</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Simple, honest pricing</h2>
          <p class="reveal mt-5 text-lg text-[#4D4D4D]">
            No per-member fees. No hidden charges. Free for clubs under 50 members.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-5 items-start">
          {tiers.map(tier => (
            <div class:list={[
              "reveal relative rounded-[20px] bg-[#FAFAF8] p-7",
              tier.highlight
                ? "border-2 border-[#297373]/35 shadow-[0_16px_40px_-16px_rgba(15,45,45,0.3)] sm:-translate-y-3"
                : "border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08),0_1px_2px_rgba(57,57,58,0.06)]",
            ]}>
              {tier.highlight && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-[#0F2D2D] text-[#85FFC7] text-xs font-semibold whitespace-nowrap">
                  Most popular
                </span>
              )}
              <h3 class="text-[13px] font-semibold tracking-[0.12em] uppercase text-[#666666]">{tier.name}</h3>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="font-display text-[44px] leading-none text-[#0F2D2D]">{tier.price}</span>
                {tier.period && <span class="text-[#666666] text-lg">{tier.period}</span>}
              </div>
              <p class="text-sm text-[#666666] mt-2.5 pb-5 border-b border-[#39393A]/8">{tier.members}</p>
              <ul class="mt-5 space-y-3">
                {tier.features.map(f => (
                  <li class="flex items-start gap-2.5 text-[14px] text-[#4D4D4D]">
                    <Check class="w-4 h-4 text-[#1F7A52] mt-0.5 shrink-0" />
