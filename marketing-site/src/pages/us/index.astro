---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ProductTour from "../../components/ProductTour.astro";
import { REGIONS } from "../../config/regions";
import {
  CreditCard,
  Trophy,
  Settings,
  Users,
  GraduationCap,
  BarChart3,
  ArrowRight,
  X,
  CircleCheck,
  Shield,
  Lock,
  Server,
  ShieldCheck,
} from "@lucide/astro";

const title = "Swim Team Management Software | Free Plan | Swimly";
const description =
  "Swim team management software for US swim teams. Automate billing, membership, attendance, and safeguarding records in one place. Free starter plan for teams under 50 athletes.";
const canonical = "https://swimly.club/us/";
const appUrl = REGIONS.us.appUrl;

const trust = [
  { icon: Shield, label: "Built for US swim teams" },
  { icon: Lock, label: "Secure cloud platform" },
  { icon: Server, label: "Role-based access" },
  { icon: ShieldCheck, label: "256-bit encryption" },
];

const pains = [
  { n: "01", title: "Five spreadsheets, and none of them agree", desc: "Members in one, payments in another, attendance on paper. Nobody knows which version is current." },
  { n: "02", title: "Evenings lost to chasing dues", desc: "Card payments fail quietly. The treasurer ends up sending awkward reminders at ten o'clock at night." },
  { n: "03", title: "Safeguarding records nobody can reach", desc: "Compliance you cannot evidence quickly is compliance you cannot evidence at all." },
  { n: "04", title: "Handover means starting again", desc: "When the membership coordinator steps down, the team's knowledge walks out the door with them." },
];

const before = [
  "Membership records scattered across spreadsheets",
  "Chasing parents for dues every month by text",
  "Rosters printed, filled in by hand, then lost",
  "Safeguarding files in a folder nobody can access",
];
const after = [
  "Every member, payment, and session in one place",
  "Card and ACH payments collect on schedule, failures retry automatically",
  "Live rosters on the phone the coach already carries",
  "Organized safeguarding records with expiration alerts",
];

const roles = [
  { from: "10h", to: "2h", unit: "per week", role: "Membership Coordinator", desc: "Parents keep their own details current in the portal. Welcome emails and renewal reminders send themselves." },
  { from: "6h", to: "30m", unit: "per week", role: "Treasurer", desc: "Dues arrive on schedule, failed payments retry on their own, and the season report generates in one click." },
  { from: "Paper", to: "Phone", unit: "rosters", role: "Head Coach", desc: "Attendance taken on deck in seconds, even at six in the morning with wet hands and bad lighting." },
];

const reasons = [
  { title: "Built for how US swim teams work", desc: "Handle membership types, registration requirements, and renewal cycles that match the way US teams operate. Import your member data, track coach credentials, and keep records organized, all in one system." },
  { title: "Safeguarding tracking as standard", desc: "Track background screening, coaching credentials, and required training with automated expiration alerts. Generate clear reports when you need them. No more spreadsheets tracking renewal dates." },
  { title: "Modern card and ACH payments", desc: "Collect monthly dues automatically by card or bank transfer (ACH). No more chasing checks, reconciling deposits, or dealing with failed payments by hand." },
  { title: "Transparent flat-rate pricing", desc: "No per-athlete fees that increase as your team grows. Predictable monthly pricing, not bills that escalate. Free for teams under 50 athletes." },
  { title: "Secure, role-based access", desc: "Every role sees exactly what they need and nothing they do not. Treasurers, coordinators, coaches, and parents each get the right view of your team's data." },
  { title: "Built by people who run teams", desc: "Swimly was created by swim parents and committee members who have sat through the same frustrating meetings. We understand volunteer capacity, board handovers, and evening-and-weekend reality." },
];

const steps = [
  { tag: "Day 0", title: "Get in touch", desc: "Tell us about your team, how many athletes you have, and what you currently use. No hard sell, just a conversation about whether Swimly fits." },
  { tag: "Days 1-3", title: "We migrate your data", desc: "Send us your spreadsheets or exports. We import members, set up groups, configure billing schedules, and build your session calendar. You review it, we adjust." },
  { tag: "Day 5", title: "Your board logs in", desc: "We walk your treasurer, membership coordinator, and coaches through the platform. Each person sees exactly the features their role needs." },
  { tag: "Week 2+", title: "You're live", desc: "Payments collect automatically. Coaches take digital attendance. Parents self-serve. We stay on hand through the first month to fine-tune anything." },
];

const compares = [
  { label: "Swimly vs TeamUnify", href: "/us/compare/teamunify/", desc: "How Swimly is positioned for US swim teams" },
  { label: "Swimly vs SwimTopia", href: "/us/compare/swimtopia/", desc: "A modern, focused alternative for your team" },
];

const solutions = [
  { icon: CreditCard, title: "Billing & Payments", desc: "Automate dues collection with card and ACH. No more chasing parents or manual reconciliation.", href: "/us/features/" },
  { icon: Trophy, title: "Swim Team Software", desc: "All-in-one management platform for competitive and recreational swim teams. Membership, billing, and records.", href: "/us/features/" },
  { icon: Settings, title: "Membership Management", desc: "Member records, family grouping, and group assignments in one organized place.", href: "/us/features/" },
  { icon: Users, title: "Parent Portal", desc: "Parents view schedules, pay invoices, and update their own details. Fewer questions for your board.", href: "/us/features/" },
  { icon: GraduationCap, title: "Attendance & Sessions", desc: "Plan practices, assign lanes, and take attendance on deck from any phone.", href: "/us/features/" },
  { icon: BarChart3, title: "Compare Platforms", desc: "See how Swimly is positioned next to TeamUnify and SwimTopia.", href: "/us/compare/teamunify/" },
];

const faqItems = [
  { question: "What is swim team management software?", answer: "Swim team management software is a platform that helps swim teams manage membership, billing, attendance, and records in one place. Swimly is built to handle card and ACH dues payments, practice rosters, and safeguarding records for US swim teams." },
  { question: "How much does Swimly cost?", answer: "Swimly has a free Starter plan for teams under 50 athletes. Paid plans are provisional while we finalize US pricing. See the pricing page for current details. All plans include unlimited coaches and sessions." },
  { question: "What features do I need in swim team software?", answer: "Useful features include automated billing and dues collection, digital attendance tracking, membership management, safeguarding tools such as credential and expiration tracking, parent communication, and session scheduling. Swimly includes all of these in every plan." },
  { question: "Does Swimly work for both competitive and recreational teams?", answer: "Yes. Swimly supports both competitive swim teams and recreational programs. You can manage different groups, practice schedules, and fee structures all in one platform." },
  { question: "How hard is it to migrate from spreadsheets or another system?", answer: "Swimly provides hands-on migration support for early teams. We help import your membership data, set up billing schedules, and train your board. Most teams are up and running within two weeks. No technical knowledge required." },
  { question: "How do payments work?", answer: "Swimly collects dues by card or bank transfer (ACH). Payments are collected automatically on schedule and failures are retried automatically, so your treasurer is not chasing checks." },
  { question: "Can parents access their own information and payment history?", answer: "Yes. Every family gets access to a parent portal where they can view payment history, upcoming sessions, attendance records, and outstanding balances. Parents can also update contact and emergency information themselves." },
  { question: "Is Swimly available now?", answer: "Yes. You can create your team and start using Swimly today. Teams under 50 athletes are free with no card required." },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://swimly.club/us/" },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} faqItems={faqItems}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main>
    <!-- Hero -->
    <header class="relative pt-28 sm:pt-36 pb-10 overflow-hidden">
      <div class="dot-grid absolute inset-x-0 top-0 h-[640px] pointer-events-none" aria-hidden="true"></div>
      <div class="hero-wash absolute left-1/2 top-[-160px] -translate-x-1/2 w-[900px] h-[520px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="eyebrow reveal">The operating system for US swim teams</p>

        <h1 class="reveal font-display text-[44px] leading-[1.06] sm:text-6xl lg:text-[72px] sm:leading-[1.04] text-[#0F2D2D] mt-6 tracking-[-0.01em]">
          Give your board back
          <br class="hidden sm:block" />
          <em class="text-mint-ink">hours</em> every week
        </h1>

        <p class="reveal mt-7 text-[17px] sm:text-xl text-ink-soft max-w-2xl mx-auto leading-relaxed">
          Membership, billing, attendance, and safeguarding records in one calm,
          organized place. Built by a swim parent who has chased the dues and
          printed the rosters.
        </p>

        <div class="reveal mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={`${appUrl}/create-club`}
            class="group inline-flex items-center justify-center gap-2.5 px-8 rounded-xl bg-lime-cta text-[#0F2D2D] font-bold hover:bg-lime-cta-hover transition-all text-lg min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.7)] hover:shadow-[0_10px_28px_-8px_rgba(255,107,51,0.8)] hover:-translate-y-px w-full sm:w-auto"
          >
            Start your team, free
            <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a
            href="/us/features/"
            class="inline-flex items-center justify-center gap-2 px-7 rounded-xl border border-[#39393A]/20 bg-surface/60 text-ink hover:border-[#297373]/50 hover:bg-surface transition-colors text-lg min-h-14 w-full sm:w-auto"
          >
            See the features
          </a>
        </div>

        <p class="reveal mt-6 text-sm text-ink-mute">
          Free for teams under 50 athletes. No card required.
        </p>
      </div>

      <!-- Trust strip -->
      <div class="reveal max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-14">
        <div class="flex flex-wrap items-center justify-center gap-x-9 gap-y-3">
          {trust.map((t) => (
            <span class="inline-flex items-center gap-2 text-sm text-ink-soft">
              <t.icon class="w-4 h-4 text-[#297373]" />
              {t.label}
            </span>
          ))}
        </div>
      </div>
    </header>

    <div class="lane-divider max-w-6xl mx-auto" aria-hidden="true"></div>

    <!-- The problem -->
    <section class="py-20 sm:py-28">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p class="eyebrow reveal">The problem</p>
            <h2 class="reveal font-display text-4xl sm:text-5xl leading-[1.1] text-[#0F2D2D] mt-5">
              You did not sign up for a <em class="text-mint-ink">second job</em>
            </h2>
            <p class="reveal mt-6 text-lg text-ink-soft leading-relaxed max-w-md">
              But that is what running a team feels like when the tools fight you.
              Every volunteer board knows the pattern.
            </p>
          </div>
          <div class="lg:col-span-7">
            <ol class="divide-y divide-[#39393A]/10">
              {pains.map((p) => (
                <li class="reveal flex gap-6 py-6 first:pt-0 last:pb-0">
                  <span class="font-display text-2xl text-[#297373]/60 leading-none pt-1 tabular-nums">{p.n}</span>
                  <div>
                    <h3 class="text-[17px] font-semibold text-[#0F2D2D]">{p.title}</h3>
                    <p class="text-[15px] text-ink-soft leading-relaxed mt-1.5">{p.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Before / after -->
    <section class="pb-20 sm:pb-28">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal grid md:grid-cols-2 rounded-[28px] overflow-hidden border border-[#39393A]/10 shadow-[0_24px_56px_-24px_rgba(15,45,45,0.3)]">
          <div class="bg-surface p-8 sm:p-10">
            <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[#B91C1C]/80 mb-7">The spreadsheet era</p>
            <ul class="space-y-5">
              {before.map((item) => (
                <li class="flex items-start gap-3.5 text-[15px] text-ink-soft leading-snug">
                  <X class="w-[18px] h-[18px] text-[#B91C1C]/70 mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="relative bg-[#0F2D2D] p-8 sm:p-10">
            <div class="ripple absolute -top-16 -right-16 w-56 h-56" aria-hidden="true"></div>
            <p class="text-[12px] font-semibold tracking-[0.14em] uppercase text-[#85FFC7] mb-7">With Swimly</p>
            <ul class="relative space-y-5">
              {after.map((item) => (
                <li class="flex items-start gap-3.5 text-[15px] text-[#E6E6E6] leading-snug">
                  <CircleCheck class="w-[18px] h-[18px] text-[#85FFC7] mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <ProductTour region="us" noun="team" />

    <!-- Why US teams choose Swimly -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <p class="eyebrow reveal">Why Swimly</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Why US swim teams choose Swimly</h2>
          <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
            Not a generic sports app adapted for swimming. Purpose-built for how
            swim teams actually work, from card and ACH billing to organized
            safeguarding records.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {reasons.map((r) => (
            <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
              <h3 class="text-lg font-semibold mb-2.5 text-mint-ink">{r.title}</h3>
              <p class="text-ink-mute text-sm leading-relaxed">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hours back -->
    <section class="py-20 sm:py-28">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <p class="eyebrow reveal">Where the hours come back</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">
            Less admin. More <em class="text-mint-ink">swimming</em>.
          </h2>
        </div>
        <div class="space-y-0">
          {roles.map((r, i) => (
            <div class:list={["reveal grid sm:grid-cols-12 gap-3 sm:gap-10 items-start py-9", i > 0 && "border-t border-[#39393A]/10"]}>
              <div class="sm:col-span-5 sm:text-right">
                <div class="font-display text-[40px] sm:text-5xl leading-none text-[#0F2D2D] tabular-nums">
                  {r.from}
                  <span class="text-[#297373]/50 mx-1.5">&rarr;</span>
                  <span class="result-mark">{r.to}</span>
                </div>
                <div class="text-sm text-ink-mute mt-2">{r.unit}</div>
              </div>
              <div class="sm:col-span-7">
                <h3 class="text-lg font-semibold text-[#0F2D2D]">{r.role}</h3>
                <p class="text-[15px] text-ink-soft leading-relaxed mt-1.5 max-w-lg">{r.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compare -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="eyebrow reveal">Honest comparisons</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">How does Swimly compare?</h2>
          <p class="reveal text-ink-soft text-lg mt-5 max-w-2xl mx-auto">
            We have written fair, factual comparisons so you can decide what fits
            your team. We stick to what we can stand behind.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
          {compares.map((c) => (
            <a href={c.href} class="reveal block p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 transition-all group hover:-translate-y-0.5">
              <h3 class="text-lg font-semibold mb-2 text-[#0F2D2D] group-hover:text-mint-ink transition-colors">{c.label}</h3>
              <p class="text-ink-mute text-sm">{c.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="py-20 sm:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-2xl">
          <p class="eyebrow reveal">Switching is easier than you think</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">From spreadsheet to software in about two weeks</h2>
          <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
            We help with migration so you do not have to do the heavy lifting alone.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {steps.map((s) => (
            <div class="reveal p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
              <span class="eyebrow">{s.tag}</span>
              <h3 class="text-lg font-semibold text-[#0F2D2D] mt-3 mb-2">{s.title}</h3>
              <p class="text-sm text-ink-mute leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Solutions grid -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="eyebrow reveal">Built for your needs</p>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Whatever kind of team you run</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {solutions.map((s) => (
            <a href={s.href} class="reveal group block p-7 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.25)] hover:-translate-y-0.5 transition-all">
              <div class="w-11 h-11 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
                <s.icon class="w-5 h-5 text-mint-ink" />
              </div>
              <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2 group-hover:text-mint-ink transition-colors">{s.title}</h3>
              <p class="text-ink-mute text-sm leading-relaxed mb-3">{s.desc}</p>
              <span class="text-mint-ink text-sm font-medium inline-flex items-center gap-1">Learn more <ArrowRight class="w-3.5 h-3.5" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- USA Swimming context -->
    <section class="py-20 sm:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="eyebrow reveal">For the US swimming community</p>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Made for the way US teams operate</h2>
        <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
          Many competitive swim teams in the United States are members of USA
          Swimming, the national governing body for the sport. Swimly is designed
          to keep the membership, billing, attendance, and safeguarding records
          your team relies on organized in one place, whatever bodies you are
          affiliated with.
        </p>
        <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed">
          Looking for a program near you? Browse our
          <a href="/us/clubs/" class="text-mint-ink font-semibold hover:underline">directory of
          swim teams and swim schools across the US</a>.
        </p>
      </div>
    </section>

    <!-- Pricing teaser -->
    <section class="py-20 sm:py-28 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="eyebrow reveal">Pricing</p>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-[#0F2D2D] mt-5">Simple, transparent pricing</h2>
        <p class="reveal text-ink-soft text-lg mt-6 leading-relaxed max-w-2xl mx-auto">
          No per-athlete fees. No hidden charges. A flat monthly rate that scales
          with your team, and a free plan for teams under 50 athletes.
        </p>
        <div class="reveal mt-8">
          <a
            href="/us/pricing/"
            class="inline-flex items-center justify-center gap-2 text-base font-bold px-7 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all min-h-12 shadow-[0_8px_20px_-8px_rgba(255,133,82,0.6)]"
          >
            See pricing
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h2 class="reveal font-display text-4xl text-[#0F2D2D] mb-6">Ready to simplify team management?</h2>
      <p class="reveal text-xl text-ink-soft mb-8">Start free with up to 50 athletes. No credit card required.</p>
      <a
        href={`${appUrl}/create-club`}
        class="reveal inline-flex items-center justify-center gap-2 text-lg font-bold px-8 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all min-h-14 shadow-[0_8px_24px_-8px_rgba(255,133,82,0.6)]"
      >
        Start your team, free
        <ArrowRight class="w-5 h-5" />
      </a>
    </section>
  </main>
  <Footer />
</Layout>
