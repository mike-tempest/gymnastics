---
import Layout from "../../../../layouts/Layout.astro";
import Nav from "../../../../components/Nav.astro";
import Footer from "../../../../components/Footer.astro";
import { REGIONS } from "../../../../config/regions";
import { ArrowRight, DollarSign, Zap, Smartphone, Users } from "@lucide/astro";

const title = "Swimly vs SwimTopia | US Swim Team Software";
const description =
  "Compare Swimly and SwimTopia for US swim teams. See where Swimly is positioned: a modern, focused platform with transparent flat-rate pricing and card and ACH billing.";
const canonical = "https://swimly.club/us/compare/swimtopia/";
const appUrl = REGIONS.us.appUrl;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://swimly.club/us/" },
    { "@type": "ListItem", position: 2, name: "Compare", item: "https://swimly.club/us/compare/swimtopia/" },
    { "@type": "ListItem", position: 3, name: "SwimTopia", item: "https://swimly.club/us/compare/swimtopia/" },
  ],
};

const reasons = [
  {
    icon: Users,
    title: "Built for volunteer-run teams",
    desc: "Swimly is designed for the parent who runs team admin around a full-time job. Each role sees only what it needs, so onboarding a new board member is quick.",
  },
  {
    icon: Smartphone,
    title: "Mobile-first, works on deck",
    desc: "Swimly works in any mobile browser, with no app download required. Coaches take attendance on deck and parents check balances from their phone.",
  },
  {
    icon: DollarSign,
    title: "Transparent, flat-rate pricing",
    desc: "Swimly uses simple flat-rate pricing with no per-athlete fees, plus a free plan for teams under 50 athletes. Paid US pricing is provisional while we finalize plans.",
  },
  {
    icon: Zap,
    title: "Modern platform, fast iteration",
    desc: "Swimly is built on a modern stack and ships improvements regularly, guided by feedback from US teams.",
  },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main class="pt-24 pb-16">
    <!-- Hero -->
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <p class="eyebrow mb-6">Platform comparison</p>
        <h1 class="font-display text-4xl sm:text-5xl text-[#0F2D2D] mb-6">Swimly vs SwimTopia</h1>
        <p class="text-xl text-ink-soft max-w-3xl">
          SwimTopia is a well-known swim team management platform used by many
          teams in the United States. Swimly takes a focused, modern approach.
          This page explains what Swimly is built for so you can decide what fits
          your team.
        </p>

        <div class="grid grid-cols-3 gap-4 mt-10">
          <div class="bg-[#85FFC7]/10 border border-[#1F7A52]/20 rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">Free</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">under 50 athletes</p>
          </div>
          <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">Flat</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">rate pricing</p>
          </div>
          <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">Mobile</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">first design</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Positioning statement -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="bg-[#85FFC7]/15 rounded-2xl border border-[#1F7A52]/20 p-8 sm:p-10">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-4">What Swimly is built for</h2>
        <p class="text-ink-soft mb-4">
          Most swim teams are run by volunteers. They need software that is quick
          to set up, easy to hand to the next board, and calm to use on a phone on
          deck. That is exactly what Swimly is built for.
        </p>
        <p class="text-ink-soft">
          We focus on the core that every team needs every week: membership,
          billing, attendance, communication, and safeguarding records, in one
          tidy system with transparent pricing.
        </p>
      </div>
    </section>

    <!-- What Swimly offers -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-8">What Swimly offers</h2>
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[#39393A]/8 bg-surface">
              <th class="text-left p-3 sm:p-6 text-[#0F2D2D] font-semibold">Area</th>
              <th class="text-left p-3 sm:p-6 text-mint-ink font-semibold bg-[#85FFC7]/10">Swimly</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#39393A]/8">
            <tr>
              <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">Membership management</td>
              <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">Member database with family grouping and training groups</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">Payments</td>
              <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">Automated card and ACH dues, with automatic retry on failures</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">Attendance</td>
              <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">Quick on-deck check-in/out from any phone</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">Parent portal</td>
              <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">Mobile-first web portal, no app download required</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">Safeguarding records</td>
              <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">Screening and credential tracking with expiration alerts</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-6 text-[#0F2D2D] font-medium">Pricing</td>
              <td class="p-3 sm:p-6 text-ink-soft bg-[#85FFC7]/10">Transparent flat rate, free under 50 athletes (paid pricing provisional)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-ink-faint mt-4">
        This table describes Swimly's own features. For SwimTopia's current
        features and pricing, please refer to their website.
      </p>
    </section>

    <!-- Why choose Swimly -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-4 text-center">Why teams choose Swimly</h2>
      <p class="text-ink-soft text-center mb-12 max-w-2xl mx-auto">Four reasons teams pick Swimly.</p>
      <div class="grid sm:grid-cols-2 gap-6">
        {reasons.map((r) => (
          <div class="p-6 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-4">
              <r.icon class="w-5 h-5 text-mint-ink" />
            </div>
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">{r.title}</h3>
            <p class="text-sm text-ink-soft leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Honest note -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-8">When another platform might fit better</h2>
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8">
        <p class="text-ink-soft mb-4">We believe in being straight with you. Swimly may not be the right fit if:</p>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex gap-3">
            <span class="text-ink-faint" aria-hidden="true">&bull;</span>
            <span>You need advanced meet management right now, as our meet tooling is still in development.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-ink-faint" aria-hidden="true">&bull;</span>
            <span>You rely on a specific integration that another platform already supports and you cannot move off it yet.</span>
          </li>
        </ul>
        <p class="text-ink-soft mt-4">
          If that sounds like your team, we would still be glad to talk through
          timing. We will tell you honestly whether Swimly is ready for you.
        </p>
      </div>
    </section>

    <!-- Compare other -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 text-center">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-4">Comparing other platforms?</h2>
        <p class="text-ink-soft mb-6">See how Swimly is positioned next to TeamUnify.</p>
        <a href="/us/compare/teamunify/" class="inline-flex items-center gap-2 text-mint-ink hover:text-[#0F2D2D] transition-colors font-medium">
          Swimly vs TeamUnify
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-6">Ready for swim team software that respects your time?</h2>
      <p class="text-xl text-ink-soft mb-8 max-w-xl mx-auto">Create your team today. Free for teams under 50 athletes, no card required.</p>
      <a
        href={`${appUrl}/create-club`}
        class="inline-flex items-center gap-2 text-lg font-semibold min-h-14 px-8 py-4 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all"
      >
        Start your team, free
        <ArrowRight class="w-5 h-5" />
      </a>
      <p class="mt-4 text-sm text-ink-mute">Free to join. No payment details required.</p>
    </section>
  </main>
  <Footer />
</Layout>
