---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { BookOpen, ChevronRight } from "@lucide/astro";

// Region-only hub on swimly.club. The Layout derives the canonical
// (https://swimly.club/us/guides/), <html lang="en-US"> and USD from this
// page's path, so none of those are hardcoded here.
// American spelling and US terminology ("swim team", "season", "dues").
// USA Swimming and LSCs only; no Swim England, Wavepower or DBS specifics.
//
// This page also makes the BreadcrumbList that every /us/guides/ page emits
// resolve: each one lists a position-2 "Guides" item pointing here.
const SITE = "https://swimly.club";
const PATH = "/us/guides/";
const canonical = `${SITE}${PATH}`;

const title = "Swim Team Guides for US Clubs and Parents | Swimly";
const description =
  "Plain-English guides for US swim teams: USA Swimming and Safe Sport, joining a team, how meets work, collecting dues, and choosing team software.";

const parentGuides = [
  {
    href: "/us/guides/joining-a-us-swim-team-parent-guide/",
    name: "Joining a US swim team",
    blurb:
      "How US swim teams work, from finding a team and tryouts to USA Swimming registration, the season, costs, and gear.",
  },
  {
    href: "/us/guides/how-swim-meets-work-parent-guide/",
    name: "How swim meets work",
    blurb:
      "Events, heats and lanes, reading a heat sheet, seeding, officials, and timing, ahead of your child's first meet.",
  },
  {
    href: "/us/guides/swim-meet-events-and-age-groups-explained/",
    name: "Swim meet events and age groups",
    blurb:
      "Which events each age group races, the medley and relay stroke order, short course vs long course, and B to AAAA times.",
  },
];

const committeeGuides = [
  {
    href: "/us/guides/usa-swimming-safe-sport-explained/",
    name: "USA Swimming and Safe Sport explained",
    blurb:
      "What USA Swimming is, how teams affiliate through their LSC, membership basics, and how Safe Sport and MAAPP work.",
  },
  {
    href: "/us/guides/swim-team-treasurer-collecting-dues/",
    name: "A treasurer's guide to collecting dues",
    blurb:
      "Which fees to collect, setting a billing cadence, card and ACH payments, late payments, and keeping clean records.",
  },
  {
    href: "/us/guides/swim-team-management-software/",
    name: "Choosing swim team management software",
    blurb:
      "How US teams choose software for registration, billing, attendance, and parent communication, without the jargon.",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/us/` },
    { "@type": "ListItem", position: 2, name: "Guides", item: canonical },
  ],
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Swimly guides for US swim teams",
  description:
    "Guides for US swim team parents, board members, treasurers, and coaches.",
  numberOfItems: parentGuides.length + committeeGuides.length,
  itemListElement: [...parentGuides, ...committeeGuides].map((guide, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: guide.name,
    item: `${SITE}${guide.href}`,
  })),
};
---

<Layout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema, null, 2)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema, null, 2)}
  />

  <Nav />

  <main>
    <!-- Hero -->
    <section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20 overflow-hidden">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="eyebrow inline-flex items-center gap-2 mb-6">
          <BookOpen class="w-4 h-4" />
          US Guides
        </p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-[#0F2D2D]">
          Swim team <em class="text-mint-ink">guides</em>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-ink-soft max-w-2xl mx-auto leading-relaxed">
          Practical, plain-English guides for US swim teams. Written for the parents figuring out
          their first season and the volunteers keeping a team running, not for software people.
        </p>
      </div>
    </section>

    <!-- For parents -->
    <section class="pb-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-2">For parents</h2>
        <p class="text-ink-soft mb-6 max-w-2xl">
          New to swimming? Start here. These cover what happens before your child joins a team, and
          what happens once they start racing.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            parentGuides.map((guide) => (
              <a
                href={guide.href}
                class="group flex items-start justify-between gap-4 p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all"
              >
                <div>
                  <h3 class="text-lg font-semibold text-[#0F2D2D] group-hover:text-mint-ink transition-colors mb-2">
                    {guide.name}
                  </h3>
                  <p class="text-ink-mute text-sm leading-relaxed">{guide.blurb}</p>
                </div>
                <ChevronRight class="w-5 h-5 text-ink-faint group-hover:text-mint-ink transition-colors shrink-0 mt-1" />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- For teams -->
    <section class="pb-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-2">For boards, treasurers and coaches</h2>
        <p class="text-ink-soft mb-6 max-w-2xl">
          Running a team is mostly admin nobody trained you for. These cover the governing body,
          the money, and the tools.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            committeeGuides.map((guide) => (
              <a
                href={guide.href}
                class="group flex items-start justify-between gap-4 p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all"
              >
                <div>
                  <h3 class="text-lg font-semibold text-[#0F2D2D] group-hover:text-mint-ink transition-colors mb-2">
                    {guide.name}
                  </h3>
                  <p class="text-ink-mute text-sm leading-relaxed">{guide.blurb}</p>
                </div>
                <ChevronRight class="w-5 h-5 text-ink-faint group-hover:text-mint-ink transition-colors shrink-0 mt-1" />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Elsewhere on the site -->
    <section class="py-16 bg-surface border-y border-[#39393A]/8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-6">Elsewhere on Swimly</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <a
            href="/us/clubs/"
            class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all"
          >
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Find a swim team</h3>
            <p class="text-ink-mute text-sm">Browse teams and swim schools by state</p>
          </a>
          <a
            href="/us/features/"
            class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all"
          >
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">What Swimly does</h3>
            <p class="text-ink-mute text-sm">Registration, billing, attendance and messaging</p>
          </a>
          <a
            href="/us/pricing/"
            class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all"
          >
            <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Swimly pricing</h3>
            <p class="text-ink-mute text-sm">Transparent monthly plans in USD</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
