---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import ProductTour from "../../../components/ProductTour.astro";
import { REGIONS } from "../../../config/regions";

const title = "Swim Team Software Features | Swimly";
const description =
  "Membership database, automated billing, attendance rosters, and safeguarding records. See every feature Swimly offers US swim teams.";
const canonical = "https://swimly.club/us/features/";
const appUrl = REGIONS.us.appUrl;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://swimly.club/us/" },
    { "@type": "ListItem", position: 2, name: "Features", item: "https://swimly.club/us/features/" },
  ],
};

const membership = [
  { t: "Online registration", d: "Parents sign up through a web form. No printable PDFs or scanning." },
  { t: "Family grouping", d: "Link siblings together for billing and communication. One invoice per family." },
  { t: "Self-service portal", d: "Parents update contact details, emergency contacts, and medical information without emailing the coordinator." },
  { t: "Group assignments", d: "Organize members into training groups. Move athletes between groups as they progress." },
  { t: "Custom fields", d: "Track swim levels, medical conditions, or any team-specific data." },
];

const billing = [
  { t: "Card and ACH payments", d: "Collect monthly, seasonal, or annual dues automatically by card or bank transfer." },
  { t: "Flexible payment schedules", d: "Set different fee amounts for different groups or membership types." },
  { t: "Automatic retry on failures", d: "Failed payments are retried automatically. Parents receive notifications if action is needed." },
  { t: "Invoice generation", d: "Automatic invoices sent to parents and stored in their portal for download." },
  { t: "Payment tracking", d: "See which members are paid up and who has an outstanding balance at a glance." },
];

const sessions = [
  { t: "Visual lane planner", d: "Assign groups to lanes and see your pool layout at a glance." },
  { t: "Recurring session templates", d: "Set up your weekly schedule once, then repeat it automatically." },
  { t: "Quick check-in/out", d: "Mark attendance with a tap. See who is present at each session." },
  { t: "Coaching schedules", d: "Assign coaches to sessions. Track who is covering which group each week." },
  { t: "Session changes", d: "Cancel or reschedule a session and automatically notify affected members." },
];

const reporting = [
  { t: "Income dashboard", d: "See total membership revenue, outstanding payments, and collection rates." },
  { t: "Payment reconciliation", d: "Collections are automatically reconciled with member accounts." },
  { t: "Exportable reports", d: "Generate CSV or PDF reports for your treasurer, auditor, or board meeting." },
  { t: "Meet fee tracking", d: "Link meet entry fees to member accounts for transparent billing." },
  { t: "Historical data", d: "View income trends month by month or season by season for planning." },
];

const communication = [
  { t: "Session change notifications", d: "Cancel or move a session and affected members are automatically emailed." },
  { t: "Payment reminders", d: "Automatic reminders for outstanding balances or upcoming renewals." },
  { t: "Team announcements", d: "Send targeted messages to specific groups or the whole team." },
  { t: "Credential expiration alerts", d: "Notify coaches and the board when screenings or credentials are about to expire." },
  { t: "Email templates", d: "Pre-written messages for common scenarios: payment failed, session canceled, renewal due." },
];

const safeguarding = [
  { t: "Screening records", d: "Record background screening status and expiration dates for all coaches and volunteers." },
  { t: "Credential records", d: "Track coaching credentials, first aid certificates, and lifeguard qualifications." },
  { t: "Expiration alerts", d: "Automatic reminders 60 and 30 days before credentials expire." },
  { t: "Consent forms", d: "Digital consent for photography, medical treatment, and data processing." },
  { t: "Compliance dashboard", d: "See at a glance which coaches need renewals or which members lack consent." },
];

const roles = [
  { name: "Treasurer", desc: "Revenue overview, outstanding payments, export reports for board meetings, reconciliation dashboard.", tone: "from-[#85FFC7]/20 border-[#1F7A52]/20" },
  { name: "Membership Coordinator", desc: "Member database, family grouping, group assignments, registration approvals.", tone: "from-blue-500/10 border-blue-500/20" },
  { name: "Coach", desc: "On-deck attendance, session rosters, athlete profiles, group lists on mobile.", tone: "from-amber-500/10 border-amber-500/20" },
  { name: "Parent", desc: "Payment history, upcoming sessions, update contact details, view balances.", tone: "from-purple-500/10 border-purple-500/20" },
];

const sections = [
  { id: "membership-management", title: "Membership Management", lead: "A simple, modern member database that parents can update themselves. No more chasing paper forms or maintaining spreadsheets.", items: membership },
  { id: "automated-billing", title: "Automated Billing & Payments", lead: "Card and ACH collection means dues arrive automatically every month. No more chasing parents or reconciling bank statements.", items: billing },
  { id: "session-scheduling", title: "Session Scheduling & Attendance", lead: "Manage your pool time, assign athletes to lanes, and track who is attending. Members see upcoming sessions; coaches see their schedules.", items: sessions },
  { id: "financial-reporting", title: "Financial Overview & Reporting", lead: "A real-time financial dashboard showing team income and expenses. Export detailed reports for your board without digging through bank statements.", items: reporting },
  { id: "communication", title: "Smart Notifications & Communication", lead: "Keep members informed without relying on group text chains. Automated reminders and targeted announcements delivered by email.", items: communication },
  { id: "safeguarding", title: "Safeguarding & Compliance", lead: "Track background screenings, coaching credentials, and consent forms. Keep your athlete-safety records organized and current.", items: safeguarding },
];

const pills = [
  { label: "Membership", href: "#membership-management" },
  { label: "Billing", href: "#automated-billing" },
  { label: "Sessions", href: "#session-scheduling" },
  { label: "Reporting", href: "#financial-reporting" },
  { label: "Communication", href: "#communication" },
  { label: "Safeguarding", href: "#safeguarding" },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main class="pt-24 pb-16">
    <!-- Hero -->
    <section class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[500px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative text-center">
        <p class="eyebrow mb-6">Purpose-built for US swim teams</p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-[#0F2D2D] mb-6 leading-tight">
          Everything your<br class="hidden sm:block" />
          <em class="text-mint-ink">swim team needs</em>
        </h1>
        <p class="text-xl text-ink-soft max-w-2xl mx-auto leading-relaxed">
          Membership, billing, attendance, safeguarding, and communication in one
          platform. Built by a swim parent who got tired of the spreadsheet chaos.
        </p>
      </div>

      <!-- Quick nav pills -->
      <div class="relative flex flex-wrap justify-center gap-3 mt-10">
        {pills.map((p) => (
          <a href={p.href} class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">{p.label}</a>
        ))}
      </div>
    </section>

    <!-- Stats bar -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">6</p>
          <p class="text-sm text-ink-mute mt-1">Core modules</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">Free</p>
          <p class="text-sm text-ink-mute mt-1">Under 50 athletes</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">1</p>
          <p class="text-sm text-ink-mute mt-1">System, not five</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">$39</p>
          <p class="text-sm text-ink-mute mt-1">Flat rate per month</p>
        </div>
      </div>
      <p class="text-xs text-ink-faint mt-3 text-center">Paid pricing is provisional. See the <a href="/us/pricing/" class="text-mint-ink hover:text-[#0F2D2D] underline underline-offset-2">pricing page</a>.</p>
    </section>

    <!-- Feature sections -->
    {sections.map((s) => (
      <section id={s.id} class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
          <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">{s.title}</h2>
          <p class="text-ink-soft text-lg mb-6">{s.lead}</p>
          <div class="space-y-4 text-ink-soft">
            {s.items.map((item) => (
              <div class="flex gap-3">
                <span class="text-mint-ink flex-shrink-0" aria-hidden="true">&#10003;</span>
                <span><strong class="text-[#0F2D2D]">{item.t}</strong>: {item.d}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <ProductTour region="us" noun="team" />

    <!-- Role highlights -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-4">Built for every role</h2>
        <p class="text-ink-soft text-lg max-w-2xl mx-auto">
          Each person on your team sees exactly what they need. No clutter, no confusion.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {roles.map((r) => (
          <div class:list={["p-6 rounded-2xl bg-gradient-to-b to-transparent border", r.tone]}>
            <p class="text-lg font-semibold text-[#0F2D2D] mb-2">{r.name}</p>
            <p class="text-sm text-ink-soft">{r.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- USA Swimming context -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-[#85FFC7]/15 rounded-2xl border border-[#1F7A52]/20 p-8 sm:p-10">
        <h2 class="font-display text-2xl text-[#0F2D2D] mb-4">Made for US swim teams</h2>
        <p class="text-ink-soft mb-4">
          Many competitive swim teams in the United States are members of USA
          Swimming, the national governing body for the sport. Swimly keeps the
          membership, billing, attendance, and safeguarding records your team
          depends on organized in one place.
        </p>
        <p class="text-ink-soft">
          You stay in control of what you record and report. Swimly gives you a
          single, tidy system instead of a folder of spreadsheets.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-6">Ready to simplify team management?</h2>
      <p class="text-xl text-ink-soft mb-8">Create your team today. Free for teams under 50 athletes, no card required.</p>
      <a
        href={`${appUrl}/create-club`}
        class="inline-block text-lg font-semibold px-8 py-4 min-h-12 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors"
      >
        Start your team, free
      </a>
    </section>
  </main>
  <Footer />
</Layout>
