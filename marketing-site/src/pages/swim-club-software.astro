        </a>
        <a href="/swimming-club-billing-software/" class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all">
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Billing Software</h3>
          <p class="text-ink-mute text-sm">How automated Direct Debit collection works</p>
        </a>
        <a href="/swim-school-management/" class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all">
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Swim School Management</h3>
          <p class="text-ink-mute text-sm">Features for learn-to-swim programmes</p>
        </a>
        <a href="/features/membership/" class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all">
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Membership Management</h3>
          <p class="text-ink-mute text-sm">Member database, renewals, and family accounts</p>
        </a>
        <a href="/features/compliance/" class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all">
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Safeguarding Compliance</h3>
          <p class="text-ink-mute text-sm">DBS tracking and Wavepower compliance</p>
        </a>
        <a href="/faq/" class="block p-6 bg-surface-raised rounded-xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:shadow-[0_12px_32px_-12px_rgba(15,45,45,0.2)] transition-all">
          <h3 class="text-lg font-semibold text-[#0F2D2D] mb-2">Frequently Asked Questions</h3>
          <p class="text-ink-mute text-sm">Common questions about swim club software</p>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="font-display text-3xl text-[#0F2D2D] mb-6">Simplify your swim club management</h2>
      <p class="text-xl text-ink-soft mb-8">Create your club today, free, or join the founding clubs programme for 6 months free on any plan.</p>
      <a
        href="https://app.swimly.uk/create-club"
        class="inline-block text-lg font-semibold px-8 py-4 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-all shadow-[0_8px_20px_-8px_rgba(255,133,82,0.6)]"
