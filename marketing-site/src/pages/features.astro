---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Swim Club Software Features | Swimly UK';
const description = 'Membership database, automated billing, attendance registers, and Wavepower compliance. See every feature Swimly offers UK swimming clubs.';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://swimly.uk/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Features",
      "item": "https://swimly.uk/features/"
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  <Nav />
  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[500px] pointer-events-none" aria-hidden="true"></div>
      <div class="relative text-center">
        <p class="eyebrow mb-6">Purpose-built for UK swimming clubs</p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-[#0F2D2D] mb-6 leading-tight">
          Everything your<br class="hidden sm:block" />
          <em class="text-mint-ink">swim club needs</em>
        </h1>
        <p class="text-xl text-ink-soft max-w-2xl mx-auto leading-relaxed">
          Membership, billing, attendance, safeguarding, and communication in one platform. Built by a swim parent who got tired of the spreadsheet chaos.
        </p>
      </div>

      <!-- Quick nav pills -->
      <div class="relative flex flex-wrap justify-center gap-3 mt-10">
        <a href="#membership-management" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Membership</a>
        <a href="#automated-billing" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Billing</a>
        <a href="#session-scheduling" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Sessions</a>
        <a href="#financial-reporting" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Reporting</a>
        <a href="#communication" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Communication</a>
        <a href="#safeguarding" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Safeguarding</a>
        <a href="#roadmap" class="px-4 py-2 rounded-full bg-surface-raised border border-[#39393A]/10 text-sm text-ink-soft hover:border-[#297373]/40 hover:text-[#0F2D2D] transition-colors">Roadmap</a>
      </div>
    </section>

    <!-- Stats bar -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">6</p>
          <p class="text-sm text-ink-mute mt-1">Core modules</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">Free</p>
          <p class="text-sm text-ink-mute mt-1">Under 50 members</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">100%</p>
          <p class="text-sm text-ink-mute mt-1">UK-hosted &amp; GDPR</p>
        </div>
        <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-6 text-center">
          <p class="font-display text-4xl sm:text-5xl text-[#0F2D2D]">&pound;29</p>
          <p class="text-sm text-ink-mute mt-1">Flat rate per month</p>
        </div>
      </div>
    </section>

    <!-- Membership Management -->
    <section id="membership-management" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-mint-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">Membership Management</h2>
            <p class="text-ink-soft text-lg mb-6">
              Simple, modern member database that parents can update themselves. No more chasing paper forms or maintaining spreadsheets. <a href="/features/membership/" class="text-mint-ink hover:text-[#0F2D2D] underline underline-offset-2">Explore membership features</a>.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-ink-soft">
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Online registration</strong>: Parents sign up through a web form. No printable PDFs or scanning.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Family grouping</strong>: Link siblings together for billing and communication. One invoice per family.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Self-service portal</strong>: Parents update contact details, emergency contacts, and medical information without emailing the secretary.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Squad assignments</strong>: Organise members into training groups. Move swimmers between squads as they progress.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Custom fields</strong>: Track swimming levels, medical conditions, or any club-specific data.</span>
          </div>
        </div>
        <div class="mt-8 flex flex-col md:flex-row items-center justify-center gap-8">
          <div class="w-full max-w-2xl">
            <picture>
              <source srcset="/mockups/swimmers-macbook.webp" type="image/webp" />
              <img src="/mockups/swimmers-macbook.png" alt="Swimly swimmers management page on a MacBook showing member database with search and filtering" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
          <div class="w-full max-w-[180px] sm:max-w-[200px]">
            <picture>
              <source srcset="/mockups/swimmers-iphone.webp" type="image/webp" />
              <img src="/mockups/swimmers-iphone.png" alt="Swimly swimmers list on an iPhone for poolside access" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <!-- Automated Billing -->
    <section id="automated-billing" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-mint-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <div>
            <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">Automated Billing & Payments</h2>
            <p class="text-ink-soft text-lg mb-6">
              Direct Debit collection through GoCardless means membership fees arrive automatically every month. No more chasing parents or reconciling bank statements. <a href="/swimming-club-billing-software/" class="text-mint-ink hover:text-[#0F2D2D] underline underline-offset-2">See how automated billing works</a>.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-ink-soft">
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Direct Debit via GoCardless</strong>: Collect monthly, quarterly, or annual fees automatically from members' bank accounts.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Flexible payment schedules</strong>: Set different fee amounts for different squads or membership types.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Automatic retry on failures</strong>: Failed payments are automatically retried. Parents receive notifications if action is needed.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Invoice generation</strong>: Automatic invoices sent to parents and stored in their portal for download.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Payment tracking</strong>: See which members are paid up and who has outstanding balances at a glance.</span>
          </div>
        </div>
        <div class="mt-8 flex flex-col md:flex-row items-center justify-center gap-8">
          <div class="w-full max-w-2xl">
            <picture>
              <source srcset="/mockups/billing-macbook.webp" type="image/webp" />
              <img src="/mockups/billing-macbook.png" alt="Swimly billing dashboard on a MacBook showing invoices, outstanding payments, and revenue collected" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
          <div class="w-full max-w-[180px] sm:max-w-[200px]">
            <picture>
              <source srcset="/mockups/billing-iphone.webp" type="image/webp" />
              <img src="/mockups/billing-iphone.png" alt="Swimly billing view on an iPhone for on-the-go payment tracking" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <!-- Role highlights -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-4">Built for every role</h2>
        <p class="text-ink-soft text-lg max-w-2xl mx-auto">
          Each person in your club sees exactly what they need. No clutter, no confusion.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-6 rounded-2xl bg-gradient-to-b from-[#85FFC7]/20 to-transparent border border-[#1F7A52]/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Treasurer</p>
          <p class="text-sm text-ink-soft">Revenue overview, outstanding payments, export reports for AGM, reconciliation dashboard.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-b from-blue-500/10 to-transparent border border-blue-500/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Membership Sec</p>
          <p class="text-sm text-ink-soft">Member database, family grouping, squad assignments, registration approvals.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-b from-amber-500/10 to-transparent border border-amber-500/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Coach</p>
          <p class="text-sm text-ink-soft">Poolside attendance, session registers, swimmer profiles, squad rosters on mobile.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-b from-purple-500/10 to-transparent border border-purple-500/20">
          <p class="text-lg font-semibold text-[#0F2D2D] mb-2">Parent</p>
          <p class="text-sm text-ink-soft">Payment history, upcoming sessions, update contact details, view balances.</p>
        </div>
      </div>
    </section>

    <!-- Session Scheduling -->
    <section id="session-scheduling" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-mint-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">Session Scheduling & Attendance</h2>
            <p class="text-ink-soft text-lg mb-6">
              Manage your pool time, assign swimmers to lanes, and track who's attending. Members see their upcoming sessions; coaches see their rotas. <a href="/features/attendance/" class="text-mint-ink hover:text-[#0F2D2D] underline underline-offset-2">Learn about attendance tracking</a>.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-ink-soft">
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Visual lane planner</strong>: Assign squads to lanes and see your pool layout at a glance.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Recurring session templates</strong>: Set up your weekly schedule once, then repeat it automatically.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Quick check-in/out</strong>: Mark attendance with a tap. See who's present at each session.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Coaching rotas</strong>: Assign coaches to sessions. Track who's covering which group each week.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Session changes</strong>: Cancel or reschedule a session and automatically notify affected members.</span>
          </div>
        </div>
        <div class="mt-8 flex flex-col md:flex-row items-center justify-center gap-8">
          <div class="w-full max-w-2xl">
            <picture>
              <source srcset="/mockups/sessions-macbook.webp" type="image/webp" />
              <img src="/mockups/sessions-macbook.png" alt="Swimly session scheduling on a MacBook showing upcoming training sessions and weekly calendar" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
          <div class="w-full max-w-[180px] sm:max-w-[200px]">
            <picture>
              <source srcset="/mockups/sessions-iphone.webp" type="image/webp" />
              <img src="/mockups/sessions-iphone.png" alt="Swimly sessions on an iPhone for poolside coaching" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <!-- Financial Reporting -->
    <section id="financial-reporting" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-mint-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <div>
            <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">Financial Overview & Reporting</h2>
            <p class="text-ink-soft text-lg mb-6">
              Real-time financial dashboard showing club income and expenses. Export detailed reports for your AGM without digging through bank statements.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-ink-soft">
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Income dashboard</strong>: See total membership revenue, outstanding payments, and collection rates.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Payment reconciliation</strong>: Direct Debit collections are automatically reconciled with member accounts.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Exportable reports</strong>: Generate CSV or PDF reports for your treasurer, auditor, or AGM presentation.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Competition fee tracking</strong>: Link gala entry fees to member accounts for transparent billing.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Historical data</strong>: View income trends month-by-month or year-by-year for planning.</span>
          </div>
        </div>
        <div class="mt-8 flex flex-col md:flex-row items-center justify-center gap-8">
          <div class="w-full max-w-2xl">
            <picture>
              <source srcset="/mockups/dashboard-macbook.webp" type="image/webp" />
              <img src="/mockups/dashboard-macbook.png" alt="Swimly financial dashboard on a MacBook showing revenue collected, outstanding payments, and session summary" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
          <div class="w-full max-w-[180px] sm:max-w-[200px]">
            <picture>
              <source srcset="/mockups/dashboard-iphone.webp" type="image/webp" />
              <img src="/mockups/dashboard-iphone.png" alt="Swimly dashboard on an iPhone for quick financial overview" class="w-full h-auto" loading="lazy" />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <!-- Communication -->
    <section id="communication" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] p-8 lg:p-12">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 rounded-xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-mint-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </div>
          <div>
            <h2 class="font-display text-3xl text-[#0F2D2D] mb-4">Smart Notifications & Communication</h2>
            <p class="text-ink-soft text-lg mb-6">
              Keep members informed without relying on WhatsApp group chats. Automated reminders and targeted announcements delivered by email. Parents can manage preferences through the <a href="/features/parent-portal/" class="text-mint-ink hover:text-[#0F2D2D] underline underline-offset-2">parent portal</a>.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-ink-soft">
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Session change notifications</strong>: Cancel or move a session and affected members are automatically emailed.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Payment reminders</strong>: Automatic reminders for outstanding balances or upcoming renewals.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-mint-ink flex-shrink-0">✓</span>
            <span><strong class="text-[#0F2D2D]">Club announcements</strong>: Send targeted messages to specific squads or the whole club.</span>
          </div>
          <div class="flex gap-3">
