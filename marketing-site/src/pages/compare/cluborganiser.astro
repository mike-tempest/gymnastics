---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ArrowRight, Zap, Shield, Smartphone, Users } from '@lucide/astro';

const title = 'Club Organiser vs Swimly: UK Swim Club Software Comparison 2026';
const description = 'Comparing Club Organiser and Swimly for UK swimming clubs. Both offer swim-specific features, but Swimly delivers modern automation, transparent pricing from £29/month, and zero configuration. See which platform suits your club.';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://swimly.uk/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": "https://swimly.uk/compare/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "ClubOrganiser",
      "item": "https://swimly.uk/compare/cluborganiser"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does Club Organiser cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Club Organiser costs £480 per year (£40 per month), which includes club software and a hosted club website. This price covers unlimited members and most core features, with additional costs for SMS messaging (8p per message) and emails above 3,500 per month. Swimly offers transparent flat pricing from £29 per month with all features included."
      }
    },
    {
      "@type": "Question",
      "name": "Does Club Organiser work for swimming clubs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Club Organiser has swimming-specific features including time conversion, Hy-Tek and SportSystems compatibility, personal best tracking, and club records storage for both short and long course. It serves swimming clubs alongside other sports clubs. Swimly is exclusively built for swimming clubs with modern features like automated billing and zero-configuration setup."
      }
    },
    {
      "@type": "Question",
      "name": "What are the main differences between Club Organiser and Swimly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Club Organiser is an established platform serving multiple sports with swimming features added over time. Swimly is built exclusively for swimming clubs with modern automation and requires no configuration. Key differences: Swimly offers automated Direct Debit collection, mobile-first design, 30-minute setup, and transparent pricing from £29/month. Club Organiser costs £40/month, includes a hosted website, and serves multiple sports."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch from Club Organiser to Swimly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can migrate from Club Organiser to Swimly. Swimly's setup process includes importing member data, and our support team can assist with the transition. Because both platforms understand swimming club structures, migrating swimmer data, squad assignments, and membership information is straightforward."
      }
    },
    {
      "@type": "Question",
      "name": "What features does Club Organiser have that Swimly doesn't?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Club Organiser includes a hosted club website as part of the package, supports multiple sports within one organisation, and has been established for many years with extensive legacy integrations. Swimly focuses exclusively on club management software with modern automation and does not currently include website hosting, instead offering superior mobile experience and automated billing workflows."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Nav />
  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none"></div>
      <div class="relative">
        <p class="eyebrow mb-6">Platform comparison</p>
        <h1 class="font-display text-4xl sm:text-5xl text-[#0F2D2D] mb-6">
          Club Organiser vs Swimly
        </h1>
        <p class="text-xl text-ink-soft max-w-3xl">
          Club Organiser has been serving UK sports clubs for years with swimming-specific features including time tracking and meet management. Swimly is the modern alternative, built exclusively for swimming clubs with automated billing, mobile-first design, and zero configuration required.
        </p>

        <!-- Platform vs Platform -->
        <div class="flex items-center justify-center gap-4 sm:gap-8 mt-10 mb-10">
          <div class="text-center">
            <p class="font-display text-2xl sm:text-3xl text-mint-ink">Swimly</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">Modern platform</p>
          </div>
          <div class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#FF8552]/15 border-2 border-[#FF8552]/40">
            <span class="font-display text-xl sm:text-2xl text-[#C2410C]">vs</span>
          </div>
          <div class="text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">ClubOrganiser</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">Legacy platform</p>
          </div>
        </div>

        <!-- Key stats row - enhanced visual impact -->
        <div class="grid grid-cols-3 gap-4 sm:gap-6">
          <div class="relative group bg-[#85FFC7]/15 border border-[#1F7A52]/20 rounded-2xl p-5 sm:p-8 text-center hover:border-[#1F7A52]/30 transition-all">
            <p class="relative font-display text-5xl sm:text-7xl text-mint-ink tracking-tight">100%</p>
            <p class="relative text-sm sm:text-base text-ink-soft mt-2 font-medium">swimming-focused</p>
          </div>
          <div class="relative group bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-2xl p-5 sm:p-8 text-center hover:border-[#297373]/30 transition-all">
            <p class="relative font-display text-5xl sm:text-7xl text-[#0F2D2D] tracking-tight">30<span class="text-3xl sm:text-4xl text-ink-mute">min</span></p>
            <p class="relative text-sm sm:text-base text-ink-soft mt-2 font-medium">setup time</p>
          </div>
          <div class="relative group bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-2xl p-5 sm:p-8 text-center hover:border-[#297373]/30 transition-all">
            <p class="relative font-display text-5xl sm:text-7xl text-[#0F2D2D] tracking-tight">Zero</p>
            <p class="relative text-sm sm:text-base text-ink-soft mt-2 font-medium">config needed</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Differences at a Glance -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl text-[#0F2D2D] mb-4">Key differences at a glance</h2>
        <p class="text-lg text-ink-soft max-w-2xl mx-auto">The three things that matter most when choosing between Club Organiser and Swimly.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Pricing -->
        <div class="relative p-8 rounded-2xl bg-[#85FFC7]/15 border border-[#1F7A52]/20">
          <div class="w-14 h-14 rounded-2xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-[#0F2D2D] mb-3">Transparent pricing</h3>
          <p class="text-ink-soft text-sm leading-relaxed mb-4">Swimly is <strong class="text-mint-ink">£29/month flat</strong> with everything included. Club Organiser charges £40/month plus 8p per SMS and extra for emails over 3,500.</p>
          <div class="flex items-center gap-3 pt-4 border-t border-[#1F7A52]/20">
            <span class="font-display text-2xl text-mint-ink">£132</span>
            <span class="text-sm text-ink-mute">saved per year vs Club Organiser</span>
          </div>
        </div>
        <!-- Mobile-first -->
        <div class="relative p-8 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-all">
          <div class="w-14 h-14 rounded-2xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-[#0F2D2D] mb-3">Mobile-first, not mobile-adapted</h3>
          <p class="text-ink-soft text-sm leading-relaxed mb-4">Coaches take attendance poolside on their phone. Swimly is designed for wet hands and bright sunshine, not retrofitted from a desktop interface.</p>
          <div class="flex items-center gap-3 pt-4 border-t border-[#39393A]/10">
            <span class="text-sm text-ink-soft">Works offline with patchy pool WiFi</span>
          </div>
        </div>
        <!-- Automated billing -->
        <div class="relative p-8 rounded-2xl bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] hover:border-[#297373]/30 transition-all">
          <div class="w-14 h-14 rounded-2xl bg-[#85FFC7]/20 border border-[#1F7A52]/15 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-mint-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-[#0F2D2D] mb-3">Truly automated billing</h3>
          <p class="text-ink-soft text-sm leading-relaxed mb-4">Set up Direct Debit once and fees collect themselves via GoCardless. No more chasing standing orders, no manual reconciliation, no late payment spreadsheets.</p>
          <div class="flex items-center gap-3 pt-4 border-t border-[#39393A]/10">
            <span class="text-sm text-ink-soft">10+ hours saved per month for Treasurers</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Table - enhanced visual indicators -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-surface-raised rounded-2xl border border-[#39393A]/10 overflow-hidden shadow-[0_1px_3px_rgba(57,57,58,0.08)]">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-[#39393A]/8 bg-surface">
                <th class="text-left p-4 sm:p-6 text-[#0F2D2D] font-semibold text-base sm:text-lg">Feature</th>
                <th class="text-left p-4 sm:p-6 text-mint-ink font-semibold text-base sm:text-lg bg-[#85FFC7]/10">
                  <div class="flex items-center gap-2">
                    <span>Swimly</span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[#85FFC7]/20 text-mint-ink text-xs font-semibold">Modern</span>
                  </div>
                </th>
                <th class="text-left p-4 sm:p-6 text-[#0F2D2D] font-semibold text-base sm:text-lg">ClubOrganiser</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#39393A]/8">
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Target Market</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-mint-ink font-medium">Swimming clubs exclusively</span>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-[#B91C1C]/70 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span class="text-ink-soft">Multi-sport platform (swimming, football, etc.)</span>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Pricing</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div>
                      <span class="text-mint-ink font-semibold">From £29/month</span>
                      <p class="text-xs text-ink-mute mt-0.5">Transparent flat fee</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <span class="text-ink-soft">£40/month (£480/year)</span>
                  <p class="text-xs text-ink-mute mt-0.5">Includes hosted website</p>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Setup Time</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div>
                      <span class="text-mint-ink font-semibold">30 minutes</span>
                      <p class="text-xs text-ink-mute mt-0.5">Swimming defaults pre-configured</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-[#B91C1C]/70 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span class="text-ink-soft">Manual configuration required for club structure</span>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Payment Automation</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div>
                      <span class="text-mint-ink font-semibold">Automated Direct Debit</span>
                      <p class="text-xs text-ink-mute mt-0.5">Fully integrated via GoCardless</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-[#B91C1C]/70 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <div>
                      <span class="text-ink-soft">GoCardless and Stripe supported</span>
                      <p class="text-xs text-ink-mute mt-0.5">Manual setup required</p>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Swimming Features</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-mint-ink font-medium">Squad levels, lane assignments, modern meet entry</span>
                  </div>
                </td>
                <td class="p-4 sm:p-6 text-ink-soft">Time conversion, PB tracking, Hy-Tek/SportSystems import</td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Mobile Experience</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div>
                      <span class="text-mint-ink font-semibold">Mobile-first design</span>
                      <p class="text-xs text-ink-mute mt-0.5">Works offline poolside</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-[#B91C1C]/70 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span class="text-ink-soft">Responsive platform via app icon</span>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Club Website</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-ink-faint shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span class="text-ink-soft">Not included (management platform only)</span>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-mint-ink font-medium">Hosted club website included in price</span>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Meet Management</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-mint-ink font-medium">Integrated entries, payments, and eligibility tracking</span>
                  </div>
                </td>
                <td class="p-4 sm:p-6 text-ink-soft">Hy-Tek/SportSystems compatibility, eligibility lists</td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Swim England Integration</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-ink-faint shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="text-ink-soft">Planned for 2026 roadmap</span>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-mint-ink font-medium">OMS integration for member setup and updates</span>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="p-4 sm:p-6 text-[#0F2D2D] font-semibold">Additional Costs</td>
                <td class="p-4 sm:p-6 bg-[#85FFC7]/10">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-mint-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div>
                      <span class="text-mint-ink font-semibold">None</span>
                      <p class="text-xs text-ink-mute mt-0.5">All features included</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 sm:p-6">
                  <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-[#B91C1C]/70 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
