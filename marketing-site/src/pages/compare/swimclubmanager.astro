---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ArrowRight, Smartphone, CreditCard, PoundSterling, Users, Zap, Shield } from '@lucide/astro';

const title = 'Swimly vs SwimClub Manager | 46% Less Per Year';
const description = 'Compare Swimly and SwimClub Manager for UK clubs in 2026. Modern features, automated Direct Debit, and flat pricing at 46% less per year. Updated March 2026.';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://swimly.uk/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": "https://swimly.uk/compare/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "SwimClub Manager",
      "item": "https://swimly.uk/compare/swimclubmanager"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does Swimly compare to SwimClub Manager?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Swimly offers a modern, mobile-first platform with automated Direct Debit billing through GoCardless, while SwimClub Manager provides a more established desktop-focused system. Swimly costs £348/year compared to SwimClub Manager's £649/year, making it 46% cheaper annually. Both platforms offer comprehensive membership management, but Swimly emphasises ease of use and modern web technology."
      }
    },
    {
      "@type": "Question",
      "name": "Is Swimly cheaper than SwimClub Manager?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Swimly is significantly cheaper. At £29/month (£348/year), Swimly costs 46% less than SwimClub Manager's £649 annual fee. This saves clubs over £300 per year whilst providing modern features, automated billing, and a mobile-first design."
      }
    },
    {
      "@type": "Question",
      "name": "Can I migrate from SwimClub Manager to Swimly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can migrate from SwimClub Manager to Swimly. Swimly's setup takes approximately 30 minutes and includes importing your member database. There are no lock-in contracts, so you can switch platforms easily. Our support team can assist with the migration process to ensure a smooth transition for your club."
      }
    },
    {
      "@type": "Question",
      "name": "Does Swimly work on mobile devices like SwimClub Manager?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, and Swimly is actually built mobile-first. Whilst SwimClub Manager offers separate iOS and Android apps, Swimly delivers a fully responsive web experience that works seamlessly on any device from a single URL, with no separate apps needed. This makes it easier for committee members and parents to access the system anywhere."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Nav />
  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="dot-grid absolute inset-x-0 top-0 h-[600px] pointer-events-none"></div>
      <div class="relative">
        <p class="eyebrow mb-6">Platform comparison</p>
        <h1 class="font-display text-4xl sm:text-5xl text-[#0F2D2D] mb-6">
          Swimly vs SwimClubManager
        </h1>
        <p class="text-xl text-ink-soft max-w-3xl">
          SwimClubManager has been serving UK clubs since 2009 and continues to ship regular updates. Swimly is the modern alternative, built from scratch with automated payments, mobile-first design, and transparent pricing at nearly half the cost.
        </p>

        <!-- Key stats row -->
        <div class="grid grid-cols-3 gap-4 mt-10">
          <div class="bg-[#85FFC7]/10 border border-[#1F7A52]/20 rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">46%</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">cheaper per year</p>
          </div>
          <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">30 min</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">setup time</p>
          </div>
          <div class="bg-surface-raised border border-[#39393A]/10 shadow-[0_1px_3px_rgba(57,57,58,0.08)] rounded-xl p-4 text-center">
            <p class="font-display text-2xl sm:text-3xl text-[#0F2D2D]">No</p>
            <p class="text-xs sm:text-sm text-ink-mute mt-1">lock-in contract</p>
