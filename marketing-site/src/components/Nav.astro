---
import RegionSwitcher from "./RegionSwitcher.astro";
import { REGIONS, regionFromPath } from "../config/regions";

const path = Astro.url.pathname;
const isHub = path === "/international/" || path.startsWith("/international/");
const region = regionFromPath(path);
const prefix = REGIONS[region].pathPrefix;
const appUrl = REGIONS[region].appUrl;
const isUK = region === "uk" && !isHub;
const isIntl = region !== "uk"; // us/ca/au

const loginUrl = `${appUrl}/login`;
const signupUrl = `${appUrl}/create-club`;

const features = [
  { label: "Membership Management", href: "/features/membership", desc: "Member database and renewals" },
  { label: "Automated Billing", href: "/features/billing", desc: "Direct Debit and invoicing" },
  { label: "Attendance Tracking", href: "/features/attendance", desc: "Digital poolside registers" },
  { label: "Wavepower Compliance", href: "/features/compliance", desc: "DBS and safeguarding tracking" },
  { label: "Parent Portal", href: "/features/parent-portal", desc: "Self-service for families" },
  { label: "Mobile App", href: "/features/mobile", desc: "Access anywhere, offline mode" },
  { label: "Competitions", href: "/features/competitions", desc: "Hy-Tek and SportSystems support" },
];

const competitors = [
  { label: "Swim Club Manager", href: "/compare/swimclubmanager", desc: "Feature-by-feature comparison" },
  { label: "TeamUnify", href: "/compare/teamunify", desc: "US-centric vs UK-built" },
  { label: "Club Organiser", href: "/compare/cluborganiser", desc: "Legacy system comparison" },
  { label: "GoMotion", href: "/compare/gomotion", desc: "See how we differ" },
  { label: "ClubSpark", href: "/compare/clubspark", desc: "LTA platform comparison" },
];

const solutions = [
  { label: "Swim School Management", href: "/swim-school-management", desc: "Run lessons, track progress" },
  { label: "Billing & Payments", href: "/swimming-club-billing-software", desc: "Collect fees effortlessly" },
];

const menuLink = "text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md inline-flex items-center gap-1";

// Region home + reduced menu links for the international editions (us/ca/au).
const homeHref = isHub ? "/" : `${prefix}/`;
const intlFeaturesHref = `${prefix}/features/`;
const intlPricingHref = `${prefix}/pricing/`;
const intlClubsHref = `${prefix}/clubs/`;
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-canvas/85 backdrop-blur-xl border-b border-[#39393A]/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[68px]">
      <!-- Logo -->
      <a href={homeHref} class="font-display text-[26px] text-[#0F2D2D] tracking-tight leading-none">Swimly</a>

      {isUK && (
        <!-- Desktop nav (UK) -->
        <div class="hidden md:flex items-center gap-1">
          <!-- Features dropdown -->
          <div class="relative group">
            <button class={menuLink} aria-haspopup="true">
              Features
              <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 invisible translate-y-1 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
              <div class="bg-surface-raised border border-[#39393A]/10 rounded-xl shadow-[0_16px_40px_-12px_rgba(15,45,45,0.25)] overflow-hidden py-2">
                {features.map(item => (
                  <a href={item.href} class="flex flex-col gap-0.5 px-4 py-2.5 hover:bg-[#85FFC7]/15 transition-colors group/item">
                    <span class="text-sm font-medium text-[#0F2D2D] group-hover/item:text-mint-ink">{item.label}</span>
                    <span class="text-xs text-ink-faint">{item.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/pricing/" class="text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Pricing</a>

          <!-- Compare dropdown -->
          <div class="relative group">
            <button class={menuLink} aria-haspopup="true">
              Compare
              <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 invisible translate-y-1 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
              <div class="bg-surface-raised border border-[#39393A]/10 rounded-xl shadow-[0_16px_40px_-12px_rgba(15,45,45,0.25)] overflow-hidden py-2">
                {competitors.map(item => (
                  <a href={item.href} class="flex flex-col gap-0.5 px-4 py-2.5 hover:bg-[#85FFC7]/15 transition-colors group/item">
                    <span class="text-sm font-medium text-[#0F2D2D] group-hover/item:text-mint-ink">{item.label}</span>
                    <span class="text-xs text-ink-faint">{item.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Solutions dropdown -->
          <div class="relative group">
            <button class={menuLink} aria-haspopup="true">
              Solutions
              <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 invisible translate-y-1 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
              <div class="bg-surface-raised border border-[#39393A]/10 rounded-xl shadow-[0_16px_40px_-12px_rgba(15,45,45,0.25)] overflow-hidden py-2">
                {solutions.map(item => (
                  <a href={item.href} class="flex flex-col gap-0.5 px-4 py-2.5 hover:bg-[#85FFC7]/15 transition-colors group/item">
                    <span class="text-sm font-medium text-[#0F2D2D] group-hover/item:text-mint-ink">{item.label}</span>
                    <span class="text-xs text-ink-faint">{item.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/blog/" class="text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Blog</a>
          <a href="/about/" class="text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">About</a>

          <RegionSwitcher class="ml-2" />

          <a href={loginUrl} class="ml-1 text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Log in</a>
          <a
            href={signupUrl}
            class="ml-1 text-[15px] font-bold px-5 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors min-h-12 inline-flex items-center shadow-[0_1px_3px_rgba(57,57,58,0.16)]"
          >
            Start your club
          </a>
        </div>
      )}

      {isIntl && (
        <!-- Desktop nav (US/CA/AU) -->
        <div class="hidden md:flex items-center gap-1">
          <a href={intlFeaturesHref} class="text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Features</a>
          <a href={intlPricingHref} class="text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Pricing</a>
          <a href={intlClubsHref} class="text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Find a Club</a>

          <RegionSwitcher class="ml-2" />

          <a href={loginUrl} class="ml-1 text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Log in</a>
          <a
            href={signupUrl}
            class="ml-1 text-[15px] font-bold px-5 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors min-h-12 inline-flex items-center shadow-[0_1px_3px_rgba(57,57,58,0.16)]"
          >
            Start your club
          </a>
        </div>
      )}

      {isHub && (
        <!-- Desktop nav (international hub) -->
        <div class="hidden md:flex items-center gap-1">
          <RegionSwitcher class="ml-2" />

          <a href={loginUrl} class="ml-1 text-[15px] text-ink-mute hover:text-[#0F2D2D] transition-colors px-3 py-2 rounded-md">Log in</a>
          <a
            href={signupUrl}
            class="ml-1 text-[15px] font-bold px-5 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors min-h-12 inline-flex items-center shadow-[0_1px_3px_rgba(57,57,58,0.16)]"
          >
            Start your club
          </a>
        </div>
      )}

      <!-- Mobile: hamburger + CTA -->
      <div class="flex items-center gap-3 md:hidden">
        <a
          href={signupUrl}
          class="text-sm font-bold px-4 rounded-xl bg-lime-cta text-[#0F2D2D] hover:bg-lime-cta-hover transition-colors min-h-12 inline-flex items-center"
        >
          Sign up
        </a>
        <button
          id="mobile-menu-btn"
          class="text-ink-mute hover:text-[#0F2D2D] transition-colors p-2"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#39393A]/10 bg-canvas/97 backdrop-blur-xl max-h-[calc(100vh-68px)] overflow-y-auto">
    <div class="px-4 py-4 space-y-1">
      {isUK && (
        <>
          <a href={loginUrl} class="block px-3 py-2.5 text-[15px] font-semibold text-mint-ink hover:bg-[#85FFC7]/15 rounded-md transition-colors">Log in to your club</a>
          <a href="/pricing/" class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Pricing</a>
          <a href="/clubs/map/" class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Find a Club</a>
          <a href="/blog/" class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Blog</a>
          <a href="/about/" class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">About</a>
          <a href="/faq/" class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">FAQ</a>

          <div class="pt-3 pb-1">
            <p class="px-3 text-xs font-semibold text-ink-faint uppercase tracking-wider">Features</p>
          </div>
          {features.map(item => (
            <a href={item.href} class="block px-3 py-2.5 pl-6 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">{item.label}</a>
          ))}

          <div class="pt-3 pb-1">
            <p class="px-3 text-xs font-semibold text-ink-faint uppercase tracking-wider">Compare</p>
          </div>
          {competitors.map(item => (
            <a href={item.href} class="block px-3 py-2.5 pl-6 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">{item.label}</a>
          ))}

          <div class="pt-3 pb-1">
            <p class="px-3 text-xs font-semibold text-ink-faint uppercase tracking-wider">Solutions</p>
          </div>
          {solutions.map(item => (
            <a href={item.href} class="block px-3 py-2.5 pl-6 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">{item.label}</a>
          ))}
        </>
      )}

      {isIntl && (
        <>
          <a href={loginUrl} class="block px-3 py-2.5 text-[15px] font-semibold text-mint-ink hover:bg-[#85FFC7]/15 rounded-md transition-colors">Log in to your club</a>
          <a href={homeHref} class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Home</a>
          <a href={intlFeaturesHref} class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Features</a>
          <a href={intlPricingHref} class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Pricing</a>
          <a href={intlClubsHref} class="block px-3 py-2.5 text-[15px] text-ink-soft hover:text-[#0F2D2D] hover:bg-[#85FFC7]/15 rounded-md transition-colors">Find a Club</a>
        </>
      )}

      {isHub && (
        <>
          <a href={loginUrl} class="block px-3 py-2.5 text-[15px] font-semibold text-mint-ink hover:bg-[#85FFC7]/15 rounded-md transition-colors">Log in to your club</a>
        </>
      )}

      <div class="pt-3 pb-1">
        <p class="px-3 text-xs font-semibold text-ink-faint uppercase tracking-wider">Region</p>
      </div>
      <div class="px-3">
        <RegionSwitcher />
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
