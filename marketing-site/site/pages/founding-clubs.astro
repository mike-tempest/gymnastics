---
import Layout from '../layouts/Layout.astro';
import { BRAND, contactEmail } from '../config';
---
<Layout title="Founding clubs" description="Help shape Tumblebase around the everyday work of running a gymnastics club. Founding-club programme information.">
  <section class="wrap grid gap-12 py-16 lg:grid-cols-[1.2fr_1fr] lg:py-24"><div><p class="eyebrow">The founding-club programme</p><h1 class="mt-5 font-display text-5xl leading-tight sm:text-6xl">Help shape a better<br />club routine.</h1><p class="prose-copy mt-7 max-w-xl">We’re preparing {BRAND.name} for its first gymnastics clubs. The programme will focus on the everyday work of welcoming families, collecting fees and keeping club records organised.</p><p class="prose-copy mt-5 max-w-xl">Your club’s experience will help us understand what makes switching easier, and what needs to work smoothly from the first session.</p></div><div class="rounded-3xl bg-sage-light p-8 sm:p-10"><h2 class="font-display text-3xl">Where we are today</h2><p class="prose-copy mt-5">We’re finalising launch arrangements and the founding-club offer. Pricing, onboarding support and programme terms will be confirmed before applications open.</p>{contactEmail ? <a class="button mt-7" href={`mailto:${contactEmail}?subject=Tumblebase%20founding%20club%20enquiry`}>Ask about the programme <span aria-hidden="true">↗</span></a> : <p class="mt-7 rounded-xl border border-forest/20 p-4 text-sm font-medium">Applications are not open yet. Programme details will appear here when they’re ready.</p>}</div></section>
  <section class="wrap pb-20"><p class="eyebrow">The conversations that matter</p><div class="mt-8 grid gap-8 md:grid-cols-3">{[['Welcoming families', 'How do you manage your waiting list, offer places and collect the right information?'],['Getting paid', 'What does collecting and reconciling class fees look like for your club today?'],['Keeping organised', 'Where do you keep registers, staff credentials and award progress, and what gets missed?']].map(([title, copy]) => <article class="border-t border-line pt-6"><h2 class="text-xl font-semibold">{title}</h2><p class="prose-copy mt-4">{copy}</p></article>)}</div></section>
</Layout>
