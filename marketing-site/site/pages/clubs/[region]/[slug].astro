---
import Layout from '../../../layouts/Layout.astro';
import { BRAND, contactEmail } from '../../../config';
import { clubs, clubPath, regionPath, slugify, absolute, jsonLd, formatDate } from '../../../lib/clubs';
export function getStaticPaths() {
  return clubs.map(club => ({ params: { region: slugify(club.region), slug: club.slug }, props: { club } }));
}
const { club } = Astro.props;
const others = clubs.filter(other => other.slug !== club.slug && other.region === club.region).sort((a, b) => Number(b.town === club.town) - Number(a.town === club.town)).slice(0, 4);
const url = absolute(clubPath(club));
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'SportsOrganization', '@id': `${url}#club`, name: club.name, sport: 'Gymnastics', url: club.website || club.sources[0].url, location: club.addresses.map(address => ({ '@type': 'Place', address: { '@type': 'PostalAddress', streetAddress: address, addressCountry: 'GB' } })) },
  { '@type': 'WebPage', '@id': url, url, name: `${club.name} in ${club.town}`, about: { '@id': `${url}#club` }, dateModified: club.checkedAt, citation: club.sources.map(source => source.url) },
  { '@type': 'BreadcrumbList', itemListElement: [{name: 'Home', item: absolute('/')}, {name: 'Club directory', item: absolute('/clubs/')}, {name: club.region, item: absolute(regionPath(club.region))}, {name: club.name, item: url}].map((item, i) => ({ '@type': 'ListItem', position: i + 1, ...item })) }
] };
const correction = `mailto:${contactEmail}?subject=${encodeURIComponent(`Directory correction: ${club.name}`)}&body=${encodeURIComponent(`Listing: ${url}\n\nPlease describe the change and include a public source we can check:\n`)}`;
---
<Layout title={`${club.name} in ${club.town}`} description={`Find ${club.name} in ${club.town}, ${club.region}. View published venue details, programme information and links to contact the club.`}>
  <script type="application/ld+json" set:html={jsonLd(schema)} />
  <div class="wrap py-12 sm:py-20">
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-x-2 text-sm"><a class="text-link" href="/clubs/">Club directory</a><span aria-hidden="true">/</span><a class="text-link" href={regionPath(club.region)}>{club.region}</a><span aria-hidden="true">/</span><span>{club.name}</span></nav>
    <p class="eyebrow">{club.town} · {club.nation}</p>
    <h1 class="mt-5 max-w-4xl font-display text-4xl leading-tight sm:text-6xl">{club.name}</h1>
    <p class="prose-copy mt-6 max-w-2xl">Find published information for {club.name} in {club.town}, including {club.addresses.length === 1 ? 'its listed venue' : 'its listed venues'} and how to enquire about joining.</p>
    <a class="button mt-7" href={club.website || club.sources[0].url}>{club.website ? 'Visit club website' : 'View governing-body listing'} <span aria-hidden="true">↗</span></a>
    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      <div class="space-y-8 lg:col-span-2">
        <section class="rounded-2xl border border-line bg-paper p-7"><h2 class="font-display text-3xl">Where to find the club</h2><ul class="mt-5 space-y-5">{club.addresses.map(address => <li class="border-l-2 border-sage pl-4 text-base leading-7">{address}</li>)}</ul><p class="mt-5 text-sm leading-6 text-muted">Confirm the venue for your class with the club before your first visit.</p></section>
        <section class="rounded-2xl border border-line bg-paper p-7"><h2 class="font-display text-3xl">Disciplines and programmes</h2>{club.disciplines.length ? <><ul class="mt-5 flex flex-wrap gap-3">{club.disciplines.map(discipline => <li class="rounded-full bg-sage-light px-4 py-2 text-sm">{discipline}</li>)}</ul><p class="mt-5 text-sm leading-6 text-muted">These programmes appear in the linked source. Contact the club for current ages, session times and availability.</p></> : <p class="prose-copy mt-4">Programme details have not yet been checked for this listing. Ask the club which disciplines and groups it currently offers.</p>}</section>
        <section><h2 class="font-display text-3xl">Enquire about joining</h2><p class="prose-copy mt-4">Contact {club.name} directly to discuss the right starting point. Ask about trial sessions, fees, membership requirements and whether there is a waiting list. Let the club know about any access or support needs.</p></section>
      </div>
      <aside class="space-y-6">
        <section class="rounded-2xl border border-line bg-paper p-7"><h2 class="text-xl font-semibold">About this listing</h2><p class="mt-4 text-sm leading-6 text-muted">Sources checked <time datetime={club.checkedAt}>{formatDate(club.checkedAt)}</time>. Details may change. This listing has not been claimed or approved by the club.</p><ul class="mt-4">{club.sources.map(source => <li><a href={source.url} class="text-link text-sm">{source.label}</a></li>)}</ul><a class="text-link mt-3 text-sm" href={correction}>Request a correction by email</a></section>
        <section class="rounded-2xl bg-forest p-7 text-paper"><h2 class="font-display text-3xl">More time for gymnastics</h2><p class="mt-4 text-sm leading-7">Run this club? {BRAND.name} helps organise waiting lists, payments and everyday club administration.</p><a class="button-light mt-5" href="/founding-clubs/">Meet Tumblebase</a></section>
      </aside>
    </div>
    {others.length > 0 && <section class="mt-16 border-t border-line pt-8"><h2 class="font-display text-3xl">More clubs in {club.region}</h2><ul class="mt-5 grid gap-4 sm:grid-cols-2">{others.map(other => <li><a href={clubPath(other)} class="text-link">{other.name}</a><p class="text-sm text-muted">{other.town}</p></li>)}</ul><a href={regionPath(club.region)} class="text-link mt-5">Browse all {club.region} listings</a></section>}
  </div>
</Layout>
