---
import { BRAND } from '../config';
---
<section class="wrap py-16 lg:py-24">
  <div class="rounded-3xl bg-forest px-7 py-12 text-paper sm:px-12 sm:py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sage">The next chapter for your club</p>
    <div class="mt-5 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <h2 class="max-w-xl font-display text-4xl leading-tight sm:text-5xl">Build your club's next routine with {BRAND.name}.</h2>
      <a href="/founding-clubs/" class="button-light shrink-0">Explore founding clubs <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
