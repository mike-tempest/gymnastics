RewriteEngine On

# Redirect www to non-www (handles both HTTP and HTTPS in one rule)
RewriteCond %{HTTP_HOST} ^www\.swimly\.uk [NC]
RewriteRule ^(.*)$ https://swimly.uk/$1 [L,R=301]

# Force HTTPS on non-www
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SEO: Fix keyword cannibalisation - 22 March 2026
# Consolidate commercial keyword authority to /best-swim-club-software-uk/
RedirectPermanent /best-swim-club-software /best-swim-club-software-uk/
RedirectPermanent /best-swim-club-software/ /best-swim-club-software-uk/

# Consolidate competing commercial landing pages - 25 March 2026
RedirectPermanent /swim-club-software /swim-club-management-software

# Fix keyword cannibalisation - 28 March 2026
# GSC shows 500+ impressions split across 6 pages, 0 clicks. Consolidate authority.
RedirectPermanent /swimming-club-membership-software /swim-club-management-software
RedirectPermanent /swim-team-management-software /swim-club-management-software
RedirectPermanent /swimming-management-software /swim-club-management-software
RedirectPermanent /swimming-club-payment-software /features/billing/
RedirectPermanent /swimming-club-billing-software /features/billing/

# Consolidate pilot page into founding clubs - 10 June 2026
# /pilot/ and /founding-clubs/ were near-duplicates with conflicting offers
RedirectPermanent /pilot /founding-clubs/

# Club region redirects - old generic regions to new county-based regions
# Generated 6 March 2026 after SE API enrichment changed region assignments

