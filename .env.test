# Environment variables for E2E tests
#
# Defaults point at local services. Override for other environments:
#   API_BASE_URL=https://... WEB_BASE_URL=https://... npm run test:e2e

# API endpoint (membership service)
API_BASE_URL=http://localhost:3001

# Web application (Next.js frontend)
WEB_BASE_URL=http://localhost:3000
